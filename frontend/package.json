{
  "name": "wattzup",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/copy-classes.mjs",
    "start": "ng serve wattzup",
    "build": "ng build wattzup && node scripts/check-bundle-size.mjs",
    "build:browser": "node scripts/copy-classes.mjs && ng build wattzup --configuration browser && node scripts/check-bundle-size.mjs dist/wattzup-browser/browser",
    "watch": "ng build wattzup --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint && tsc -p e2e/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "build:api": "npm run build && node -e \"const fs=require('node:fs');const d='../backend/src/Wattzup.Api/wwwroot';fs.mkdirSync(d,{recursive:true});fs.cpSync('dist/wattzup/browser',d,{recursive:true})\"",
    "generate:api": "npx --yes openapi-typescript@7.13.0 http://127.0.0.1:8787/openapi/v1.json -o projects/api/src/generated/schema.d.ts",
    "e2e:sweeps": "playwright test --config playwright.sweeps.config.ts",
    "record:api": "node scripts/record-api.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.7.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  }
}
