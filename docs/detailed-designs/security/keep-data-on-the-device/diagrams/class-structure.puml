@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Keep data on the device

interface RememberedBike {
  +get(): BikeInfo | null
  +save(bike: BikeInfo): void
  +forget(): void
}

class RememberedBikeStore {
  +REMEMBERED_BIKE_KEY = "telo-ride.bike"
  +get(): BikeInfo | null
  +save(bike: BikeInfo): void
  +forget(): void
}

class "Record store" as RecordStore <<new>> {
  key: <TO SUPPLY>
  +read(): record or absent
  +write(record): void
}

class "Record" as Record <<type>> {
  ride count
  best output (kJ)
  last output (kJ)
}

class "localStorage" as LocalStorage <<browser>> {
  +getItem(key: string): string | null
  +setItem(key: string, value: string): void
}

class "ride.routes.ts" as Routes <<config>> {
  no sign-in route
  no authGuard
  no provideSession()
}

class "app.config.ts" as Config <<config>> {
  no provideHttpClient()
}

class "guard" as Guard <<fixture>> {
  fails a spec on a request off localhost
  fails a spec on an unanswered request
}

RememberedBikeStore ..|> RememberedBike
RememberedBikeStore --> LocalStorage : only persistence
RecordStore --> LocalStorage : only persistence
RecordStore ..> Record : stores
Routes ..> RememberedBikeStore : binds
Routes ..> RecordStore : binds
Guard ..> Config : proves no request leaves
@enduml
