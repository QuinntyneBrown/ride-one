@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Restrict third parties
Person(rider, "Rider", "Rides a smart bike at home")
System(telo, "Telo Ride", "Smart-bike game: races, classes and progression")
System_Ext(youtube, "YouTube", "Class and custom-ride videos (IFrame Player API)")
System_Ext(gmaps, "Google Maps Platform", "Photorealistic 3D Tiles with the rider's own key")
System_Ext(static, "Static web host", "Serves the app's files with security headers; ADR 0022")
Rel(rider, telo, "Rides with")
Rel(telo, youtube, "Loads the player and thumbnails from", "HTTPS")
Rel(telo, gmaps, "Streams tiles with the rider's key from (only when given)", "HTTPS")
Rel(static, telo, "Delivers the app shell with its Content Security Policy", "HTTPS")
@enduml
