@startuml
set separator none
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Restrict third parties
package "frontend hosting" {
  class StaticWebAppConfig <<staticwebapp.config.json>> {
    +globalHeaders.Content-Security-Policy
    +globalHeaders.X-Content-Type-Options = "nosniff"
    +globalHeaders.Referrer-Policy = "strict-origin-when-cross-origin"
  }
  class ContentSecurityPolicy <<header value>> {
    +default-src 'self'
    +script-src 'self' https://www.youtube.com
    +style-src 'self' <TO SUPPLY>
    +frame-src https://www.youtube-nocookie.com
    +connect-src 'self' https://tile.googleapis.com
    +img-src 'self' https://i.ytimg.com https://tile.googleapis.com
    +font-src 'self'
    +object-src 'none'
    +base-uri 'self'
    +form-action 'self'
    +frame-ancestors 'none'
  }
  StaticWebAppConfig *-- ContentSecurityPolicy
}
package "api library" {
  class ThirdPartyOrigins <<const>> {
    +youtubeScript = "https://www.youtube.com"
    +youtubeFrames = "https://www.youtube-nocookie.com"
    +youtubeImages = "https://i.ytimg.com"
    +googleTiles = "https://tile.googleapis.com"
  }
}
package "domain library" {
  class YouTubePlayerLoader {
    -loaded: Promise<YT> | null
    +load(): Promise<YT>
    +createPlayer(host: HTMLElement, videoId: string): YT.Player
  }
  class SettingsStore {
    +googleMapsKey: Signal<string | null>
  }
}
package "world library" {
  class GoogleTilesSource {
    +stream(key: string, place: GeoPlace): Observable<TileSet>
  }
}
YouTubePlayerLoader ..> ThirdPartyOrigins
GoogleTilesSource ..> ThirdPartyOrigins
GoogleTilesSource ..> SettingsStore : key
package "Telo.Ride.Api" {
  class SecurityHeadersMiddleware {
    +InvokeAsync(context: HttpContext, next: RequestDelegate): Task
  }
}
@enduml
