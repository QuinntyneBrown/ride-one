@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Restrict third parties
System_Ext(youtube, "YouTube", "IFrame Player API")
System_Ext(gmaps, "Google Maps Platform", "Map Tiles API")
Container_Boundary(app, "Ride app") {
  Component(policy, "Content Security Policy", "Response header from staticwebapp.config.json", "Allow-list of origins per directive")
  Component(origins, "ThirdPartyOrigins", "Constants · api", "The only foreign origins the app may name")
  Component(yt, "YouTubePlayerLoader", "Service · domain", "Loads iframe_api once; players on youtube-nocookie")
  Component(tiles, "GoogleTilesSource", "Service · world", "Streams 3D Tiles with the rider's key")
  Component(settings, "SettingsStore", "Service · domain/storage", "Holds the Google key on this device")
  Component(fonts, "Bundled fonts", "Static assets · ride", "@font-face from the app's origin")
}
Container_Boundary(api, "Telo Ride API") {
  Component(headers, "SecurityHeadersMiddleware", "Middleware · Telo.Ride.Api", "nosniff, Referrer-Policy, CSP frame-ancestors 'none'")
}
Rel(yt, origins, "Reads origins from")
Rel(tiles, origins, "Reads origins from")
Rel(tiles, settings, "Reads the key from")
Rel(yt, youtube, "Loads script and frames from", "HTTPS")
Rel(tiles, gmaps, "Fetches tiles from", "HTTPS")
Rel(policy, yt, "Permits")
Rel(policy, tiles, "Permits")
Rel(policy, fonts, "Permits 'self' only for")
@enduml
