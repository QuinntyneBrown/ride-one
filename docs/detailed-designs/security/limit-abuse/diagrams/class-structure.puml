@startuml
set separator none
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Limit abuse
package "Telo.Ride.Api" {
  class RateLimitPolicies <<configuration>> {
    +RidesPerRider = sliding window, 60 per hour, partition: rider id
    +FeedbackPerRider = sliding window, 10 per hour, partition: rider id
  }
  class RateLimitRejection {
    +OnRejected(context: OnRejectedContext, ct): ValueTask
  }
  class ProgressRateHubFilter {
    -ConcurrentDictionary<string, ProgressRateGate> gates
    +InvokeMethodAsync(context, next): ValueTask<object?>
    +OnDisconnectedAsync(context, exception, next): Task
  }
}
package "Telo.Ride.Application" {
  class ProgressRateGate {
    +MaxPerSecond = 2
    +AbortAfter = 10 s
    -int countThisSecond
    -DateTimeOffset? overLimitSince
    +Admit(now: DateTimeOffset): GateDecision
  }
  enum GateDecision {
    Admit
    Drop
    Disconnect
  }
  class SignInCodeLimits {
    +PerEmailPerHour = 5
    +PerIpPerHour = 20
    +ResendGap = 30 s
    +Check(emailCount: int, ipCount: int, lastIssuedAt, now): LimitResult
  }
  class LimitResult {
    +bool Allowed
    +TimeSpan RetryAfter
  }
}
RateLimitPolicies ..> RateLimitRejection : rejects through
ProgressRateHubFilter "1" *-- "*" ProgressRateGate : one per connection
ProgressRateGate ..> GateDecision
SignInCodeLimits ..> LimitResult
@enduml
