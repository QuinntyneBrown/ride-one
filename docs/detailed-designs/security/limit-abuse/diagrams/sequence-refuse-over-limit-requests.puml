@startuml
title UML sequence behaviour — Refuse requests over a limit
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app" #E0F2FE
  participant "RideOutbox" as outbox
  participant "HttpRidesApi" as client
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "Rate limiter" as rl
  participant "RateLimitRejection" as rej
  participant "RidesController" as ctrl
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "SubmitRideCommandHandler" as handler
end box
outbox -> client : submit(ride)
client -> rl : POST /api/rides
rl -> rl : Partition by rider id, sliding window of one hour
alt 60 or fewer submissions this hour
  rl -> ctrl : Admit
  ctrl -> handler : Send SubmitRideCommand
  handler --> ctrl : Result
  ctrl --> client : 201
else the 61st submission within an hour (L2-130 AC3)
  rl -> rej : OnRejected
  rej --> client : 429 ProblemDetails code rate_limited, Retry-After: seconds (L2-130 AC1)
  client --> outbox : Keep the ride; retry after Retry-After
end
note over rl : POST /api/feedback uses feedback-per-rider: 10 an hour (L2-119 AC3).\nPOST /api/auth/code limits are counted from stored codes by the\nsend-code handler and answered with the same 429 shape (L2-003).
@enduml
