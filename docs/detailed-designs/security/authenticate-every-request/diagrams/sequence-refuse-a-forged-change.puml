@startuml
title UML sequence behaviour — Refuse a change without anti-forgery proof
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app" #E0F2FE
  participant "Profile dialog" as page
  participant "Angular HttpClient (XSRF)" as http
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "Anti-forgery filter" as anti
  participant "SameOriginHubFilter" as origin
  participant "RidersController" as ctrl
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "SetDisplayNameCommandHandler" as handler
end box
note over http : On sign-in the API sets the XSRF-TOKEN cookie\n(readable by scripts, SameSite=Strict)
actor -> page : Save a new display name
page -> http : PUT /api/riders/me/display-name
http -> anti : Request with session cookie and X-XSRF-TOKEN copied from XSRF-TOKEN
anti -> anti : Validate the token against the session (unsafe method)
alt token valid
  anti -> ctrl : Continue
  ctrl -> handler : Send SetDisplayNameCommand
  handler --> ctrl : Result
  ctrl --> http : 200
else token missing or wrong (forged cross-site form or script, L2-127 AC2)
  anti --> http : 400 ProblemDetails code antiforgery_failed
end
== Ride hub ==
http -> origin : POST /hubs/ride/negotiate with Origin header
alt Origin is not the app's origin
  origin --> http : 403, no connection
else same origin
  origin -> origin : Continue to authentication and the hub
end
@enduml
