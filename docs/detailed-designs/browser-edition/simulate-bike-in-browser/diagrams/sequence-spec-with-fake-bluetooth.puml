@startuml
title UML sequence behaviour — A spec drives the fake bike
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
participant "Spec (e2e/browser)" as spec
box "Test — Playwright fixtures" #FFF4E5
  participant "wz-browser-test" as fx
  participant "fake-bluetooth.ts" as fake
end box
box "Frontend — Wattzup Web, browser edition" #E0F2FE
  participant "Ride Dashboard\n(page object)" as page
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserBikePairing" as pairing
  participant "BikeLink" as link
end box

spec -> fx : test(...)
fx -> fake : addInitScript (before app load)
fx -> fx : route **/api/** to failure; other origins fail
spec -> fake : offer(ECHEX-3-141844)
spec -> page : connectBike()
page -> pairing : pair()
pairing -> fake : requestDevice(filters)
fake --> pairing : fake device
pairing -> link : use(device)
link -> fake : connect; startNotifications; 3 init writes
spec -> fake : notify(0xD1 frame, cadence 80)
fake -> link : characteristicvaluechanged
page --> spec : cadence readout shows 80
spec -> fake : writes
fake --> spec : init, keepalive and setResistance writes [L2-099 AC2]
alt app calls something unscripted
  fake --> spec : fail with the call named
end
@enduml
