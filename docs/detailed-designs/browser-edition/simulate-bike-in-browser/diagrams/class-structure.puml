@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Simulate the bike in the browser

interface BluetoothPort {
  +isSupported(): boolean
  +availability(): Promise<boolean>
  +requestBike(): Promise<BikeDevice | null>
  +knownBikes(): Promise<BikeDevice[]>
}
class WebBluetoothPort {
  -bluetooth: Bluetooth
}
class SimulatedBluetoothPort {
  -clock: Clock
  -cadence: number
  -resistance: number
  +requestBike(): Promise<BikeDevice>
}
class FakeBluetoothPort <<test helper>> {
  +offer(device): void
  +notify(bytes): void
  +disconnect(): void
  +writes: Uint8Array[]
}
interface Clock {
  +now(): number
  +epochMs(): number
  +delay(ms: number): Promise<void>
}
class FakeClock <<test helper>> {
  +advance(ms: number): Promise<void>
  +jump(ms: number): Promise<void>
}
class BikeLink
class "fake-bluetooth.ts" as fixture <<Playwright init script>> {
  +offer(device)
  +cancelNext()
  +notify(bytes)
  +disconnect()
  +failNext(name, message)
  +writes
}

WebBluetoothPort ..|> BluetoothPort
SimulatedBluetoothPort ..|> BluetoothPort
FakeBluetoothPort ..|> BluetoothPort
FakeClock ..|> Clock
SimulatedBluetoothPort --> Clock
BikeLink --> BluetoothPort
BikeLink --> Clock
WebBluetoothPort ..> fixture : navigator.bluetooth under test
@enduml
