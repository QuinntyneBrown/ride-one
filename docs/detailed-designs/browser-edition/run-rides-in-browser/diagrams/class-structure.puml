@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Run rides in the browser

interface Clock {
  +now(): number
  +epochMs(): number
  +delay(ms: number): Promise<void>
}
class SYSTEM_CLOCK <<const>>
class FakeClock
class BikeStateStore {
  -current: BikeState
  +get state(): BikeState
  +update(fn: (s: BikeState) => BikeState): void
  +touch(): void
  +subscribe(fn: (s: BikeState) => void): () => void
}
class StateDerivations <<pure>> {
  +apply(next: BikeState, now: number): BikeState
}
class PacketDecoder <<pure>> {
  +decode(bytes: Uint8Array): TelemetryUpdate | null
}
class TelemetryIngestor {
  +onPacket(bytes: Uint8Array): void
}
class WorkoutEngine {
  -run: WorkoutRun | null
  +startWorkout(plan: WorkoutPlan, origin: RideOrigin | null): Promise<WorkoutSnapshot>
  +stop(): Promise<WorkoutSnapshot | null>
  +pause(): Promise<WorkoutSnapshot | null>
  +resume(): Promise<WorkoutSnapshot | null>
  +backToPlan(): Promise<WorkoutSnapshot | null>
  +setManual(level: number): Promise<SendResult>
  +trace(): PowerTrace
  -tick(): Promise<void>
  -step(run: WorkoutRun): Promise<void>
  -drive(run: WorkoutRun): Promise<void>
}
class WorkoutRun {
  +segments: Segment[]
  +elapsed: number
  +anchor: number
  +totals: RideTotals
  +samples: RideSample[]
  +toSnapshot(): WorkoutSnapshot
}
class ResistanceCommander {
  +send(level: number, source: 'plan' | 'manual', rideSeconds: number | null): Promise<SendResult>
}
class BrowserStateSource {
  +state: Signal<BikeState | null>
  +ensureStarted(): void
}
class RideJournalEntry {
  +classId, title, plan, segments
  +samples: RideSample[]
  +totals
  +savedAt: number
}
class SessionStore {
  +ready(): Promise<void>
  +keepJournal(entry): Promise<void>
  +clearJournal(): Promise<void>
  -recoverJournal(): Promise<void>
}
class WakeLockKeeper {
  -wanted: boolean
  -sentinel: WakeLockSentinel | null
  -want(on: boolean): Promise<void>
  -acquire(): Promise<void>
}
class "BikeState (generated)" as BikeState

SYSTEM_CLOCK ..|> Clock
FakeClock ..|> Clock
BikeStateStore ..> StateDerivations
BikeStateStore --> Clock
BikeStateStore --> BikeState : current
TelemetryIngestor ..> PacketDecoder
TelemetryIngestor --> BikeStateStore
WorkoutEngine --> Clock
WorkoutEngine *-- "0..1" WorkoutRun
WorkoutEngine --> ResistanceCommander
WorkoutEngine --> BikeStateStore
WorkoutEngine --> SessionStore : keepJournal, clearJournal
SessionStore ..> RideJournalEntry
BrowserStateSource --> BikeStateStore
WakeLockKeeper ..> BikeStateStore
@enduml
