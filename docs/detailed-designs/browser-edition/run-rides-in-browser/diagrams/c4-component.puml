@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Run rides in the browser

Container_Boundary(app, "Wattzup Web, browser edition") {
  Component(pages, "Ride Dashboard and dialogs", "Angular", "Read the state signal; call WORKOUT_API")
  Component(live, "LiveStateService", "Angular service", "Owns the read-only state signal")
  Component(wapi, "BrowserWorkoutApi", "WORKOUT_API implementation", "start, stop, pause, resume, backToPlan, trace")
  Component(src, "BrowserStateSource", "LIVE_STATE_SOURCE implementation", "Forwards each new state")
  Component(link, "BikeLink", "lib/bluetooth", "GATT link")
  Component(decoder, "PacketDecoder", "lib/protocol mirror", "Framing and decoding")
  Component(ingest, "TelemetryIngestor", "lib/engine mirror", "Applies decoded packets")
  Component(store, "BikeStateStore", "lib/engine mirror", "Only writer of BikeState")
  Component(engine, "WorkoutEngine", "lib/engine mirror", "Ticks on the monotonic clock")
  Component(cmd, "ResistanceCommander", "lib/engine mirror", "Target resistance and command log")
  Component(journal, "RideJournal", "lib/storage", "The ride in progress, every 10 s")
  Component(wake, "WakeLockKeeper", "lib/engine", "Screen wake lock during a ride")
}
Rel(pages, live, "Read state")
Rel(pages, wapi, "Call")
Rel(live, src, "open(listener)")
Rel(src, store, "Subscribes")
Rel(link, ingest, "Packets")
Rel(ingest, decoder, "Decodes with")
Rel(ingest, store, "update()")
Rel(wapi, engine, "Commands")
Rel(engine, cmd, "Sets segment targets")
Rel(cmd, link, "Writes setResistance")
Rel(engine, store, "update(workout, totals)")
Rel(engine, journal, "Saves the run")
Rel(wake, store, "Watches workout.status")
@enduml
