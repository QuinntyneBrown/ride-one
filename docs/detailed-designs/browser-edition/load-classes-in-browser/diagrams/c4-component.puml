@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Load classes in the browser

Container_Boundary(app, "Wattzup Web, browser edition") {
  Component(lib, "Class library page", "Angular page", "/classes")
  Component(cls, "Class page", "Angular page", "/classes/:id")
  Component(api, "BrowserClassApi", "CLASS_API implementation", "Fetches once, caches, answers list and get")
  Component(reader, "ClassCatalogueReader", "lib/engine mirror", "L2-077 rules and limits")
  Component(validator, "WorkoutPlanValidator", "lib/engine mirror", "L2-010 plan rules")
}
Rel(lib, api, "list()")
Rel(cls, api, "get(id)")
Rel(api, reader, "read(text)")
Rel(reader, validator, "Validates each plan")
@enduml
