@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Load classes in the browser

Person(rider, "Rider", "Browses classes")
System_Ext(host, "Static host", "classes.json")
System_Boundary(browser, "Rider's browser") {
  Container(app, "Wattzup Web, browser edition", "Angular + @wattzup/browser", "Class library and class page")
  Container(sw, "Service worker", "@angular/service-worker", "Freshness cache for classes.json")
}
Rel(rider, app, "Uses")
Rel(app, sw, "fetch classes.json")
Rel(sw, host, "Network first", "HTTPS")
@enduml
