@startuml
title UML sequence behaviour — Keep the link and recover
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — @wattzup/browser" #ECFDF3
  participant "Clock" as clock
  participant "BikeLink" as link
  participant "BikeStateStore" as store
  participant "WorkoutEngine" as engine
end box
box "Browser — Web Bluetooth" #FFF4E5
  participant "Echelon bike (GATT)" as bike
end box

loop every 1 s while connected
  clock -> link : tick
  link -> link : now() - lastKeepaliveAt >= 1000 ms? [L2-091 AC1]
  link -> bike : write keepalive (with response)
  link -> store : touch()
end
bike -> link : gattserverdisconnected
link -> store : ble 'disconnected' [L2-091 AC2]
store -> engine : ble changed
engine -> store : workout.status 'paused: bike disconnected' (L2-013)
link -> clock : after(3000, retry)
loop until connected or the ride ends
  clock -> link : retry
  link -> bike : gatt.connect() (same device, no chooser)
  alt connected
    bike --> link : GattLink
    link -> link : subscribe; init commands 300 ms apart
    link -> store : ble 'connected'
    store -> engine : resume per L2-013
  else Web Bluetooth error [L2-091 AC3]
    bike --> link : NetworkError: <message>
    link -> store : ble 'error', error 'NetworkError: <message>'
    link -> clock : after(3000, retry)
  end
end
opt rider presses Reconnect [L2-091 AC5]
  rider -> link : reconnectNow()
  link -> link : cancel pending retry; connect at once
end
@enduml
