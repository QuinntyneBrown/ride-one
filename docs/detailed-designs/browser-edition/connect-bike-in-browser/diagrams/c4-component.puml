@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Connect the bike in the browser

Container_Boundary(app, "Wattzup Web, browser edition") {
  Component(dash, "Ride Dashboard", "Angular page", "Shows Connect bike while BIKE_PAIRING.required()")
  Component(pairing, "BrowserBikePairing", "BIKE_PAIRING implementation", "pair(): opens the chooser first")
  Component(bikeapi, "BrowserBikeApi", "BIKE_API implementation", "reconnect()")
  Component(link, "BikeLink", "lib/bluetooth", "State machine, init, keepalive, 3 s retry")
  Component(port, "WebBluetoothPort", "lib/bluetooth", "Only wrapper over navigator.bluetooth")
  Component(frames, "EchelonCommands", "lib/protocol", "Init, keepalive and resistance bytes")
  Component(clock, "SystemClock", "lib/engine", "Monotonic now() and every(ms)")
  Component(store, "BikeStateStore", "lib/engine", "Only writer of BikeState")
  Component(engine, "WorkoutEngine", "lib/engine", "Waits while disconnected")
}
System_Ext(webbt, "Web Bluetooth stack", "Browser")

Rel(dash, pairing, "pair() on click")
Rel(dash, bikeapi, "reconnect() on Reconnect")
Rel(pairing, port, "requestBike()")
Rel(pairing, link, "use(device)")
Rel(bikeapi, link, "reconnectNow()")
Rel(link, port, "connect, notify, write")
Rel(link, frames, "Reads bytes from")
Rel(link, clock, "Times keepalive and retries")
Rel(link, store, "Writes ble, device, error")
Rel(store, engine, "Notifies ble changes")
Rel(port, webbt, "Calls")
@enduml
