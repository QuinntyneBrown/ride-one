@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Build and host the browser edition

Container_Boundary(app, "Wattzup Web, browser edition") {
  Component(root, "app.config.browser.ts", "Composition root", "Shared providers plus provideBrowserEdition()")
  Component(screens, "Pages and dialogs", "Angular components", "Inject contract tokens only")
  Component(live, "LiveStateService", "Angular service", "Read-only state signal")
  Component(tokens, "Contracts and tokens", "@wattzup/api", "BIKE_API, WORKOUT_API, CLASS_API, SESSION_API, LIVE_STATE_SOURCE, BIKE_PAIRING, SESSION_ARCHIVE, EDITION")
  Component(provide, "provideBrowserEdition()", "@wattzup/browser", "Binds each token to its Browser* class")
  Component(impls, "Browser* contract classes", "@wattzup/browser lib/contracts", "In-browser implementations")
  Component(runtime, "Shared services", "provideBrowserEdition()", "BikeStateStore, BikeLink, WorkoutEngine, SessionStore: one each")
}

Rel(root, provide, "Calls")
Rel(provide, tokens, "Provides implementations for")
Rel(screens, tokens, "Inject")
Rel(live, tokens, "Injects LIVE_STATE_SOURCE")
Rel(impls, tokens, "Implement")
Rel(impls, runtime, "Inject")
@enduml
