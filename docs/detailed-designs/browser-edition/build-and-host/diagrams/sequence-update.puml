@startuml
title UML sequence behaviour — Deliver an update without interrupting a ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Hosting — Static host" #FFF4E5
  participant "Static host" as host
end box
box "Frontend — Wattzup Web, browser edition" #E0F2FE
  participant "Service worker" as sw
  participant "SwUpdate" as swu
  participant "UpdateGate" as gate
  participant "LiveStateService" as live
end box

sw -> host : GET ngsw.json (background check)
host --> sw : New manifest hash
sw -> host : Download the new version's files
sw -> swu : VERSION_READY
swu -> gate : versionUpdates
gate -> live : state().workout?.status
alt a ride is running, paused or waiting
  gate -> gate : Do nothing now [L2-098 AC3]
else no ride
  gate -> gate : Leave the update for the next load
end
note over sw : The next navigation loads the new version.
@enduml
