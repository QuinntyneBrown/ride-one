@startuml
title UML sequence behaviour — Deliver an update without interrupting a ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Hosting — Static host" #FFF4E5
  participant "Static host" as host
end box
box "Frontend — Wattzup Web, browser edition" #E0F2FE
  participant "Page (riding)" as page
  participant "Service worker" as sw
end box

page -> sw : Load (any navigation)
sw --> page : index.html and files of version A, from the cache
sw -> host : GET ngsw.json (background check)
host --> sw : New manifest hash B
sw -> host : Download version B's files
note over page, sw : The page stays on version A; nothing calls activateUpdate() or reloads,\nso the ride carries on [L2-098 AC3]
page -> sw : Next load
sw --> page : Version B
@enduml
