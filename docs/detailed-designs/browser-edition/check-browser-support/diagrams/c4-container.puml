@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Check browser support

Person(rider, "Rider", "Opens Wattzup")
System_Boundary(browser, "Rider's browser") {
  Container(app, "Wattzup Web, browser edition", "Angular", "Decides the support verdict and shows the notice")
  Container(webbt, "Web Bluetooth API", "navigator.bluetooth", "Present only in Chromium on a secure page")
}
Rel(rider, app, "Uses")
Rel(app, webbt, "isSecureContext, getAvailability(), availabilitychanged")
@enduml
