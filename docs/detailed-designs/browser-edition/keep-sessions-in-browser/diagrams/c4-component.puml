@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Keep sessions in the browser

Container_Boundary(app, "Wattzup Web, browser edition") {
  Component(progress, "Progress page", "Angular page", "Your history, export and import when EDITION is browser")
  Component(summary, "Session Summary page", "Angular page", "Reads SESSION_API")
  Component(wapi, "BrowserWorkoutApi", "WORKOUT_API implementation", "stop() answers the session id")
  Component(engine, "WorkoutEngine", "lib/engine mirror", "Saves a ride of 60 s or more as it ends")
  Component(sapi, "BrowserSessionApi", "SESSION_API implementation", "list, get, progress")
  Component(archive, "BrowserSessionArchive", "SESSION_ARCHIVE implementation", "exportAll, importFile, lastExportedAt")
  Component(builder, "SessionBuilder", "lib/engine mirror", "Builds the L2-081 record")
  Component(calc, "ProgressCalculator", "lib/engine mirror", "L2-087 figures")
  Component(store, "SessionStore", "lib/storage mirror", "Newest 500 in memory and IndexedDB")
  Component(validator, "validSession", "lib/storage", "L2-081 field rules for imports")
  Component(persist, "requestPersistentStorage", "provideBrowserEdition initializer", "navigator.storage.persist() at start")
  ComponentDb(db, "IndexedDbSessionDatabase", "SESSION_DATABASE, IndexedDB", "sessions store")
}
Rel(progress, archive, "Calls")
Rel(progress, sapi, "progress()")
Rel(summary, sapi, "get(id)")
Rel(wapi, engine, "stop()")
Rel(engine, builder, "Builds")
Rel(engine, store, "add()")
Rel(sapi, store, "Reads")
Rel(sapi, calc, "Computes")
Rel(archive, validator, "Validates")
Rel(archive, store, "Adds new sessions")
Rel(store, persist, "Kept by")
Rel(store, db, "Transactions")
@enduml
