@startuml
title UML sequence behaviour — Countdown and segment-change cues
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "BeepsToggle" as toggle
  participant "CueService" as cue
  participant "Interval" as card
  participant "SegmentChangeDetector" as det
  participant "PhaseBanner" as banner
  participant "LiveStateService" as live
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserStateSource" as src
end box

src -> live : first state: workout {segment:9, status:"running"}
live -> banner : state() changes
banner -> det : observe(workout)
det --> banner : null, first state never cues [L2-027]
rider -> toggle : Press "Countdown beeps off"
toggle -> cue : toggle()
cue -> cue : new AudioContext; enabled = true; beep(880, 0.08) [L2-027]
cue --> rider : info toast "Beeps on" [L2-027]
toggle --> rider : name "Countdown beeps on", aria-pressed="true"
loop whole seconds left change while running
  card -> card : countdownCue(n)
  opt n in 5..1
    card -> card : add is-pulse to interval__left (skipped with reduced motion) [L2-027]
  end
  opt n in 3..1
    card -> cue : beep(660, 0.09) [L2-027]
  end
end
src -> live : state workout {segment:10, kind rest, level 6, round 5}
live -> banner : state() changes
banner -> det : observe(workout)
det --> banner : SegmentChange(rest, 6, 20 s, next Work at 18)
banner --> rider : "RECOVER · 6" / "0:20 · next: Work at 18" for 1.8 s [L2-027]
banner --> rider : live region "Recover, resistance 6, 20 seconds"
banner -> cue : beep(520, 0.35); 990 Hz when the new segment is work [L2-027]
@enduml
