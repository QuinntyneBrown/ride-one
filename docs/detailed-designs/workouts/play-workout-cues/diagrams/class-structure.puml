@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Play workout cues

package "src/app/core" {
  class CueService <<service>> {
    -ctx: AudioContext | null
    +Signal<boolean> enabled
    +toggle(): void
    +beep(freq: number, seconds: number): void
  }
  class SegmentChangeDetector {
    -seen: boolean
    -lastKey: number | null
    +observe(w: Workout | null): SegmentChange | null
  }
  class SegmentChange <<interface>> {
    +kind: SegmentKind
    +level: number
    +duration: number
    +round: number | null
    +rounds: number | null
    +next: NextSegment | null
  }
  class CueText <<module cue-text.ts>> {
    +bannerText(c: SegmentChange): BannerText
    +announcement(c: SegmentChange): string
  }
  class CountdownCue <<module countdown-cue.ts>> {
    +countdownCue(wholeSecondsLeft: number, running: boolean): {pulse, beep}
  }
}

package "src/app/dashboard" {
  class PhaseBanner <<component wz-phase-banner>> {
    +Signal<BannerText | null> text
    +Signal<'rest' | null> modifier
    +Signal<string> announcement
  }
  class BeepsToggle <<component wz-beeps-toggle>> {
    +Signal<string> accessibleName
    +press(): void
  }
  class Interval <<component wz-interval>> {
    -frame(now): void
  }
}

SegmentChangeDetector ..> SegmentChange : emits
CueText ..> SegmentChange
PhaseBanner *-- SegmentChangeDetector
PhaseBanner ..> CueText
PhaseBanner --> CueService
Interval ..> CountdownCue
Interval --> CueService
BeepsToggle --> CueService
@enduml
