@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Play workout cues

Person(rider, "Rider", "Hears and sees cues")
Container_Boundary(web, "Wattzup Web") {
  Component(live, "LiveStateService", "Angular service", "state signal")
  Component(det, "TransitionDetector", "TypeScript", "Detects cycle:step changes")
  Component(cd, "CountdownCues", "TypeScript", "Final 5 s pulse and 3 s beeps")
  Component(banner, "TransitionBanner", "Angular component", "Banner, flash, live region")
  Component(cue, "CueService", "Angular service", "Web Audio beeps")
  Component(toggle, "SoundToggle", "Angular component", "Beeps on or off")
}
Container(api, "Wattzup API", "ASP.NET Core", "Streams workout state")

Rel(api, live, "data: BikeState", "SSE")
Rel(det, live, "observe(workout)")
Rel(banner, det, "Transition events")
Rel(banner, cue, "beep(990 or 520)")
Rel(cd, cue, "beep(660)")
Rel(toggle, cue, "toggle()")
Rel(rider, toggle, "Presses")
@enduml
