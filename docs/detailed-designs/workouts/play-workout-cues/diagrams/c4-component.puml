@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Play workout cues

Person(rider, "Rider", "Hears and sees cues")
Container_Boundary(web, "Wattzup Web") {
  Component(live, "LiveStateService", "Angular service", "Read-only state signal")
  Component(det, "SegmentChangeDetector", "TypeScript, core/", "Detects segment changes after the first state")
  Component(text, "cue-text / countdown-cue", "TypeScript, core/", "Banner lines, announcement, pulse and beep seconds")
  Component(banner, "PhaseBanner", "Angular component, wz-phase-banner", "Banner and polite live region")
  Component(interval, "Interval", "Angular component, wz-interval", "Countdown pulse (show-workout-countdown)")
  Component(cue, "CueService", "Angular service", "Web Audio beeps")
  Component(toggle, "BeepsToggle", "Angular component, wz-beeps-toggle", "Countdown beeps on or off")
  Component(toast, "ToastService", "Angular service", "Info toast Beeps on (L2-053)")
}
Container(api, "@wattzup/browser", "In-page contracts", "BrowserStateSource forwards each new BikeState")

Rel(api, live, "New BikeState", "LIVE_STATE_SOURCE")
Rel(banner, live, "Reads workout")
Rel(banner, det, "observe(workout)")
Rel(banner, text, "bannerText / announcement")
Rel(banner, cue, "beep(990 or 520)")
Rel(interval, text, "countdownCue(seconds)")
Rel(interval, cue, "beep(660)")
Rel(toggle, cue, "toggle()")
Rel(cue, toast, "show(Beeps on)")
Rel(rider, toggle, "Presses")
@enduml
