@startuml
title UML sequence behaviour — Anchor and interpolate the countdown
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "LiveStateService" as live
  participant "Interval" as card
  participant "RideClock" as rc
  participant "CountdownClock" as model
  participant "segment-labels" as labels
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserStateSource" as src
end box

src -> live : state workout {segment:9, remaining:33, elapsed_seconds:427, total_seconds:760, status:"running"}
live -> card : state() changes
card -> model : anchor(workout, now) [L2-024]
card -> labels : kindLabel(work), roundLabel = "Round 5 of 8", toneOf = work [L2-025]
card -> labels : nextLabel = Recover 0:20 at level 6 [L2-025]
card --> rider : "Work Round 5 of 8", "Next: Recover 0:20 at level 6"
loop every animation frame while the document is visible
  card -> model : remainingAt(now), progressAt(now)
  model --> card : max(0, 33 - min(1.25, drift))
  card -> card : numerals = formatDuration(ceil) e.g. "0:33"; write only on change
  card -> card : bar --value = progress (once per second with reduced motion)
  rc -> model : elapsedAt(now)
  rc -> rc : "7:07 / 12:40" (floor of elapsed) [L2-024]
end
opt no update for more than 1.25 s
  model --> card : drift stays at 1.25; numerals stop [L2-024]
end
src -> live : state workout {status:"paused"}
live -> card : state() changes
card -> model : anchor(workout, now), running = false
model --> card : drift = 0; time held still [L2-024]
card --> rider : app bar badge "Paused" [L2-025]
@enduml
