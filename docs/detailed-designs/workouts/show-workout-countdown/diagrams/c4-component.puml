@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show the workout countdown

Person(rider, "Rider", "Follows the countdown")
Container_Boundary(web, "Wattzup Web") {
  Component(live, "LiveStateService", "Angular service", "state signal")
  Component(model, "CountdownModel", "TypeScript", "Anchor and interpolate remaining time")
  Component(clock, "HeroClock", "Angular component", "Phase, m:ss, Next, status")
  Component(timeline, "StepTimeline", "Angular component", "Proportional step segments")
  Component(ring, "RingCanvas", "Angular component", "Progress ring via RingRenderer")
  Component(theme, "ThemeService", "Angular service", "--phase colour")
}
Container(api, "Wattzup API", "ASP.NET Core", "Streams workout state")

Rel(api, live, "data: BikeState", "SSE")
Rel(clock, live, "Reads workout")
Rel(clock, model, "anchor / shown")
Rel(timeline, model, "fraction")
Rel(ring, model, "fraction, pulse")
Rel(clock, theme, "setPhase")
Rel(rider, clock, "Reads")
@enduml
