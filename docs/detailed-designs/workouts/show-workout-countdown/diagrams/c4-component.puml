@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show the workout countdown

Person(rider, "Rider", "Follows the countdown")
Container_Boundary(web, "Wattzup Web") {
  Component(live, "LiveStateService", "Angular service", "Read-only state signal")
  Component(clock, "CountdownClock", "TypeScript, core/", "Anchor and interpolate remaining and elapsed")
  Component(labels, "segment-labels", "TypeScript, core/", "Kind, phase, tone, round, next line, status badge")
  Component(interval, "Interval", "Angular component, wz-interval", "Kind, m:ss, progress bar, next line")
  Component(rideclock, "RideClock", "Angular component, wz-ride-clock", "Elapsed / total in the app bar")
  Component(link, "WorkoutLink", "Angular component, wz-workout-link", "Summary link to /setup")
  Component(frame, "Frame loop", "Angular service", "requestAnimationFrame, paused when hidden")
}
Container(api, "Wattzup API", "ASP.NET Core", "Streams workout state")

Rel(api, live, "data: BikeState", "SSE")
Rel(interval, live, "Reads workout")
Rel(rideclock, live, "Reads workout")
Rel(link, live, "Reads workout.summary")
Rel(interval, clock, "anchor / remainingAt / progressAt")
Rel(rideclock, clock, "elapsedAt")
Rel(interval, labels, "kindLabel / roundLabel / nextLabel")
Rel(interval, frame, "Registers frame callback")
Rel(rider, interval, "Reads")
@enduml
