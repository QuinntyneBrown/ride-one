@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show the workout countdown

class CountdownModel {
  -remaining: number | null
  -at: number
  -running: boolean
  +stepSeconds: number
  +anchor(remaining, running, stepSeconds, now): void
  +shown(now): number | null
  +fraction(now): number
}
class PhaseInfo <<static>> {
  +EFFORT_MIN_LEVEL = 20
  +phaseOf(level): 'effort' | 'recovery'
  +phaseLabel(level): string
  +nextLabel(step): string
}
class HeroClock <<component>> {
  +Signal<string> phaseText
  +Signal<string> nextText
  +Signal<string> statusText
  -frame(now): void
}
class StepTimeline <<component>> {
  +InputSignal<number[][]> steps
  +InputSignal<number> current
  +Signal<number> cycle
}
class RingCanvas <<component>> {
  +Signal<string> rendererName
  -renderer: RingRenderer
  -vis: RingVisuals
}
interface RingRenderer {
  +name: string
  +draw(time: number, vis: RingVisuals): void
}
class WebGpuRingRenderer
class WebGl2RingRenderer
class Canvas2dRingRenderer
class RingVisuals {
  +frac: number
  +color: [number, number, number]
  +target: [number, number, number]
  +pulse: number
  +energy: number
  +flash: number
  +ease(reducedMotion: boolean): void
}
class ThemeService <<service>> {
  +setPhase(phase): void
}

HeroClock --> CountdownModel
HeroClock ..> PhaseInfo
HeroClock --> ThemeService
StepTimeline ..> CountdownModel : fraction
StepTimeline ..> PhaseInfo
RingCanvas --> RingRenderer
RingCanvas *-- RingVisuals
RingRenderer <|.. WebGpuRingRenderer
RingRenderer <|.. WebGl2RingRenderer
RingRenderer <|.. Canvas2dRingRenderer
@enduml
