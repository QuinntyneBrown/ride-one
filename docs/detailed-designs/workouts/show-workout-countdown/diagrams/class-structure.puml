@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show the workout countdown

package "projects/wattzup/src/app/core" {
  class CountdownClock {
    +CAP_SECONDS = 1.25
    -remaining: number
    -elapsed: number
    -total: number
    -duration: number
    -running: boolean
    -at: number
    +anchor(workout: Workout, now: number): void
    +drift(now): number
    +remainingAt(now): number
    +elapsedAt(now): number
    +progressAt(now): number
  }
  class formatDuration <<function>> {
    +formatDuration(seconds: number): string
  }
  class SegmentLabels <<module segment-labels.ts>> {
    +kindLabel(kind: SegmentKind): string
    +phaseOf(kind): 'effort' | 'easy'
    +toneOf(kind): 'work' | 'rest' | 'easy'
    +roundLabel(segment, plan): string | null
    +nextLabel(segments, index): NextSegment | null
    +statusBadge(status: string): string | null
  }
}

package "projects/components/src/lib + projects/wattzup/src/app/dashboard" {
  class Interval <<component wz-interval>> {
    +Signal<string> kind
    +Signal<string | null> round
    +Signal<'work' | 'rest' | 'easy'> tone
    +Signal<NextSegment | null> next
    -frame(now): void
  }
  class RideClock <<component wz-ride-clock>> {
    +Signal<number | null> total
    -frame(now): void
  }
  class WorkoutLink <<component wz-workout-link>> {
    +Signal<string> label
    +Signal<string> accessibleName
  }
}

class LiveStateService <<service>> {
  +Signal<BikeState | null> state
}

Interval --> CountdownClock : shared, dashboard-scoped
RideClock --> CountdownClock : shared, dashboard-scoped
Interval ..> SegmentLabels
Interval ..> formatDuration
RideClock ..> formatDuration
Interval --> LiveStateService
RideClock --> LiveStateService
WorkoutLink --> LiveStateService
@enduml
