@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Ride along to a video

package "Wattzup.Core" {
  abstract class WorkoutPlan {
    +RideVideo? Video
  }
  class HiitPlan
  class FlatPlan
  class IntervalsPlan
  class RideVideo {
    +string VideoId
    +double StartSeconds
  }
  class YouTubeLink <<static>> {
    +TryParseId(url: string, out id: string): bool
  }
  class WorkoutPlanValidator <<static>> {
    +VideoLink: string
    +VideoStart: string
    +Validate(body): PlanValidationResult
  }
}

package "Wattzup Web — core" {
  interface YouTubePlayer {
    +create(host, videoId, startSeconds): Promise<PlayerHandle>
  }
  interface PlayerHandle {
    +seek(seconds): void
    +play(): void
    +pause(): void
    +currentTime(): number
    +title(): string
    +destroy(): void
    +state: Signal<PlayerState>
    +refused: Signal<number>
    +error: Signal<number | null>
  }
  class IframeYouTubePlayer
  class "FakeYouTube (e2e fixture)" as FakeYouTube
  class "video-sync.ts" as VideoSyncRules <<pure>> {
    +targetPosition(video, workout): number
    +syncAction(status, playerState, position, target): SyncAction
    +riderAction(status, playerState, cause): RiderAction
    +isBlocked(refusals: number): boolean
  }
  class VideoSync <<service>> {
    -refusals: number
    +blocked: Signal<boolean>
    +failed: Signal<boolean>
    +playNow(): void
  }
  class "video-link.ts" as VideoLinkRules <<pure>> {
    +videoIdOf(url): string | null
    +formatStart(seconds): string
    +parseStart(text): number | null
    +stepStart(seconds, dir): number
  }
  class PlanDraftStore {
    +loadVideo(): VideoDraft
    +saveVideo(draft: VideoDraft): void
  }
  class VideoDraft {
    +on: boolean
    +url: string
    +start: number
  }
  class RideActions {
    +pause(): Promise<void>
    +resume(): Promise<void>
  }
}

package "Wattzup Web — dashboard" {
  class RidePage {
    +view: Signal<'video' | 'chart'>
  }
  class MainViewTabs
  class "RideVideo (wz-ride-video)" as RideVideoComponent
  class PlanStrip
  class VideoLink
  class SetupPage
}

WorkoutPlan <|-- HiitPlan
WorkoutPlan <|-- FlatPlan
WorkoutPlan <|-- IntervalsPlan
WorkoutPlan "1" --> "0..1" RideVideo : video
WorkoutPlanValidator ..> YouTubeLink : parses with
WorkoutPlanValidator ..> RideVideo : creates

YouTubePlayer <|.. IframeYouTubePlayer
FakeYouTube ..> IframeYouTubePlayer : answers the iframe_api it loads
YouTubePlayer ..> PlayerHandle : creates
VideoSync ..> VideoSyncRules : applies
VideoSync --> PlayerHandle : drives
VideoSync ..> RideActions : pause / resume
RidePage *-- VideoSync : provides
RidePage --> MainViewTabs
RidePage --> RideVideoComponent
RidePage --> PlanStrip
RideVideoComponent ..> VideoSync : blocked, failed
VideoLink ..> VideoLinkRules
VideoLink ..> YouTubePlayer : preview
SetupPage --> VideoLink
SetupPage ..> PlanDraftStore : saves VideoDraft
PlanDraftStore --> VideoDraft
@enduml
