@startuml
title UML sequence behaviour — Play the video in sync with the ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web" #E0F2FE
  participant "LiveStateService" as live
  participant "RidePage" as page
  participant "VideoSync" as sync
  participant "video-sync.ts" as rules
  participant "YOUTUBE_PLAYER handle" as player
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserStateSource" as events
end box

events -> live : state (workout.status, elapsed_seconds, plan.video)
live -> page : state()
page -> page : plan.video set: show tabs, ride video and plan strip [L2-076 AC1]
page -> sync : first state with a video: create the player [L2-076 AC8]
sync -> player : create(host, video_id, start_seconds)
loop each state and each player report
  live -> sync : state()
  sync -> rules : targetPosition(video, workout)
  rules --> sync : start_seconds + elapsed_seconds
  sync -> player : currentTime(), state
  sync -> rules : syncAction(status, playerState, position, target)
  alt status running and drift over 1.5 s
    rules --> sync : seek
    sync -> player : seek(target) (cause: sync) [L2-076 AC3]
  else status running and player not playing
    rules --> sync : play-at
    sync -> player : seek(target); play() (cause: sync)
  else any other status
    rules --> sync : pause-at
    sync -> player : pause(); seek(target) (cause: sync) [L2-076 AC4]
  else in step
    rules --> sync : none
  end
end
opt tab shown again (visibilitychange)
  sync -> player : seek(target) before play() [L2-076 AC10]
end
@enduml
