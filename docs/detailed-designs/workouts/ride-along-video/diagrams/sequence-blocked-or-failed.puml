@startuml
title UML sequence behaviour — Blocked playback or a failed player
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "RideVideo" as view
  participant "VideoSync" as sync
  participant "YOUTUBE_PLAYER handle" as player
  participant "RidePage" as page
  participant "ToastService" as toasts
end box

sync -> player : play() (cause: sync)
player --> sync : refused
sync -> player : play() again
player --> sync : refused
sync -> sync : isBlocked(2) is true [L2-076 AC6]
sync --> view : blocked
view --> rider : Play video in sync covers the player; the ride keeps running
rider -> view : Press Play video in sync
view -> sync : playNow()
sync -> player : seek(start_seconds + elapsed_seconds); play()
player --> sync : playing
sync --> view : not blocked

== Player error (offline, removed or not embeddable) ==
player --> sync : error(code)
sync -> toasts : Couldn't play the video / The ride carries on without it. [L2-076 AC7]
sync -> page : select Power vs. plan
note over page : The ride is neither paused nor stopped
@enduml
