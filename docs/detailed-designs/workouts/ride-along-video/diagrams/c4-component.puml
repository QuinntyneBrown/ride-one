@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Ride along to a video

Container_Boundary(web, "Wattzup Web") {
  Component(videolink, "VideoLink", "Angular component", "Switch, YouTube link, preview and start point on setup")
  Component(setup, "SetupPage", "Angular component", "Starts the plan with video or null")
  Component(ride, "RidePage", "Angular component", "Main view tabs, ride video, plan strip or trace")
  Component(sync, "VideoSync", "Angular service", "Applies video-sync.ts to each state and player report")
  Component(token, "YOUTUBE_PLAYER", "Injection token", "IframeYouTubePlayer, which tests run against a fake IFrame player API")
  Component(live, "LiveStateService", "Angular service", "Owns the live state signal")
  Component(actions, "RideActions", "Angular service", "pause() and resume() with their toasts")
}
Container_Boundary(lib, "@wattzup/browser") {
  Component(ep, "BrowserWorkoutApi", "WORKOUT_API", "start, pause, resume")
  Component(validator, "validatePlan", "lib/engine", "Reads video.url and video.start_seconds")
  Component(link, "parseYouTubeId", "lib/engine, pure", "Link forms to the 11-character id")
}
Component(csp, "index.html CSP", "<meta> policy", "frame-src and script-src exceptions")
System_Ext(player, "YouTube player", "Embedded iframe")

Rel(videolink, token, "Previews through")
Rel(setup, videolink, "Reads the video draft from")
Rel(setup, ep, "start(plan)")
Rel(ep, validator, "Validates the plan with")
Rel(validator, link, "Parses the link with")
Rel(live, ride, "state()")
Rel(ride, sync, "Provides")
Rel(sync, token, "seek, play, pause")
Rel(sync, actions, "pause() or resume() for the rider's player action")
Rel(actions, ep, "pause() or resume()")
Rel(token, player, "Drives", "IFrame player API")
@enduml
