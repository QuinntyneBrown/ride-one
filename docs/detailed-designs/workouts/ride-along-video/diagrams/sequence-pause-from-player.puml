@startuml
title UML sequence behaviour — Pause or resume the ride from the player
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "YOUTUBE_PLAYER handle" as player
  participant "VideoSync" as sync
  participant "video-sync.ts" as rules
  participant "RideActions" as actions
  participant "ToastService" as toasts
end box
box "Backend — Wattzup API application" #D1FADF
  participant "WorkoutEndpoints" as ep
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "WorkoutEngine" as engine
end box

rider -> player : Pause inside the player
player -> sync : state paused
sync -> rules : riderAction(status, paused, cause)
alt cause is sync
  rules --> sync : none (the sync's own pause)
else status running, cause is rider
  rules --> sync : pause-ride
  sync -> actions : pause() [L2-076 AC5]
  actions -> ep : POST /api/workout/pause
  ep -> engine : Pause
  alt request fails
    ep --> actions : error
    actions -> toasts : Couldn't pause the ride [L2-046 AC6]
  else paused
    engine --> ep : status paused
    ep --> actions : 200
  end
end
rider -> player : Play inside the player while status is paused
player -> sync : state playing
sync -> rules : riderAction(paused, playing, rider)
rules --> sync : resume-ride
sync -> actions : resume()
actions -> ep : POST /api/workout/resume
ep --> actions : 200, or a failure with Couldn't resume the ride
@enduml
