@startuml
title UML sequence behaviour — Attach a video on setup
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "VideoLink" as vl
  participant "video-link.ts" as rules
  participant "YOUTUBE_PLAYER" as player
  participant "SetupPage" as page
  participant "PlanDraftStore" as store
  participant "WORKOUT_API" as client
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserWorkoutApi" as ep
  participant "validatePlan" as val
  participant "parseYouTubeId" as link
  participant "WorkoutEngine" as engine
end box

rider -> vl : Turn on Ride along to a video [L2-029 AC17]
rider -> vl : Paste https://www.youtube.com/watch?v=QUoToFsMNig
vl -> rules : videoIdOf(url)
alt link accepted
  rules --> vl : QUoToFsMNig
  vl -> player : create(host, QUoToFsMNig, 0) — loads iframe_api once
  player --> vl : PlayerHandle (preview)
  rider -> vl : Scrub, then Use video's current time [L2-029 AC18]
  vl -> player : pause(); currentTime()
  player --> vl : 12.0
  vl -> rules : formatStart(12.0)
  rules --> vl : 0:12.0
else link rejected
  rules --> vl : null
  vl --> rider : That doesn't look like a YouTube link. Paste a youtube.com or youtu.be link. [L2-029 AC19]
end
rider -> page : Start ride
page -> store : save plan drafts and VideoDraft {on, url, start} [L2-029 AC20]
page -> client : start(plan + video {url, start_seconds} or null)
client -> ep : start(plan)
ep -> val : validatePlan(body)
val -> link : parseYouTubeId(video.url)
alt valid
  link --> val : QUoToFsMNig
  val -> val : Round start_seconds to 0.1, drop the link [L2-010 AC14, AC17]
  val --> ep : plan with video {video_id: QUoToFsMNig, start_seconds: 12.0}
  ep -> engine : startWorkout(plan)
  engine --> ep : WorkoutSnapshot, plan.video {video_id, start_seconds}
  ep --> client : the new workout
  client --> page : Navigate to /
else invalid
  link --> val : null
  val --> ep : errors video.url or video.start_seconds [L2-010 AC16, AC17]
  ep --> client : ContractError invalid_workout
  client --> page : Couldn't start the ride
end
@enduml
