@startuml
title UML sequence behaviour — Start or replace a ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "SetupPage" as page
  participant "PlanDraftStore" as draft
  participant "LiveStateService" as live
  participant "ReplaceRideDialog" as dlg
  participant "WorkoutApi" as api
  participant "Router" as router
end box
box "Backend — Wattzup API application" #D1FADF
  participant "WorkoutEndpoints" as ep
end box

rider -> page : Press Start ride (valid plan)
page -> draft : save(draft) [L2-029]
page -> live : state().workout active?
alt no active workout
  page -> page : controls disabled; button "Starting…" [L2-029]
  page -> api : start(plan)
  api -> ep : POST /api/workout
  alt 200
    ep --> api : {"started": <workout>}
    page -> router : navigate("/") [L2-029]
  else 400
    ep --> api : ProblemDetails {code:"invalid_workout", errors}
    page --> rider : alert "Couldn't start the ride"; settings kept; button "Try again" [L2-029]
  end
else active workout
  page -> dlg : Dialog.open({plan, elapsed "7:07", current "HIIT · 8 × 40s / 20s", new "Flat · Level 12 · 30 min"})
  dlg --> rider : "Replace the ride in progress?"; focus on Keep current ride [L2-052]
  alt Replace ride
    dlg -> dlg : "Starting…"; close and Keep disabled; disableClose [L2-052]
    dlg -> api : start(plan)
    api -> ep : POST /api/workout
    alt 200
      dlg -> page : close({started: true})
      page -> router : navigate("/") [L2-052]
    else request fails
      dlg --> rider : alert "Couldn't start the new ride"; button "Try again" [L2-052]
    end
  else Keep current ride, close button or Escape
    dlg -> page : close(); focus returns to Start ride
  end
end
@enduml
