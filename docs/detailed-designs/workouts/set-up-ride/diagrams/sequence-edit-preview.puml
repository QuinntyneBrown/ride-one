@startuml
title UML sequence behaviour — Edit and preview a plan
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "SetupPage" as page
  participant "PlanDraftStore" as draft
  participant "plan-form" as form
  participant "ride-preview / plan-expansion" as prev
  participant "NumStepper (Rounds)" as rounds
  participant "FormSummary" as summary
  participant "RidePreview" as panel
end box

page -> draft : load()
draft --> page : last submitted draft, or DEFAULT_DRAFT with 40 / 20 pressed [L2-029]
page -> prev : previewOf(toPlan(draft))
prev --> page : 12:40, 8 × 0:40 / 0:20, 5:20, Level 18, ~208 W, ~157 kcal [L2-059]
page -> panel : preview
rider -> page : Press preset "Tabata"
page -> form : applyPreset(draft, tabata)
form --> page : rounds 8, work 0:20, recover 0:10; Tabata pressed [L2-029]
rider -> rounds : Type "0"
rounds -> page : value 0; pressed preset cleared [L2-029]
page -> form : validateDraft(draft)
alt invalid
  form --> page : rounds: "Enter 1 to 30 rounds." [L2-010]
  page -> rounds : data-invalid, aria-invalid, field__error
  page -> summary : list the field: link "Rounds — enter 1 to 30" to #rounds [L2-029]
  page -> panel : total "—"; profile and summary keep the last valid plan; Start ride disabled [L2-029]
else valid
  page -> prev : previewOf(toPlan(draft))
  page -> panel : updated total, profile and summary [L2-059]
end
@enduml
