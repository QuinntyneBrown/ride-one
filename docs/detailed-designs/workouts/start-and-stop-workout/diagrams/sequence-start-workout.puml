@startuml
title UML sequence behaviour — Start a workout
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web" #E0F2FE
  participant "SetupPage" as page
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserWorkoutApi\n(WORKOUT_API)" as api
  participant "validatePlan" as val
  participant "WorkoutEngine" as engine
  participant "BikeStateStore" as store
end box

page -> api : start({kind:"hiit", rounds:8, work_seconds:40, rest_seconds:20, work_level:18, rest_level:6, warmup:true, cooldown:true})
api -> val : validatePlan(body) [L2-010]
alt unknown kind, missing or mistyped field, or value out of range
  val --> api : errors e.g. {"rounds":["Enter 1 to 30 rounds."]}
  api --> page : ContractError {code:"invalid_workout", errors} [L2-010, L2-017]
else valid
  val --> api : plan
  api -> engine : startWorkout(plan, origin)
  engine -> engine : discard active run; expand to 17 segments, 760 s; reset ride totals [L2-013, L2-045]
  alt bike connected
    engine -> engine : status "running"; send segment 0 level [L2-012]
  else not connected
    engine -> engine : status "waiting for bike" [L2-013]
  end
  engine -> store : update(workout)
  engine --> api : WorkoutSnapshot
  api --> page : the new workout [L2-017]
end
@enduml
