@startuml
title UML sequence behaviour — Stop a workout
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "EndRideDialog (L2-051)" as dlg
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserWorkoutApi\n(WORKOUT_API)" as api
  participant "WorkoutEngine" as engine
  participant "SessionStore" as sessions
  participant "BikeStateStore" as store
end box

rider -> dlg : Press End ride
dlg -> api : stop()
api -> engine : stop()
alt active workout
  engine -> engine : status "stopped"; stop ticking; bike left at current level [L2-013]
  opt at least 60 s ridden
    engine -> sessions : add(session) (history/record-session) [L2-081]
  end
  engine -> store : update(workout with session_id)
else ended workout
  engine -> engine : no change; status kept
else no workout
  engine -> engine : no-op; workout stays null [L2-017]
end
engine --> api : workout or null
api --> dlg : session_id or null [L2-017, L2-081 AC8]
@enduml
