@startuml
title UML sequence behaviour — Stop a workout
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "EndRideDialog (L2-051)" as dlg
  participant "WorkoutApi" as api
end box
box "Backend — Wattzup API application" #D1FADF
  participant "WorkoutEndpoints" as ep
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "WorkoutEngine" as engine
  participant "BikeStateStore" as store
end box

rider -> dlg : Press End ride
dlg -> api : stop()
api -> ep : POST /api/workout/stop
ep -> engine : StopAsync()
alt active workout
  engine -> engine : status "stopped"; stop ticking; bike left at current level [L2-013]
  engine -> store : Update(workout), broadcast
else ended workout
  engine -> engine : no change; status kept
else no workout
  engine -> engine : no-op; workout stays null [L2-017]
end
ep --> api : 200 {"stopped":true} [L2-017]
api --> dlg : ok
@enduml
