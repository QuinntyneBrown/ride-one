@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Start and stop a workout

package "wattzup app" {
  class RideControls <<component>> {
    +selector = "wz-ride-controls"
    +action: Signal<'pause' | 'resume'>
    +disabled: Signal<boolean>
    +press(): void
  }
  class LiveStateService <<service>> {
    +state: Signal<BikeState | null>
  }
}

package "@wattzup/api" {
  interface WorkoutApi {
    +start(plan: StartPlan): Promise<WorkoutSnapshot>
    +stop(): Promise<string | null>
    +pause(): Promise<void>
    +resume(): Promise<void>
    +backToPlan(): Promise<void>
    +trace(): Promise<PowerTrace>
  }
  class WORKOUT_API <<InjectionToken>>
  class ContractError {
    +code: string
    +errors?: Record<string, string[]>
  }
}

package "@wattzup/browser" {
  class BrowserWorkoutApi {
    -engine: WorkoutEngine
    -classes: BrowserClassApi
  }
  class "workout-plan-validator" as Validator <<module>> {
    +validatePlan(body: unknown): PlanValidationResult
  }
  class PlanValidationResult {
    +plan: WorkoutPlan | null
    +errors: Record<string, string[]>
  }
  class WorkoutEngine {
    +startWorkout(plan, origin): Promise<WorkoutSnapshot>
    +stop(): Promise<WorkoutSnapshot | null>
    +pause(): Promise<WorkoutSnapshot | null>
    +resume(): Promise<WorkoutSnapshot | null>
    +backToPlan(): Promise<WorkoutSnapshot | null>
    +trace(): PowerTrace
  }
}

WorkoutApi <|.. BrowserWorkoutApi
WORKOUT_API ..> WorkoutApi : provides
RideControls ..> WORKOUT_API : injects
RideControls --> LiveStateService
BrowserWorkoutApi ..> Validator
BrowserWorkoutApi ..> ContractError : rejects with
BrowserWorkoutApi --> WorkoutEngine
Validator ..> PlanValidationResult : returns
@enduml
