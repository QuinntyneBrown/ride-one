@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Start and stop a workout

package "frontend" {
  interface WorkoutApi {
    +start(plan: WorkoutPlan): Observable<StartResponse>
    +stop(): Observable<StopResponse>
    +pause(): Observable<WorkoutResponse>
    +resume(): Observable<WorkoutResponse>
    +backToPlan(): Observable<WorkoutResponse>
    +trace(): Observable<TraceResponse>
  }
  class HttpWorkoutApi <<service>> {
    -http: HttpClient
  }
  class WORKOUT_API <<InjectionToken>>
  class RideControls <<component>> {
    +selector = "wz-ride-controls"
    +Signal<'pause' | 'resume'> action
    +Signal<boolean> disabled
    +press(): void
  }
  class LiveStateService <<service>> {
    +Signal<BikeState | null> state
    +Signal<boolean> streamUp
  }
}

package "Wattzup.Api" {
  class WorkoutEndpoints <<static>> {
    +MapWorkout(group: RouteGroupBuilder): void
  }
  class WorkoutProblems <<static>> {
    +InvalidWorkout(errors): IResult
    +NoActiveWorkout(): IResult
  }
}

package "Wattzup.Core" {
  class WorkoutPlanValidator <<static>> {
    +Validate(body: JsonElement): PlanValidationResult
  }
  class PlanValidationResult <<record>> {
    +WorkoutPlan? Plan
    +IReadOnlyDictionary<string, string[]> Errors
    +bool IsValid
  }
  abstract class WorkoutPlan <<record>>
  class HiitPlan <<record>>
  class FlatPlan <<record>>
  class WorkoutEngine <<BackgroundService>> {
    +StartAsync(plan): Task<WorkoutSnapshot>
    +StopAsync(): Task
    +PauseAsync(): Task<CommandResult>
    +ResumeAsync(): Task<CommandResult>
    +BackToPlanAsync(): Task<CommandResult>
  }
  class CommandResult <<record>> {
    +bool HadActiveWorkout
    +WorkoutSnapshot? Workout
  }
}

WorkoutApi <|.. HttpWorkoutApi
WORKOUT_API ..> WorkoutApi : provides
RideControls ..> WORKOUT_API : injects
RideControls --> LiveStateService
HttpWorkoutApi ..> WorkoutEndpoints : HTTP
WorkoutEndpoints ..> WorkoutPlanValidator
WorkoutEndpoints ..> WorkoutProblems
WorkoutEndpoints --> WorkoutEngine
WorkoutPlanValidator ..> PlanValidationResult : returns
PlanValidationResult --> WorkoutPlan
WorkoutPlan <|-- HiitPlan
WorkoutPlan <|-- FlatPlan
WorkoutEngine ..> CommandResult
@enduml
