@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Start and stop a workout

Person(rider, "Rider", "Starts, pauses, resumes and ends rides")
Container_Boundary(web, "Wattzup Web") {
  Component(controls, "RideControls", "Angular component, wz-ride-controls", "Pause or Resume in the app bar")
  Component(setup, "SetupPage", "Angular component, wz-setup-page", "Builds the plan (set-up-ride)")
  Component(live, "LiveStateService", "Angular service", "Read-only state signal")
  Component(wapi, "WorkoutApi", "Contract + WORKOUT_API token", "start, stop, pause, resume, backToPlan, trace")
}
Container_Boundary(be, "Wattzup API") {
  Component(ep, "WorkoutEndpoints", "Minimal API", "/api/workout route group")
  Component(val, "WorkoutPlanValidator", "Wattzup.Core", "JSON to WorkoutPlan or errors map")
  Component(engine, "WorkoutEngine", "BackgroundService, Wattzup.Core", "Runs one workout at a time")
  Component(trace, "PowerTraceHistory", "Wattzup.Core", "Running-second power samples (L2-050)")
}

Rel(rider, controls, "Presses Pause or Resume")
Rel(rider, setup, "Presses Start ride")
Rel(controls, live, "Reads workout status")
Rel(controls, wapi, "pause() / resume()")
Rel(setup, wapi, "start(plan)")
Rel(wapi, ep, "POST / GET", "JSON/HTTP")
Rel(ep, val, "Validate(body)")
Rel(ep, engine, "StartAsync / StopAsync / PauseAsync / ResumeAsync / BackToPlanAsync")
Rel(ep, trace, "Samples()")
@enduml
