@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Start and stop a workout

Person(rider, "Rider", "Starts, pauses, resumes and ends rides")
Container_Boundary(web, "Wattzup Web") {
  Component(controls, "RideControls", "Angular component, wz-ride-controls", "Pause or Resume in the app bar")
  Component(setup, "SetupPage", "Angular component, wz-setup-page", "Builds the plan (set-up-ride)")
  Component(live, "LiveStateService", "Angular service", "Read-only state signal")
  Component(wapi, "WorkoutApi", "Contract + WORKOUT_API token, @wattzup/api", "start, stop, pause, resume, backToPlan, trace")
  Component(impl, "BrowserWorkoutApi", "@wattzup/browser lib/contracts", "Validates and calls the engine")
  Component(val, "validatePlan", "@wattzup/browser lib/engine", "Plan or errors map")
  Component(engine, "WorkoutEngine", "@wattzup/browser lib/engine", "Runs one workout at a time")
  Component(trace, "PowerTraceHistory", "@wattzup/browser lib/engine", "Running-second power samples (L2-050)")
}

Rel(rider, controls, "Presses Pause or Resume")
Rel(rider, setup, "Presses Start ride")
Rel(controls, live, "Reads workout status")
Rel(controls, wapi, "pause() / resume()")
Rel(setup, wapi, "start(plan)")
Rel(impl, wapi, "Implements")
Rel(impl, val, "validatePlan(body)")
Rel(impl, engine, "startWorkout / stop / pause / resume / backToPlan / trace")
Rel(engine, trace, "Adds a sample each running second")
@enduml
