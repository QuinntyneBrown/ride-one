@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Run an interval workout

package "@wattzup/api" {
  interface WorkoutPlan <<union by kind>> {
    +kind: 'hiit' | 'intervals' | 'flat'
  }
  interface Segment {
    +kind: 'warmup' | 'work' | 'rest' | 'cooldown' | 'steady'
    +start: number
    +duration: number
    +level: number
    +cadence: number
    +round: number | null
  }
  interface WorkoutSnapshot {
    +plan: WorkoutPlan
    +summary: string
    +segments: Segment[]
    +segment: number
    +remaining: number
    +elapsed_seconds: number
    +total_seconds: number
    +mode: 'plan' | 'manual'
    +plan_level: number
    +status: WorkoutStatus
    +ended_reason: string | null
    +session_id: string | null
  }
}

package "@wattzup/browser lib/engine" {
  class "plan-expander" as PlanExpander <<module>> {
    +expand(plan: WorkoutPlan): Segment[]
  }
  class "workout-summary" as WorkoutSummary <<module>> {
    +summaryFor(plan: WorkoutPlan): string
  }
  class WorkoutEngine {
    -run: WorkoutRun | null
    -queue: Promise<unknown>
    +TICK_MS = 250
    +SHUT_OFF_GRACE_MS = 90000
    +startWorkout(plan, origin): Promise<WorkoutSnapshot>
    +stop(): Promise<WorkoutSnapshot | null>
    +pause(): Promise<WorkoutSnapshot | null>
    +resume(): Promise<WorkoutSnapshot | null>
    +backToPlan(): Promise<WorkoutSnapshot | null>
    +setManual(level): Promise<SendResult>
    -tick(): Promise<void>
    -step(run): Promise<void>
    -drive(run): Promise<void>
  }
  class WorkoutRun {
    +plan: WorkoutPlan
    +segments: Segment[]
    +summary: string
    +totalSeconds: number
    +segment: number
    +remaining: number
    +elapsed: number
    +status: WorkoutStatus
    +endedReason: string | null
    +mode: 'plan' | 'manual'
    +planLevel: number
    +hasStarted: boolean
    +pausedByRider: boolean
    +sentForSegment: number | null
    +lastSentLevel: number | null
    +disconnectedSince: number | null
    +anchor: number
    +isActive: boolean
    +toSnapshot(): WorkoutSnapshot
  }
  class ResistanceCommander {
    +send(level, source, rideSeconds): Promise<SendResult>
  }
  class BikeStateStore {
    +state: Signal<BikeState>
    +update(change): void
  }
}
class BikeLink <<lib/bluetooth>> {
  +connection(): GattLink | null
}

PlanExpander ..> WorkoutPlan : reads
PlanExpander ..> Segment : creates
WorkoutEngine *-- "0..1" WorkoutRun
WorkoutEngine ..> PlanExpander
WorkoutEngine ..> WorkoutSummary
WorkoutRun --> WorkoutPlan
WorkoutRun "1" *-- "1..*" Segment
WorkoutRun ..> WorkoutSnapshot : projects
WorkoutEngine --> ResistanceCommander
WorkoutEngine --> BikeLink
WorkoutEngine --> BikeStateStore
@enduml
