@startuml
title UML sequence behaviour — Disconnect, reconnect and shut-off
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
participant "Echelon bike" as bike
box "Backend — Wattzup API application" #D1FADF
  participant "ActiveConnectionRegistry" as reg
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "WorkoutEngine" as engine
  participant "IResistanceCommander" as cmdr
  participant "BikeStateStore" as store
end box

note over engine : running, segment 9 (work, round 5, level 18), remaining 33, elapsed 427
bike ->x reg : connection lost
engine -> reg : tick: IsConnected = false
engine -> store : status "paused: bike disconnected"; elapsed 427 and remaining 33 unchanged [L2-013]
alt bike returns within 90 s
  bike -> reg : reconnected
  engine -> reg : tick: IsConnected = true
  engine -> store : status "running"; same segment and remaining [L2-013]
  engine -> cmdr : SendAsync(18, plan), because SentForSegment was cleared [L2-012]
  engine -> store : next tick counts: elapsed 428, remaining 32 [L2-011]
else still disconnected 90 s later
  engine -> store : status "ended: bike shut off"; ended_reason "bike shut off" [L2-013]
  engine -> engine : run stops ticking
end
@enduml
