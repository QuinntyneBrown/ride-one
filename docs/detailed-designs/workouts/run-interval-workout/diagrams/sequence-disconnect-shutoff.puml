@startuml
title UML sequence behaviour — Disconnect, reconnect and shut-off
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
participant "Echelon bike" as bike
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BikeLink" as link
  participant "WorkoutEngine" as engine
  participant "ResistanceCommander" as cmdr
  participant "BikeStateStore" as store
end box

note over engine : running, segment 9 (work, round 5, level 18), remaining 33, elapsed 427
bike ->x link : gattserverdisconnected
engine -> link : tick: connection() = null
engine -> store : status "paused: bike disconnected"; elapsed 427 and remaining 33 unchanged [L2-013]
alt bike returns within 90 s
  link -> bike : retry every 3 s (bike-connectivity/connect-the-bike)
  bike --> link : connected
  engine -> link : tick: connection() set
  engine -> store : status "running"; same segment and remaining [L2-013]
  engine -> cmdr : send(18, plan), because sentForSegment was cleared [L2-012]
  engine -> store : next second counts: elapsed 428, remaining 32 [L2-011]
else still disconnected 90 s later
  engine -> store : status "ended: bike shut off"; ended_reason "bike shut off" [L2-013]
  engine -> engine : run stops ticking; a ride of 60 s or more is saved (history/record-session)
end
@enduml
