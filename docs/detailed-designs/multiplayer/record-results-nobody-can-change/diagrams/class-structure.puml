@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
set separator none
' --------------------------
title Class structure — Record results nobody can change

package "Telo.Ride.Domain" {
  class SessionResult {
    +Guid SessionId
    +SessionKind Kind
    +DateTimeOffset EndedAt
    +IReadOnlyList<SessionResultEntry> Entries
    +static From(session: LiveSession, ranking: Standings): SessionResult
  }
  class SessionResultEntry {
    +Guid? RiderId
    +string Name
    +int Place
    +TimeSpan? Time
    +double OutputKj
    +RiderStatus Status
  }
  class Ride {
    +Guid Id
    +Guid RiderId
    +Guid? SessionId
    +int? Place
    +TimeSpan Time
    +double OutputKj
    +string ResultJson
  }
  class RidePlausibilityRule {
    +MaxPowerWatts: int = 2000
    +MaxSpeedKmh: double = 100
    +DistanceTolerance: double = 0.05
    +Check(ride: SubmittedRide, map: MapDefinition?): PlausibilityVerdict
  }
  class PlausibilityVerdict {
    +bool Plausible
    +string? Breach
  }
  enum SessionKind {
    Race
    GroupClass
  }
}
package "Telo.Ride.Application" {
  class SubmitRideCommand {
    +Guid RideId
    +Guid? SessionId
    +SubmittedRide Ride
  }
  class SubmitRideCommandHandler {
    +Handle(cmd: SubmitRideCommand): Task<RideResultDto>
  }
  class SessionResultRecorder {
    +RecordAsync(session: LiveSession): Task<SessionResult>
  }
  interface IAppDbContext {
    +DbSet<Ride> Rides
    +DbSet<SessionResult> SessionResults
    +SaveChangesAsync(): Task<int>
  }
}

SessionResult "1" *-- "10" SessionResultEntry
SessionResult --> SessionKind
Ride ..> SessionResult : SessionId
RidePlausibilityRule ..> PlausibilityVerdict : returns
SubmitRideCommandHandler ..> SubmitRideCommand : handles
SubmitRideCommandHandler ..> RidePlausibilityRule
SubmitRideCommandHandler ..> IAppDbContext
SessionResultRecorder ..> SessionResult : creates
SessionResultRecorder ..> IAppDbContext
@enduml
