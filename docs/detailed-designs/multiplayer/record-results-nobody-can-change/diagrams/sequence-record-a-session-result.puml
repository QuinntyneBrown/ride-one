@startuml
title UML sequence behaviour — Record a session result
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Riders' Ride apps" as apps
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RideHubNotifier" as notifier
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "TickLiveSessionsCommandHandler" as tick
  participant "LiveSession" as session
  participant "RankingPolicy" as rank
  participant "SessionResultRecorder" as recorder
end box
box "Backend — Telo.Ride.Infrastructure" #FFF4E5
  participant "SessionTicker" as ticker
  database "Telo Ride database" as db
end box
ticker -> tick : Send TickLiveSessionsCommand(now)
tick -> session : IsDue(now)
alt group class at its length, or race all finished / DNF, or 2 min after first finisher (L2-071 AC3)
  session --> tick : Due
  tick -> recorder : RecordAsync(session)
  recorder -> rank : Rank(session) from received progress only
  rank --> recorder : Final standings
  recorder -> recorder : SessionResult.From(session, standings) (L2-125 AC1)
  recorder -> db : Save SessionResult and entries
  db --> recorder : Committed
  recorder --> tick : SessionResult
  tick -> notifier : SessionEnded(sessionId, entries)
  notifier --> apps : SessionEnded
  tick -> session : State = Ended; removed from registry
else not due
  session --> tick : Keep running
end
@enduml
