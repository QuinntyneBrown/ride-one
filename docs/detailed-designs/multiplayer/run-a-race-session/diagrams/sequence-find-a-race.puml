@startuml
title UML sequence behaviour — Find a race
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "LiveSessionStore" as store
end box
box "Frontend — Ride app (domain and api libraries)" #E0F2FE
  participant "ServerClock" as clock
  participant "SignalRRideHubClient" as client
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RideHub" as hub
  participant "RideHubNotifier" as notifier
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "FindRaceCommandHandler" as handler
  participant "RaceSessionMatcher" as matcher
  participant "RaceSession" as session
end box
box "Backend — Telo.Ride.Infrastructure" #FFF4E5
  participant "InMemorySessionRegistry" as registry
  database "Telo Ride database" as db
end box
actor -> store : Choose "Find a race" on Old Town Criterium
store -> client : findRace(mapId) at sentAt
client -> hub : FindRace(mapId)
hub -> handler : Send FindRaceCommand(riderId, mapId)
handler -> db : Load display name, country, level
db --> handler : RiderOccupant
handler -> registry : Session holding this rider
alt rider already seated
  registry --> handler : RaceSession
else not seated
  handler -> matcher : FindFullestOpen(mapId)
  matcher -> registry : OpenSessions(mapId)
  registry --> matcher : Open sessions
  alt an open session has a free seat
    matcher --> handler : Session with the most riders (L2-121 AC1)
  else none
    matcher --> handler : None
    handler -> session : Open(mapId, now + 30 s) (L2-121 AC1)
    handler -> registry : Add(session)
  end
  handler -> session : Seat(rider) in the first open seat
  session --> handler : Seat n (at most 10, L2-121 AC2)
end
handler -> notifier : AddToSessionAsync(connectionId, sessionId)
handler -> notifier : SeatsChanged(sessionId, seats)
notifier --> client : SeatsChanged to every rider in session
handler --> hub : SeatAssignment(sessionId, seat, serverTime)
hub --> client : SeatAssignmentDto
client --> store : Seat and serverTime at receivedAt
store -> clock : sample(sentAt, serverTime, receivedAt)
store --> actor : Lobby shows the start grid
@enduml
