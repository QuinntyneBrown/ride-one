@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
set separator none
' --------------------------
title Class structure — Ride through a lost service

package "ride application" {
  class LiveSessionStore {
    +connection: Signal<RideHubState>
    +running: Signal<boolean>
    +serviceLost: Signal<boolean>
    +standings: Signal<StandingsDto | null>
  }
  class RacePage {
    #store: LiveSessionStore
  }
  class ClassRidePage {
    #store: LiveSessionStore
  }
}
package "components library" {
  class InlineMessage {
    +tone: InputSignal<'info' | 'warning' | 'error'>
    +live: InputSignal<'status' | 'alert'>
  }
}
package "domain library" {
  class ProgressReporter {
    +start(kind: 'race' | 'class'): void
    -send(): void
  }
  class RideOutbox {
    +add(ride: FinishedRide): Promise<void>
    +flush(): Promise<void>
  }
  class WorkoutEngine
  class RideClock
}
package "api library" {
  interface RideHubClient {
    +state: Signal<RideHubState>
  }
  enum RideHubState {
    disconnected
    connecting
    connected
    reconnecting
  }
}

LiveSessionStore --> RideHubClient : RIDE_HUB_CLIENT
RideHubClient --> RideHubState
RacePage --> LiveSessionStore
ClassRidePage --> LiveSessionStore
RacePage ..> InlineMessage : renders
ClassRidePage ..> InlineMessage : renders
ProgressReporter ..> RideHubClient : sends when connected
ProgressReporter ..> WorkoutEngine : reads
RacePage ..> RideOutbox : on finish
ClassRidePage ..> RideOutbox : on finish
WorkoutEngine --> RideClock
@enduml
