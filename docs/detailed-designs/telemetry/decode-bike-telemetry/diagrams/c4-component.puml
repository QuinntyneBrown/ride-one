@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Decode bike telemetry

Container_Boundary(app, "Wattzup Web") {
  Component(link, "BikeLink", "@wattzup/browser lib/bluetooth", "Delivers notify payloads; logs packets")
  Component(ing, "TelemetryIngestor", "lib/engine", "Counts, decodes and applies frames")
  Component(dec, "decode()", "lib/protocol/packet-decoder", "Frame bytes to TelemetryUpdate")
  Component(speed, "toKmh() / toMph()", "lib/protocol/speed-calculator", "Cadence to km/h and mph")
  Component(pow, "estimateWatts()", "lib/engine/power-estimator", "Estimated power (estimate-power-and-totals)")
  Component(cl, "acknowledge()", "lib/engine/command-log", "Acknowledges commands (log-resistance-commands)")
  Component(store, "BikeStateStore", "lib/engine", "Only writer of BikeState")
}
System_Ext(bike, "Echelon bike", "Proprietary BLE GATT service")

Rel(bike, link, "Notifications", "Web Bluetooth GATT")
Rel(link, ing, "onNotify(bytes)")
Rel(ing, dec, "decode(frame)")
Rel(dec, speed, "toKmh / toMph")
Rel(ing, pow, "estimateWatts(cadence, resistance)")
Rel(ing, cl, "acknowledge(commands, level, now)")
Rel(ing, store, "update(packets, metrics, power, commands, timestamps)")
@enduml
