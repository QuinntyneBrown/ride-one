@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Decode bike telemetry

package "@wattzup/browser lib/protocol" {
  class "packet-decoder" as PacketDecoder <<module>> {
    +MARKER = 0xF0
    +RESISTANCE = 0xD2
    +WORKOUT_DATA = 0xD1
    +decode(frame: Uint8Array): TelemetryUpdate | null
  }
  interface ResistanceUpdate {
    +kind: 'resistance'
    +level: number
  }
  interface CadenceUpdate {
    +kind: 'cadence'
    +rpm: number
    +speedKmh: number
    +speedMph: number
  }
  class "speed-calculator" as SpeedCalculator <<module>> {
    +KMH_PER_RPM = 0.37497622
    +KM_PER_MILE = 1.609344
    +toKmh(rpm: number): number
    +toMph(rpm: number): number
  }
}

package "@wattzup/browser lib/engine" {
  class TelemetryIngestor {
    -store: BikeStateStore
    -clock: Clock
    +onNotify(frame: Uint8Array): void
  }
  class BikeStateStore {
    +state: Signal<BikeState>
    +update(change: (s: BikeState) => BikeState): void
  }
  class "power-estimator" as PowerEstimator <<module>> {
    +estimateWatts(cadence, level): number | null
  }
}

PacketDecoder ..> ResistanceUpdate : returns
PacketDecoder ..> CadenceUpdate : returns
PacketDecoder ..> SpeedCalculator : uses
TelemetryIngestor ..> PacketDecoder : uses
TelemetryIngestor ..> PowerEstimator : uses
TelemetryIngestor --> BikeStateStore : updates
@enduml
