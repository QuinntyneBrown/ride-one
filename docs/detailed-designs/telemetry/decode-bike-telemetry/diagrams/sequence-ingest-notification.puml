@startuml
title UML sequence behaviour — Ingest one notification
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
participant "Echelon bike" as bike
box "Frontend — @wattzup/browser lib/bluetooth" #FFF4E5
  participant "BikeLink" as link
  participant "PacketLog" as log
end box
box "Frontend — @wattzup/browser lib/engine and lib/protocol" #ECFDF3
  participant "TelemetryIngestor" as ing
  participant "decode()" as dec
  participant "speed-calculator" as speed
  participant "estimateWatts()" as pow
  participant "BikeStateStore" as store
end box

bike -> link : notification (frame bytes)
opt Log every packet is on
  link -> log : add(received, frame) [L2-095 AC1]
end
link -> ing : onNotify(frame)
ing -> dec : decode(frame)
alt length < 4, byte0 != F0, unknown type, or D1 shorter than 13 bytes
  dec --> ing : null [L2-005]
  ing -> store : update(packets += 1) [L2-005]
else type D2
  dec --> ing : {kind: 'resistance', level: frame[3]} [L2-006]
  ing -> pow : estimateWatts(cadence, level)
  ing -> store : update(packets += 1, resistance, power, acknowledge(commands, level), last_data_at = now, first_data_at ??= now)
else type D1, length >= 13
  dec -> dec : rpm = (frame[9] << 8) | frame[10]
  dec -> speed : toKmh(rpm), toMph(rpm)
  speed --> dec : round(rpm x 0.37497622, 1), round(rpm x 0.37497622 / 1.609344, 1)
  dec --> ing : {kind: 'cadence', rpm, speedKmh, speedMph} [L2-007]
  ing -> pow : estimateWatts(rpm, resistance) [L2-049]
  ing -> store : update(packets += 1, cadence, speed_kmh, speed_mph, power, last_data_at = now, first_data_at ??= now)
end
store -> store : publish the new state (1 change per frame)
@enduml
