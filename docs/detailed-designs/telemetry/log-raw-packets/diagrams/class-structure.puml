@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Log raw packets

class RawPacketLogger {
  -Channel<RawPacket> channel
  +Enqueue(packet: RawPacket): void
  +ChannelReader<RawPacket> Reader
}
class RawPacket <<record struct>> {
  +double EpochSeconds
  +byte[] Bytes
}
class RawPacketLogWriter {
  -RawPacketLogger source
  -RollingFile file
  -TimeProvider time
  #ExecuteAsync(ct): Task
}
class RawPacketFormatter <<static>> {
  +Format(packet: RawPacket): string
}
class RollingFile {
  -string path
  -long maxBytes
  -int retained
  +AppendAsync(line: string, ct): Task
  +FlushAsync(ct): Task
  -Rotate(): void
}
class RawPacketLogOptions {
  +string Path = "raw_packets.log"
  +long MaxBytes = 10485760
  +int RetainedFiles = 5
  +bool Enabled = true
}
class RecentPacketBuffer {
  +const int Capacity = 60
  -RawPacket[] slots
  -int next
  -int count
  -Lock gate
  +Add(packet: RawPacket): void
  +Snapshot(): IReadOnlyList<string>
}
class DiagnosticsEndpoints <<static>> {
  +MapDiagnostics(app: IEndpointRouteBuilder): void
}

RawPacketLogger *-- "0..10000" RawPacket : buffers
RecentPacketBuffer *-- "0..60" RawPacket : keeps newest
RawPacketLogWriter --> RawPacketLogger : drains
RawPacketLogWriter --> RollingFile : appends
RawPacketLogWriter ..> RawPacketFormatter
RecentPacketBuffer ..> RawPacketFormatter
RollingFile ..> RawPacketLogOptions : configured by
DiagnosticsEndpoints --> RecentPacketBuffer
@enduml
