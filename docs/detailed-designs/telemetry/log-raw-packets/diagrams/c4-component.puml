@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Log raw packets

Container_Boundary(api, "Wattzup API") {
  Component(ing, "TelemetryIngestor", "Wattzup.Core", "Notify handler")
  Component(logger, "RawPacketLogger", "Bounded channel", "Non-blocking enqueue")
  Component(writer, "RawPacketLogWriter", "BackgroundService", "Drains, formats and appends")
  Component(fmt, "RawPacketFormatter", "Pure function", "epoch.mmm + lowercase hex")
  Component(roll, "RollingFile", "File helper", "Size-based rotation")
}
ContainerDb(files, "Local files", "File system", "raw_packets.log and archives .1 to .5")

Rel(ing, logger, "Enqueue(now, frame)")
Rel(writer, logger, "Reads all")
Rel(writer, fmt, "Format")
Rel(writer, roll, "Append(line)")
Rel(roll, files, "Writes and renames")
@enduml
