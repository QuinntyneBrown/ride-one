@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Estimate power and ride totals

Container_Boundary(app, "Wattzup Web") {
  Component(ing, "TelemetryIngestor", "@wattzup/browser lib/engine", "Applies decoded frames")
  Component(eng, "WorkoutEngine", "@wattzup/browser lib/engine", "1 s tick while running")
  Component(pow, "PowerEstimator", "@wattzup/browser lib/engine", "estimateWatts(cadence, level)")
  Component(tot, "RideTotals", "@wattzup/browser lib/engine", "Per-run accumulator")
  Component(store, "BikeStateStore", "@wattzup/browser lib/engine", "Only writer of BikeState")
  Component(live, "LiveStateService", "Angular service", "Read-only state signal")
  Component(web, "Ride Dashboard", "Angular page", "Readouts (dashboard/show-live-metrics)")
}

Rel(ing, pow, "power = estimateWatts(cadence, resistance)")
Rel(ing, store, "update(power)")
Rel(eng, pow, "target_power = estimateWatts(aim, level)")
Rel(eng, tot, "tick(power, speed_kmh)")
Rel(eng, store, "update(target_power, avg_power, distance_km, kcal)")
Rel(store, live, "New state (BrowserStateSource)")
Rel(web, live, "Reads")
@enduml
