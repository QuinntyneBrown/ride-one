@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Estimate power and ride totals

package "@wattzup/browser lib/engine" {
  class "power-estimator" as PowerEstimator <<module>> {
    +estimateWatts(cadence: number | null, level: number | null): number | null
  }
  class RideTotals <<immutable>> {
    +runningSeconds: number
    +powerSum: number
    +distanceKm: number
    +tick(power, speedKmh): RideTotals
    +avgPower: number
    +distanceKmRounded: number
    +kcal: number
    +EMPTY: RideTotals
  }
  class WorkoutRun {
    +currentSegment: Segment
    +status: string
    +totals: RideTotals
  }
  class WorkoutEngine {
    -run: WorkoutRun | null
    -tick(): void
  }
  class TelemetryIngestor {
    +onNotify(frame: Uint8Array): void
  }
}
package "@wattzup/api" {
  interface BikeState {
    +power: number | null
    +target_power: number | null
    +avg_power: number | null
    +distance_km: number | null
    +kcal: number | null
    +heart_rate: null
  }
}

WorkoutEngine "1" *-- "0..1" WorkoutRun
WorkoutRun *-- RideTotals
WorkoutEngine ..> PowerEstimator : target power
TelemetryIngestor ..> PowerEstimator : power
WorkoutEngine ..> BikeState : updates via BikeStateStore
TelemetryIngestor ..> BikeState : updates via BikeStateStore
@enduml
