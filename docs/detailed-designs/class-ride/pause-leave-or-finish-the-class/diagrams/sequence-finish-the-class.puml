@startuml
title UML sequence behaviour — Finish the class
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "ClassRideStore" as store
  participant "Angular Router" as router
  participant "Class Done page" as done
end box
box "Frontend — Ride app (domain library)" #ECFDF3
  participant "RideTicker" as ticker
  participant "RideClock" as clock
  participant "Record store" as record
end box
box "Frontend — Ride app (video library)" #ECFDF3
  participant "YouTubeVideoPlayer" as player
end box
box "Device — Browser" #F2F4F7
  database "localStorage" as ls
end box
ticker -> store : Tick: second 1800, the plan's length
store -> store : Count the last running second
store -> clock : pause() at 30:00 (L2-093 AC2)
store -> ticker : stop()
store -> player : pause()
store -> store : Build the ride result from the running totals
store -> record : Record the finished ride (L2-168)
record -> ls : Write count, best output and last output
ls --> record : Written, or refused
record --> store : Outcome
store -> router : navigateByUrl("/done", state: ride result)
router -> store : Destroy Class Ride: timers, listeners and player released (L2-093 AC3)
router -> done : Activate /done
done --> rider : Class Done shows the result (L2-078)
@enduml
