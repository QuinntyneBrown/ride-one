@startuml
title UML sequence behaviour — Open and close a dialog
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider (keyboard or screen reader)" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "Ride page" as page
  participant "InertBackground" as inert
  participant "EndRideDialog" as dlg
end box
participant "CDK Dialog" as cdk
actor -> page : Activate "End ride"
page -> cdk : open(EndRideDialog, autoFocus first-tabbable, restoreFocus true)
cdk -> dlg : Create with role=dialog, aria-modal=true
cdk -> cdk : Trap focus inside the dialog (L2-141 AC3)
cdk -> inert : afterOpened
inert -> inert : Set inert on the .app root (L2-141 AC3)
cdk --> actor : Focus on the first control in the dialog
actor -> dlg : Escape or Cancel
dlg -> cdk : close()
cdk -> inert : afterAllClosed
inert -> inert : Remove inert from the .app root
cdk --> actor : Focus returns to "End ride" (L2-141 AC3)
@enduml
