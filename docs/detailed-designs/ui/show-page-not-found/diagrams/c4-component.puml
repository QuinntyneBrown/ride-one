@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show page not found

Person(rider, "Rider", "Follows an old link")
Container_Boundary(app, "Ride app") {
  Component(router, "Router (app.routes.ts)", "Angular router · ride", "Wildcard route ** last")
  Component(page, "NotFoundPage", "Angular page · ride", "Message and Back to Home")
  Component(header, "AppHeader", "Presentation component · components", "current = null")
  Component(home, "HomePage", "Angular page · ride", "Home")
}
Rel(rider, router, "Navigates to an unknown path")
Rel(router, page, "loadComponent")
Rel(page, header, "Renders with no current item")
Rel(page, router, "Back to Home: routerLink /")
Rel(router, home, "Opens")
@enduml
