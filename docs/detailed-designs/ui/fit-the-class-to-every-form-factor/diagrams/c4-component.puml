@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Fit The Class to every form factor

Person(rider, "Rider", "Rides a smart bike at home")
Container_Boundary(ride, "ride application") {
  Component(page, "TheClassPage", "Angular component, lazy route /", "Draws the the-class block and declares the start button once")
  Component(sheet, "the-class-page.scss", "Component stylesheet", "One column below lg; two columns on one screen from lg")
  Component(tokens, "tokens.css", "Global stylesheet", "~--the-class-aside-width, ~--layout-margin")
  Component(index, "index.html", "Document", "Viewport meta with viewport-fit=cover")
}
Container_Boundary(components, "components library") {
  Component(video, "ClassStartVideo", "Angular component, wz-class-start-video", "The class video in a 16:9 box")
  Component(plan, "ClassPlan", "Angular component, wz-class-plan", "What the bike will do")
  Component(button, "Button", "Angular component, wz-button", "The start button")
}
Rel(rider, page, "Views and starts the class from")
Rel(page, sheet, "Is laid out by")
Rel(page, video, "Places in the-class~__media")
Rel(page, plan, "Places in the-class~__plan")
Rel(page, button, "Renders in the-class~__action and the-class~__footer")
Rel(sheet, tokens, "Reads the aside width and page margin from")
Rel(sheet, index, "Needs viewport-fit=cover for env(safe-area-inset-bottom) from")
@enduml
