@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Open and keep settings
Person(rider, "Rider", "Rides a smart bike at home")
ContainerDb(ls, "Browser storage", "localStorage", "telo-ride.settings.v1")
Container_Boundary(app, "Ride app") {
  Component(page, "SettingsPage", "Angular page · ride (/settings)", "Sections, nav, reset")
  Component(sections, "SettingsSection / SideNav / SwitchRow / Segmented / Slider", "Presentation · components", "Section landmarks and controls")
  Component(store, "LocalRideSettingsStore", "Service · domain/storage (RIDE_SETTINGS)", "Signals; set, reset; persisted")
  Component(parse, "parseRideSettings() / RECOMMENDED_SETTINGS", "Pure helper · domain/storage", "Validates each field")
  Component(safe, "SafeStorage", "Helper · domain/storage", "Catches refused storage")
  Component(consumers, "Ride screens", "ride", "World, sound, theme, motion, wake lock read settings")
  Component(ann, "Announcer", "Service · api (ANNOUNCER)", "Settings reset")
}
Rel(rider, sections, "Changes a control")
Rel(page, sections, "Renders")
Rel(page, store, "set, reset")
Rel(page, ann, "Announces reset")
Rel(store, parse, "Parses stored JSON")
Rel(store, safe, "Reads and writes")
Rel(safe, ls, "getItem, setItem")
Rel(consumers, store, "Read computed settings")
@enduml
