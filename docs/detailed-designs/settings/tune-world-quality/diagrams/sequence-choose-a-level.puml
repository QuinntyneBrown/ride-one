@startuml
title UML sequence behaviour — Choose a quality level
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "SettingsPage" as page
  participant "WorldQualityBridge" as bridge
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "LocalRideSettingsStore" as store
  participant "qualityPolicy()" as policy
end box
box "Frontend — Ride app (world library, lazy chunk)" #E0F2FE
  participant "RendererBackendProbe" as probe
  participant "WorldRenderer" as renderer
end box
group A world opens
  bridge -> store : settings()
  bridge -> probe : probe(graphics: auto)
  probe --> bridge : webgpu
  bridge -> policy : qualityPolicy(settings, webgpu, check)
  policy --> bridge : Auto: start Ultra, stepDown, cap display, scale 1.0 (L2-159 AC4)
  bridge -> renderer : start at Ultra
end
group Mid-ride, the rider picks Medium
  actor -> page : Quality: Medium
  page -> store : set('quality', 'medium')
  store --> bridge : settings changed
  bridge -> policy : qualityPolicy(..)
  policy --> bridge : start Medium, stepDown on (L2-160 AC2)
  bridge -> renderer : setLevel(medium)
  renderer -> renderer : build Medium programs while Ultra keeps drawing
  renderer -> renderer : switch on the next frame; no pause (L2-159 AC7)
end
group Mid-ride, the rider sets Frame rate 30 fps and Resolution 75 %
  page -> store : set('frameRate', '30'), set('resolution', 75)
  bridge -> renderer : FramePacer cap 30; setRenderScale(0.75), HUD unchanged (L2-160 AC4, AC5)
end
group Mid-ride, the rider picks WebGL 2
  page -> store : set('graphics', 'webgl2')
  bridge --> actor : toast: applies from the next world (L2-161 AC3; copy <TO SUPPLY>)
  note right of bridge : The running renderer keeps its backend
end
@enduml
