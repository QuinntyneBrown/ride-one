@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
hide empty members
title Class structure — Adjust sound, motion and display
interface RideSound <<api>> {
  +setEnabled(on: boolean): void
  +setVolume(percent: number): void
  +setMusic(on: boolean): void
  +duck(on: boolean): void
  +stop(): void
}
class RideSoundEngine <<domain/engine>> {
  -context?: AudioContext
  -master: GainNode
  -music: GainNode
  -ramp(gain: GainNode, to: number): void
}
class VideoDucking <<ride>> {
  +watch(player: VideoPlayer, settings: RideSettingsStore): void
}
class MotionPreference <<ride>> {
  +reduced: Signal<boolean>
  +deviceAsks: Signal<boolean>
}
class ThemeController <<ride>> {
  +theme: Signal<'dark' | 'light'>
}
class RideNumbersSize <<ride>> {
  +large: Signal<boolean>
}
interface WakeLock <<api>> {
  +hold(): Promise<void>
  +release(): Promise<void>
}
class ScreenWakeLock <<ride/browser>> {
  -sentinel?: WakeLockSentinel
  -onVisibility(): void
}
class RideActivity <<ride>> {
  +riding: Signal<boolean>
}
interface RideSettingsStore <<api>> {
  +settings: Signal<RideSettings>
}
RideSound <|.. RideSoundEngine
WakeLock <|.. ScreenWakeLock
VideoDucking ..> RideSound : duck
RideSoundEngine ..> RideSettingsStore : reads
MotionPreference ..> RideSettingsStore
ThemeController ..> RideSettingsStore
RideNumbersSize ..> RideSettingsStore
ScreenWakeLock ..> RideSettingsStore
ScreenWakeLock ..> RideActivity
@enduml
