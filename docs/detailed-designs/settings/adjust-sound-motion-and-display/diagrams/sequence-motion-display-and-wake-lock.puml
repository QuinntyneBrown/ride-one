@startuml
title UML sequence behaviour — Motion, theme, wake lock and full screen
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "DisplaySettings" as view
  participant "MotionPreference" as motion
  participant "ThemeController" as theme
  participant "ScreenWakeLock" as wake
  participant "Start action" as start
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "LocalRideSettingsStore" as store
end box
participant "Browser" as browser
actor -> view : Reduce motion: On
view -> store : set('reduceMotion', 'on')
store --> motion : reduced = true
motion -> browser : html[data-motion="reduced"]; world drops or stills moving techniques (L2-164 AC2)
actor -> view : Theme: Match device
view -> store : set('theme', 'device')
theme -> browser : matchMedia('(prefers-color-scheme: light)'); dark unless it matches (L2-164 AC3)
actor -> start : Start riding (fullScreenOnStart on)
start -> browser : FULLSCREEN.enter() inside the press (L2-164 AC6)
start --> wake : riding = true
wake -> browser : navigator.wakeLock.request('screen') (L2-164 AC5)
browser --> wake : released when the tab is hidden
wake -> browser : request again on visibilitychange to visible
start --> wake : riding = false at the end
wake -> browser : sentinel.release()
@enduml
