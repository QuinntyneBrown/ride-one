@startuml
title UML sequence behaviour — Change sound mid-ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "SoundSettings" as view
  participant "VideoDucking" as duck
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "LocalRideSettingsStore" as store
  participant "RideSoundEngine" as engine
end box
participant "Web Audio" as audio
actor -> view : Ride sound volume 70 % to 40 %
view -> store : set('rideVolume', 40)
store --> engine : settings changed
engine -> audio : master.gain.setTargetAtTime(0.4, now, 0.05 s); heard within 100 ms, no click (L2-163 AC2)
actor -> view : Ride sound off
view -> store : set('rideSound', false)
engine -> audio : ramp to 0, then close the AudioContext
note right of engine : With ride sound off no context is created (L2-163 AC3)
opt Class video plays and "Mute ride sound under a class video" is on
  duck -> engine : duck(true): ramp to silence
  duck -> engine : duck(false) when the video pauses
end
@enduml
