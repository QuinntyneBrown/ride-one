@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
hide empty members
title Class structure — Manage saved worlds
class SavedWorld <<api>> {
  +worldId: string
  +name: string
  +bytes: number
}
interface WorldCache <<api>> {
  +get(worldId: string): Promise<WorldBundle | undefined>
  +put(worldId: string, bundle: WorldBundle): Promise<void>
  +list(): Promise<SavedWorld[]>
  +totalBytes(): Promise<number>
  +clear(): Promise<void>
}
class CacheStorageWorldCache <<domain/storage>> {
  -name = 'telo-ride-worlds-v1'
  -index(): Promise<SavedWorld[]>
}
class SavedWorldsStore <<ride>> {
  +worlds: Signal<SavedWorld[]>
  +summary: Signal<string>
  +clear(): Promise<void>
}
class WorldAssetLoader <<world>> {
  +load(world: WorldDto, signal: AbortSignal): Promise<WorldBundle>
}
interface RideSettingsStore <<api>> {
  +settings: Signal<RideSettings>
}
class DeviceSettings <<components>> {
  +summary: InputSignal<string>
  +names: InputSignal<string>
  +keepWorlds: InputSignal<boolean>
  +clear: OutputEmitterRef<void>
  +keepWorldsChange: OutputEmitterRef<boolean>
}
WorldCache <|.. CacheStorageWorldCache
WorldCache ..> SavedWorld
SavedWorldsStore ..> WorldCache : WORLD_CACHE
WorldAssetLoader ..> WorldCache : WORLD_CACHE
WorldAssetLoader ..> RideSettingsStore : keepWorlds
DeviceSettings ..> SavedWorldsStore : bound by SettingsPage
@enduml
