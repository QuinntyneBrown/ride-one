@startuml
title UML sequence behaviour — Run the device check
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "DeviceCheck" as view
  participant "DeviceCheckStore" as store
  participant "RideActivity" as activity
end box
box "Frontend — Ride app (world library, lazy chunk)" #E0F2FE
  participant "DeviceCheckRunner" as runner
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "LocalRideSettingsStore" as settings
end box
store -> activity : riding()
alt A ride runs
  store --> view : disabled (L2-162 AC5)
else No ride
  store --> view : "Check this device" with its text (L2-162 AC1)
end
actor -> view : Check this device
view -> store : start()
store -> runner : import('world'); run(webgpu, 16.7 ms, abort.signal)
loop each level from Ultra down
  runner -> runner : trial of about 30 s off screen
  runner --> store : "Trying High · 6 s left", 55 %, "Ultra held 41 fps." (L2-162 AC2)
  store --> view : running face (polite live region)
end
alt A level holds the frame rate
  runner --> store : result: High, Ultra 41 fps, checked 7:31 PM
  store -> settings : set('deviceCheck', result) (L2-162 AC3)
  store --> view : "High holds 60 fps on this device."; "Auto now starts at High here."
  note right of settings : A fixed level is unchanged (L2-162 AC4)
else Stop the check, leave, or tab hidden
  actor -> view : Stop the check
  view -> store : stop()
  store -> runner : abort; dispose(); no result kept (L2-162 AC6)
end
store -> runner : dispose() after the result
@enduml
