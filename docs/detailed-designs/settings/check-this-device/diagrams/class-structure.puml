@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
hide empty members
title Class structure — Check this device
enum CheckState {
  idle
  running
  done
}
class DeviceCheckResult <<api>> {
  +level: QualityLevel
  +fps: Map<QualityLevel, number>
  +checkedAt: string
}
class TrialView {
  +level: QualityLevel
  +secondsLeft: number
  +percent: number
  +tried: Map<QualityLevel, number>
}
class DeviceCheckStore <<ride>> {
  +state: Signal<CheckState>
  +trial: Signal<TrialView | null>
  +result: Signal<DeviceCheckResult | undefined>
  +disabled: Signal<boolean>
  -abort: AbortController
  +start(): Promise<void>
  +stop(): void
}
class DeviceCheckRunner <<world>> {
  +run(backend: RendererBackend, periodMs: number, signal: AbortSignal, onTrial: (t: TrialView) => void): Promise<DeviceCheckResult>
  +dispose(): void
}
class TestWorld <<world>>
class FrameBudget <<world>> {
  +holds(medianMs: number, periodMs: number): boolean
}
class RideActivity <<ride>> {
  +riding: Signal<boolean>
}
interface RideSettingsStore <<api>> {
  +set(key: 'deviceCheck', value: DeviceCheckResult): void
}
class DeviceCheck <<components>> {
  +state: InputSignal<CheckState>
  +trial: InputSignal<TrialView | null>
  +result: InputSignal<DeviceCheckResult | undefined>
  +disabled: InputSignal<boolean>
  +start: OutputEmitterRef<void>
  +stop: OutputEmitterRef<void>
}
DeviceCheckStore --> CheckState
DeviceCheckStore --> TrialView
DeviceCheckStore ..> DeviceCheckRunner : dynamic import
DeviceCheckRunner *-- TestWorld
DeviceCheckRunner *-- FrameBudget
DeviceCheckRunner ..> DeviceCheckResult : returns
DeviceCheckStore ..> RideActivity
DeviceCheckStore ..> RideSettingsStore : RIDE_SETTINGS
DeviceCheck ..> DeviceCheckStore : bound by SettingsPage
@enduml
