@startuml
title UML sequence behaviour — Import a history file
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "Progress page" as page
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserSessionArchive" as archive
  participant "validSession" as val
  participant "SessionStore" as store
end box
box "Browser — storage" #FFF4E5
  database "IndexedDB" as idb
end box

rider -> page : Import history; pick a file
page -> archive : importFile(file)
alt file.size > 16 MB or not JSON or not {sessions:[...]} [L2-094 AC6]
  archive --> page : 'not-a-history', nothing changed
else history file
  loop each session
    archive -> val : validSession(raw)
    val --> archive : record, or null: rejected += 1
  end
  archive -> store : addMany(valid)
  store -> store : skip known ids; keep the newest 500
  store -> idb : put new sessions, delete trimmed, in 1 transaction
  store --> archive : added, skipped
  archive --> page : ImportReport(added, skipped, rejected) [L2-094 AC5]
end
page --> rider : Toast with the counts (history-view);\nProgress reloaded when rides were added
@enduml
