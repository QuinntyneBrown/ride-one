@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Keep sessions

Person(rider, "Rider", "Reviews sessions")
System_Boundary(browser, "Rider's browser") {
  Container(app, "Wattzup Web", "Angular + @wattzup/browser", "Session Summary, Progress, archive")
  ContainerDb(idb, "Wattzup database", "IndexedDB", "sessions store: newest 500")
  Container(files, "Download and file picker", "Browser UI", "Saves and opens history files")
}
Rel(rider, app, "Uses")
Rel(app, idb, "Reads at start; writes per session", "IndexedDB transactions")
Rel(app, files, "Exports Blob; reads picked File")
Rel(rider, files, "Picks a file")
@enduml
