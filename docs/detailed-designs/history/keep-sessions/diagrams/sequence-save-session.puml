@startuml
title UML sequence behaviour — Save a ride and open its summary
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "End-ride dialog" as dlg
  participant "Session Summary" as summary
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserWorkoutApi" as wapi
  participant "WorkoutEngine" as engine
  participant "SessionBuilder" as builder
  participant "SessionStore" as store
end box
box "Browser — storage" #FFF4E5
  database "IndexedDB" as idb
end box

rider -> dlg : End ride
dlg -> wapi : stop()
wapi -> engine : stop()
engine -> builder : build(samples, plan, class_id) when >= 60 s (L2-081)
builder --> engine : SessionRecord
engine -> store : add(session)
store -> idb : put session; delete beyond the newest 500 [L2-094 AC3]
alt write succeeds
  idb --> store : complete
else quota exceeded or blocked [L2-094 AC7]
  idb --> store : error
  store -> store : keep in memory until the page closes
  store --> dlg : toast "This ride could not be kept in this browser"
end
wapi --> dlg : session id
dlg -> summary : navigate /sessions/:id [L2-094 AC1]
summary --> rider : Session Summary
@enduml
