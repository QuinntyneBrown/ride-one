@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Track progress

class "progress-calculator" as ProgressCalculator <<module, @wattzup/browser>> {
  +WEEKLY_GOAL = 4
  +riddenDays(sessions, zone): Set<string>
  +streak(sessions, nowMs, zone): StreakFigures
  +weekStart(nowMs, zone): number
  +weekRides(sessions, nowMs, zone): number
  +previousAttempt(sessions, s): SessionRecord | null
  +bestsSetBy(sessions, s): string[]
  +achievements(sessions, streak): AchievementFigures[]
  +report(sessions, nowMs, zone): ProgressReport
}
class ProgressReport <<contract type>> {
  +today: string
  +streak: StreakFigures
  +ride_days: string[]
  +week: {rides, goal}
  +totals: {rides, ridden_seconds, distance_km}
  +classes: ClassAttempts[]
  +achievements: AchievementFigures[]
}
class StreakFigures {
  +current: number
  +best: number
  +rode_today: boolean
}
class ClassAttempts {
  +class_id: string
  +title: string
  +attempts: SessionSummary[]
}
class AchievementFigures {
  +id, title, detail: string
  +goal: number
  +unit: string | null
  +value: number
  +unlocked: boolean
}
class "progress-view.ts" as view <<pure>> {
  +comparableClasses(p): ClassAttempts[]
  +trendView(attempts, measure): TrendView
  +calendarOf(rideDays, today, weeks): CalendarDay[][]
  +streakView(p): StreakView
  +rideButton(streak): string
  +sessionRows(list): SessionRow[]
  +achievementViews(list): AchievementView[]
}
class ProgressPage {
  -phase: Signal<Phase>
  -classId: Signal<string | null>
  -measure: Signal<Measure>
}
class TrendChart <<component>>
class SessionList <<component>>
class StreakCalendar <<component>>
class AchievementList <<component>>

ProgressCalculator ..> ProgressReport : creates
ProgressReport *-- StreakFigures
ProgressReport *-- "0..*" ClassAttempts
ProgressReport *-- "6" AchievementFigures
ProgressPage ..> view
ProgressPage --> TrendChart
ProgressPage --> SessionList
ProgressPage --> StreakCalendar
ProgressPage --> AchievementList
@enduml
