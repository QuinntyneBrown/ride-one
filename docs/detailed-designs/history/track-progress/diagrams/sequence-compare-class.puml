@startuml
title UML sequence behaviour — Compare a class
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web" #E0F2FE
  actor "Rider" as rider
  participant "RadioGroup / tabs" as ctl
  participant "ProgressPage" as page
  participant "progress-view.ts" as view
  participant "TrendChart" as chart
  participant "Router" as router
end box

rider -> ctl : Arrow keys or tap a class radio [L2-086 AC2]
ctl -> page : classId.set(id)
page -> view : trendView(attempts of id, measure)
view --> page : TrendView
page -> chart : [view]
rider -> ctl : Arrow keys or tap a Measure tab [L2-086 AC3]
ctl -> page : measure.set(m)
page -> view : trendView(attempts, m)
page -> chart : [view]
rider -> chart : activate point <d Mon>: <value>
chart -> page : open(id)
page -> router : navigate /sessions/<id> [L2-086 AC4]
@enduml
