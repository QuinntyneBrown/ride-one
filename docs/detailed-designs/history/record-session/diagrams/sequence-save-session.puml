@startuml
title UML sequence behaviour — End a ride and save it
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web" #E0F2FE
  participant "EndRideDialog" as dlg
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserWorkoutApi" as ep
  participant "WorkoutEngine" as engine
  participant "buildSession" as builder
  participant "SessionStore" as store
  participant "BikeStateStore" as state
end box
database "IndexedDB" as db

loop each running second
  engine -> engine : totals.tick; samples.push(power, cadence) [L2-081]
end
alt rider presses End ride
  dlg -> ep : stop()
  ep -> engine : stop()
  engine -> engine : status = stopped
else plan reaches its end
  engine -> engine : status = ended
else bike off for 90 s
  engine -> engine : status = ended: bike shut off [L2-058]
end
engine -> engine : finish(run); clear the ride journal
alt samples >= 60
  engine -> builder : buildSession(samples, segments, totals, origin, now, id)
  builder --> engine : SessionRecord (dips, on target, best minute, traces)
  engine -> engine : run.sessionId = id
  engine -> store : add(session) [L2-094 AC3: newest 500]
  store -> db : put session, delete trimmed, one transaction [L2-082 AC1]
  alt write fails
    store --> engine : rejects; the session stays in memory [L2-094 AC7]
  end
else under a minute
  engine -> engine : no session [L2-081 AC2]
end
engine -> state : publish(workout.session_id) [L2-014]
ep --> dlg : session_id [L2-081 AC8]
@enduml
