@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Record a session

class SessionRecord <<contract type>> {
  +id: string
  +ended_at: string
  +class_id: string | null
  +title: string
  +plan: WorkoutPlan
  +segments: Segment[]
  +planned_seconds: number
  +ridden_seconds: number
  +completed: boolean
  +avg_power: number
  +max_power: number
  +best_minute_power: number
  +avg_cadence: number
  +distance_km: number
  +kcal: number
  +on_target_pct: number
  +dips: Dip[]
  +power_trace: number[]
  +cadence_trace: number[]
}
class Dip {
  +start: number
  +duration: number
  +target: number
  +low: number
  +kind: SegmentKind
  +round: number | null
}
class SessionSummary {
  +id, ended_at, class_id, title
  +ridden_seconds, planned_seconds, completed
  +avg_power, on_target_pct, dip_count
}
class RideSample {
  +power: number
  +cadence: number
}
class SessionInput {
  +id: string
  +endedAt: string
  +classId: string | null
  +title: string
  +plan: WorkoutPlan
  +segments: Segment[]
  +samples: RideSample[]
  +totals: RideTotals
}
class "session-builder" as SessionBuilder <<module>> {
  +MINIMUM_SECONDS = 60
  +MINIMUM_DIP_SECONDS = 6
  +buildSession(input): SessionRecord
  +dipTolerance(kind): number | null
}
class "session-record" as SessionRecordFns <<module>> {
  +toSummary(record): SessionSummary
}
class SessionStore <<lib/storage>> {
  +MAX_SESSIONS = 500
  +newId(): string
  +add(session): Promise<void>
}
class RideOrigin {
  +classId: string
  +title: string
}
class WorkoutRun {
  +samples: RideSample[]
  +origin: RideOrigin | null
  +sessionId: string | null
}
class WorkoutEngine {
  +startWorkout(plan, origin)
  +stop()
  -finish(run)
}

SessionRecord *-- "0..*" Dip
SessionRecordFns ..> SessionSummary : creates
SessionInput o-- "0..*" RideSample
SessionBuilder ..> SessionInput : reads
SessionBuilder ..> SessionRecord : creates
SessionStore o-- "0..500" SessionRecord
WorkoutEngine --> WorkoutRun : owns one
WorkoutRun o-- "0..*" RideSample
WorkoutRun --> RideOrigin
WorkoutEngine ..> SessionBuilder
WorkoutEngine --> SessionStore
@enduml
