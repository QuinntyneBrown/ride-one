@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Record a session

Container_Boundary(app, "Wattzup Web") {
  Component(workouts, "BrowserWorkoutApi", "WORKOUT_API, @wattzup/browser", "start(plan + class_id), stop()")
  Component(classes, "BrowserClassApi", "CLASS_API", "Class titles for class_id")
  Component(engine, "WorkoutEngine", "lib/engine", "Ticks the run; keeps a RideSample per running second")
  Component(builder, "buildSession", "lib/engine, pure", "Dips, on target, best minute, traces")
  Component(store, "SessionStore", "lib/storage", "Sessions newest first, capped at 500 (history/keep-sessions)")
  Component(state, "BikeStateStore", "lib/engine", "Publishes workout.session_id")
}
ContainerDb(db, "IndexedDB", "Database wattzup", "Store sessions")

Rel(workouts, classes, "find(class_id)")
Rel(workouts, engine, "startWorkout(plan, origin), stop()")
Rel(engine, builder, "buildSession(input) when the run ends")
Rel(engine, store, "add(session)")
Rel(engine, state, "Publishes the snapshot with session_id")
Rel(store, db, "Writes in one transaction")
@enduml
