@startuml
title UML sequence behaviour — Load the sessions at start
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Backend — Wattzup API application" #D1FADF
  participant "Host" as host
  participant "SessionFileService" as svc
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "SessionFile" as io
  participant "SessionStore" as store
end box
box "Backend — Infrastructure" #FFF4E5
  database "sessions.json" as file
  participant "ILogger" as log
end box

host -> svc : StartAsync
svc -> io : Read(Wattzup:Sessions:Path) [L2-082 AC1]
io -> file : Open
alt file missing
  io --> svc : no sessions [L2-082 AC5]
  svc -> store : Load([])
else over 16 MB, not JSON or not a sessions file
  io --> svc : Error
  svc -> io : SetAside: rename to sessions.json.unreadable [L2-082 AC6]
  svc -> log : Error: path and reason, once
  svc -> store : Load([])
else valid
  io --> svc : sessions, newest first
  svc -> store : Load(sessions) [L2-082 AC2]
end
svc -> store : Subscribe to Saved
svc --> host : Started; the backend starts either way
@enduml
