@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Review a session

class SessionDetail <<generated>> {
  +id, ended_at, class_id, title
  +plan, segments
  +planned_seconds, ridden_seconds, completed
  +avg_power, max_power, best_minute_power, avg_cadence
  +distance_km, kcal, on_target_pct
  +dips: Dip[]
  +power_trace: number[]
  +cadence_trace: number[]
  +previous: SessionSummary | null
  +bests: string[]
}
class SessionApi <<interface>> {
  +list(): Promise<SessionSummary[]>
  +get(id): Promise<SessionDetail | 'not-found'>
  +progress(): Promise<Progress>
}
class "session-view.ts" as view <<pure>> {
  +dateLine(endedAt, justFinished): string
  +deltaOf(s): Delta | null
  +endedEarly(s): string | null
  +dipListView(s): DipListView
  +tracesView(s): TracesView
  +totals(s): Stat[]
  +weekLine(week): WeekLine
}
class TracesView {
  +total: number
  +cadencePoints: string
  +powerPoints: string
  +powerMax: number
  +aims: Aim[]
  +bands: Band[]
  +work: Band[]
  +ticks: Tick[]
  +label: string
}
class DipListView {
  +onTarget: string
  +lead: string | null
  +rows: DipRow[]
  +empty: string | null
}
class SessionPage {
  -phase: Signal<Phase>
  -session: Signal<SessionDetail>
  -progress: Signal<Progress>
  -focusDip: Signal<number | null>
  -justFinished: boolean
}
class SessionTraces <<component>> {
  +view: TracesView
  +focusDip: number | null
}
class DipList <<component>> {
  +view: DipListView
  +focusDip: output<number | null>
}
class WeekStrip <<component>> {
  +days: CalendarDay[]
}
class StatStrip <<component>> {
  +stats: Stat[]
}

SessionPage --> SessionApi : SESSION_API
SessionPage ..> view
view ..> SessionDetail
view ..> TracesView : creates
view ..> DipListView : creates
SessionPage --> SessionTraces
SessionPage --> DipList
SessionPage --> WeekStrip
SessionPage --> StatStrip
@enduml
