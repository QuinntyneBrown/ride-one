@startuml
title UML sequence behaviour — Focus a cadence dip
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web" #E0F2FE
  actor "Rider" as rider
  participant "DipList" as list
  participant "SessionPage" as page
  participant "SessionTraces" as traces
end box

rider -> list : hover or Tab to dip row i
list -> page : focusDip.emit(i)
page -> page : focusDip.set(i)
page -> traces : [focusDip] = i
traces -> traces : band i --focus, others dimmed [L2-085 AC10]
rider -> list : leave or blur
list -> page : focusDip.emit(null)
page -> traces : [focusDip] = null
traces -> traces : every band back to normal
@enduml
