@startuml
title UML sequence behaviour — End a ride and open its summary
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web" #E0F2FE
  participant "EndRideDialog" as dlg
  participant "Router" as router
  participant "SessionPage" as page
  participant "session-view.ts" as view
end box
box "Backend — Wattzup API application" #D1FADF
  participant "WorkoutEndpoints" as wep
  participant "SessionEndpoints" as sep
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "SessionStore" as store
  participant "ProgressCalculator" as calc
end box

dlg -> wep : POST /api/workout/stop
wep --> dlg : {stopped: true, session_id}
alt bike and session_id set
  dlg -> router : navigate /sessions/<id>, state justFinished [L2-084 AC1]
else bike, no session
  dlg -> router : navigate /classes
else treadmill
  dlg -> router : navigate /setup [L2-084 AC4]
end
router -> page : create (lazy)
page -> page : phase = loading, skeletons [L2-085 AC12]
par
  page -> sep : GET /api/sessions/<id>
  sep -> store : Find(id)
  alt unknown id
    sep --> page : 404 session_not_found
    page -> page : phase = not-found
  else found
    sep -> calc : PreviousAttempt, BestsSetBy [L2-087]
    sep --> page : SessionDetail
  end
else
  page -> sep : GET /api/progress
  sep -> calc : Report(sessions, now)
  sep --> page : Progress
end
page -> view : dateLine, deltaOf, dipListView, tracesView, totals, weekLine
view --> page : views
page -> page : phase = ready [L2-085 AC1 to AC11]
@enduml
