@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Review a session

Person(rider, "Rider", "Rides and watches")
System_Boundary(browser, "Rider's browser (Chrome or Edge)") {
  Container(app, "Wattzup Web", "Angular + @wattzup/browser", "Session Summary page; sessions kept in the browser")
  ContainerDb(db, "IndexedDB", "Database wattzup", "Sessions and the ride journal")
}

Rel(rider, app, "Uses")
Rel(app, db, "Reads and writes")
@enduml
