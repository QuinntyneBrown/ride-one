@startuml
title UML sequence behaviour — Report the rider's output
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "ClassRideStore" as store
  participant "ProgressReporter" as reporter
end box
box "Frontend — Ride app (api, domain and video libraries)" #E0F2FE
  participant "SignalRRideHubClient" as hub
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RideHub" as rhub
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "ReportProgressCommandHandler" as handler
  participant "ISessionRegistry" as session
end box
loop at most twice a second while the session runs L2-123 AC1
  store -> store : outputKj += power ÷ 1000 each running second (L2-023 AC5)
  reporter -> store : Read outputKj and power
  store --> reporter : 61.4 kJ, 108 W
  reporter -> hub : reportProgress(sessionId, 61.4 kJ, 108 W)
  hub -> rhub : ReportProgress
  rhub -> handler : Send ReportProgressCommand
  handler -> session : RecordProgress(rider, 61.4, 108)
  session --> handler : Recorded
  handler --> rhub : Done
end
@enduml
