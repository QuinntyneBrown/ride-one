@startuml
set separator none
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Ride with a group

package "api library" {
  interface RideHubClient {
    +standings: Signal<StandingsDto>
    +reportProgress(report: ProgressReport): Promise<void>
  }
  class ProgressReport {
    +sessionId: string
    +outputKj: number
    +powerW: number
  }
  class StandingsDto {
    +sessionId: string
    +rows: StandingRowDto[]
  }
  class StandingRowDto {
    +riderId: string
    +displayName: string
    +jersey: string
    +level: number
    +kind: RiderKind
    +position: number
    +gap: string
    +outputKj: number
  }
  enum RiderKind {
    Person
    Bot
  }
}
package "ride application" {
  class GroupBoardStore {
    -maxRows = 10
    -lastReorderMs: number
    +rows: Signal<BoardRowView[]>
    +place: Signal<string>
    +apply(standings: StandingsDto): void
  }
  class BoardRowView {
    +riderId: string
    +name: string
    +jersey: string
    +outputKj: number
    +isSelf: boolean
  }
  class ClassRideStore {
    +outputKj: Signal<number>
    +power: Signal<number>
  }
  class ProgressReporter {
    -maxPerSecond = 2
    +start(sessionId: string): void
  }
  class LiveSessionStore {
    +sessionId: Signal<string>
    +standings: Signal<StandingsDto>
  }
}
package "Telo.Ride.Domain" {
  class RankingPolicy {
    +Rank(session: GroupClassSession): IReadOnlyList<Standing>
  }
}
StandingsDto "1" *-- "1..10" StandingRowDto
StandingRowDto --> RiderKind
GroupBoardStore ..> LiveSessionStore : reads standings
LiveSessionStore ..> RideHubClient : subscribes
GroupBoardStore "1" *-- "0..10" BoardRowView
ProgressReporter ..> ClassRideStore : reads
ProgressReporter ..> RideHubClient : reports
RideHubClient ..> ProgressReport
RideHubClient ..> StandingsDto
@enduml
