@startuml
title UML sequence behaviour — Update the output board
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "ClassBoard" as board
  participant "GroupBoardStore" as bstore
  participant "LiveSessionStore" as live
end box
box "Frontend — Ride app (api, domain and video libraries)" #E0F2FE
  participant "SignalRRideHubClient" as hub
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "SessionTicker" as bc
  participant "RideHub" as rhub
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "ISessionRegistry" as registry
  participant "RankingPolicy" as session
end box
loop once a second
  bc -> registry : Live sessions
  registry --> bc : Session with nine riders
  bc -> session : Rank by output, highest first (L2-123 AC2)
  session --> bc : Nine standings
  bc -> rhub : Send StandingsUpdated to session group
  rhub -> hub : StandingsUpdated(standings)
  hub --> live : standings
  live --> bstore : standings signal
  alt at least 1 s since the last reorder L2-090 AC2
    bstore -> bstore : Replace rows (max 10), mark own row
  else
    bstore -> bstore : Update outputs in place, keep order
  end
  bstore --> board : rows, place "5th / 9"
  board -> board : Slide moved rows over 150 ms (none with reduced motion)
  board --> rider : "Output" board with own row aria-current="true" L2-090 AC1
end
@enduml
