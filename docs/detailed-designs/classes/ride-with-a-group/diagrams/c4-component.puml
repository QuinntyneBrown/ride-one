@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Ride with a group

Container_Boundary(app, "Ride app") {
  Component(page, "ClassRidePage", "Angular page · ride", "Places the board")
  Component(ride, "ClassRideStore", "Signal store · ride", "Output and power")
  Component(reporter, "ProgressReporter", "Service · ride", "At most 2 reports per second")
  Component(live, "LiveSessionStore", "Signal store · ride", "Live session state")
  Component(boardStore, "GroupBoardStore", "Signal store · ride", "Bounded rows, 1 Hz reorder")
  Component(board, "ClassBoard", "Presentation component · components", "Output board")
  Component(row, "ClassBoardRow", "Presentation component · components", "One rider")
  Component(hub, "SignalRRideHubClient", "Hub client · api", "RIDE_HUB_CLIENT")
}
Container_Boundary(backend, "Telo Ride API") {
  Component(rhub, "RideHub", "SignalR hub · Telo.Ride.Api", "/hubs/ride")
  Component(report, "ReportProgressCommandHandler", "MediatR handler · Telo.Ride.Application", "Stores progress")
  Component(registry, "ISessionRegistry", "Session state · Telo.Ride.Application", "Live sessions")
  Component(ticker, "SessionTicker", "Hosted service · Telo.Ride.Api", "Each second: bots, rank, send")
  Component(ranking, "RankingPolicy", "Domain service · Telo.Ride.Domain", "Class by output")
}
Rel(page, boardStore, "Reads rows")
Rel(page, board, "Renders")
Rel(board, row, "Renders")
Rel(reporter, ride, "Reads output and power")
Rel(reporter, hub, "reportProgress")
Rel(boardStore, live, "standings")
Rel(live, hub, "StandingsUpdated")
Rel(hub, rhub, "ReportProgress / StandingsUpdated", "SignalR")
Rel(rhub, report, "Sends ReportProgressCommand")
Rel(report, registry, "Updates output")
Rel(ticker, registry, "Reads sessions")
Rel(ticker, ranking, "Ranks")
Rel(ticker, rhub, "Sends StandingsUpdated to group")
@enduml
