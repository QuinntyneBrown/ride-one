@startuml
title UML sequence behaviour — Open a class
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "bikeOnly" as guard
  participant "ClassPage" as page
  participant "class-draft.ts" as draft
  participant "ride-preview.ts" as preview
  participant "YOUTUBE_PLAYER" as player
  participant "CLASS_API" as client
end box
box "Backend — Wattzup API application" #D1FADF
  participant "ClassEndpoints" as ep
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "ClassCatalogueStore" as store
end box

rider -> guard : Open /classes/30-minute-hiit-cardio
alt machine is treadmill
  guard --> rider : Redirect to /setup [L2-080 AC14]
else bike
  guard -> page : Activate
  page --> rider : Skeleton [L2-080 AC13]
  page -> client : get(id)
  client -> ep : GET /api/classes/{id}
  ep -> store : Find(id)
  alt not in the catalogue
    store --> ep : null
    ep --> client : 404 class_not_found [L2-078 AC4]
    client --> page : 'not-found'
    page --> rider : We can't find that class, All classes, Build your own ride [L2-080 AC13]
  else found
    store --> ep : ClassEntry
    ep --> client : 200 class, plan.video {video_id, start_seconds} [L2-078 AC3]
    client --> page : ClassEntry
    page -> draft : draftOf(entry)
    draft --> page : ClassDraft {plan, url, start}
    page -> preview : previewOf(plan)
    preview --> page : total, structure, avg power
    page --> rider : All classes, chips, title, description [L2-080 AC1]
    alt plan has a video
      page -> player : create(host, video_id, start_seconds)
      player --> page : PlayerHandle, cued
      page --> rider : Preview, Cued at 0:03.0, the ride's 0:00; link filled [L2-080 AC2]
    else no video
      page --> rider : Paste this ride's YouTube link below…; empty link [L2-080 AC3]
    end
    page --> rider : The plan card and the level rows [L2-080 AC6, AC7, AC8]
  end
end
@enduml
