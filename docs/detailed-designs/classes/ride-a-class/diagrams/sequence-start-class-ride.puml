@startuml
title UML sequence behaviour — Start a class ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "ClassPage" as page
  participant "LiveStateService" as live
  participant "ReplaceRideDialog" as dialog
  participant "class-draft.ts" as draft
  participant "WORKOUT_API" as client
end box
box "Backend — Wattzup API application" #D1FADF
  participant "WorkoutEndpoints" as ep
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "WorkoutPlanValidator" as val
  participant "WorkoutEngine" as engine
end box

rider -> page : Start ride
page -> live : state().workout
alt a workout is active
  live --> page : running
  page -> dialog : open [L2-052]
  alt Keep riding
    dialog --> page : cancelled
    page --> rider : Nothing started
  else Replace
    dialog --> page : confirmed
  end
else none
  live --> page : null
end
page -> draft : toStartRequest(draft)
draft --> page : plan as shown + video {url, start_seconds} or null [L2-080 AC10]
page --> rider : Starting…, disabled [L2-080 AC10]
page -> client : start(plan)
client -> ep : POST /api/workout
ep -> val : Validate(body, Bike) [L2-010]
alt accepted
  val --> ep : plan with RideVideo
  ep -> engine : Start(plan)
  engine --> ep : WorkoutSnapshot
  ep --> client : 200
  client --> page : started
  page --> rider : Navigate to /; the video plays in sync (workouts/ride-along-video) [L2-076]
else rejected or no answer
  ep --> client : 400 ProblemDetails or network error
  client --> page : error
  page --> rider : Couldn't start the ride… Try again; every value kept [L2-080 AC11]
end
@enduml
