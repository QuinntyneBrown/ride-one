@startuml
title UML sequence behaviour — Start a class ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "ClassPage" as page
  participant "LiveStateService" as live
  participant "ReplaceRideDialog" as dialog
  participant "class-draft.ts" as draft
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserWorkoutApi (WORKOUT_API)" as ep
  participant "validatePlan" as val
  participant "WorkoutEngine" as engine
end box

rider -> page : Start ride
page -> live : state().workout
alt a workout is active
  live --> page : running
  page -> dialog : open [L2-052]
  alt Keep riding
    dialog --> page : cancelled
    page --> rider : Nothing started
  else Replace
    dialog --> page : confirmed
  end
else none
  live --> page : null
end
page -> draft : toStartRequest(draft)
draft --> page : plan as shown + video {url, start_seconds} or null [L2-080 AC10]
page --> rider : Starting…, disabled [L2-080 AC10]
page -> ep : start(plan)
ep -> val : validatePlan(body) [L2-010]
alt accepted
  val --> ep : plan with video {video_id, start_seconds}
  ep -> engine : startWorkout(plan, class origin)
  engine --> ep : WorkoutSnapshot
  ep --> page : started
  page --> rider : Navigate to /; the video plays in sync (workouts/ride-along-video) [L2-076]
else refused or failed
  ep --> page : ContractError invalid_workout, or another error
  page --> rider : Couldn't start the ride… Try again; every value kept [L2-080 AC11]
end
@enduml
