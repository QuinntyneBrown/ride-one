@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Ride a class

Person(rider, "Rider", "Rides the bike and watches Wattzup")
System(wattzup, "Wattzup", "Angular app running in Chrome or Edge; no server")
System_Ext(bike, "Echelon bike", "Indoor bike exposing a proprietary BLE GATT service")
System_Ext(youtube, "YouTube", "Player and thumbnails")

Rel(rider, wattzup, "Uses", "Browser")
Rel(wattzup, bike, "Notifications and commands", "Web Bluetooth GATT")
Rel(wattzup, youtube, "Embeds the player; loads covers", "HTTPS")
@enduml
