@startuml
title UML sequence behaviour — Adjust the levels, then reset
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "LevelRow" as row
  participant "ClassPage" as page
  participant "class-draft.ts" as draft
  participant "video-link.ts" as link
  participant "ride-preview.ts" as preview
  participant "YOUTUBE_PLAYER" as player
end box

rider -> row : Raise work resistance
row -> page : step(+1)
page -> draft : shiftLevels(plan, Work, +1)
draft --> page : Every effort 24 → 25, within 1–32; warm-up and cool-down unchanged [L2-080 AC7]
page -> preview : previewOf(plan)
preview --> page : ~ W updated
page -> draft : isEdited(draft, entry)
draft --> page : true
page --> rider : Work 25 / 32 announced; plan card updated; Reset to class shown [L2-080 AC7, AC9, AC15]
rider -> page : Half a second later
page -> link : stepStart(12.0, +1)
link --> page : 12.5
page -> player : seek(12.5)
page --> rider : Ride starts at 0:12.5 [L2-080 AC5]
rider -> page : Paste https://vimeo.com/76979871
page -> link : videoIdOf(url)
link --> page : null
page --> rider : That doesn't look like a YouTube link… aria-invalid; preview hidden [L2-080 AC4]
rider -> page : Reset to class
page -> draft : draftOf(entry)
draft --> page : The class's plan, link and start
page -> player : create(host, video_id, start_seconds)
page --> rider : Every value back; Reset to class hidden [L2-080 AC9]
@enduml
