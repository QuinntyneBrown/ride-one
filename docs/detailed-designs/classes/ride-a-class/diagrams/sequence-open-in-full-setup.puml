@startuml
title UML sequence behaviour — Open a class in full setup
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "ClassPage" as page
  participant "class-draft.ts" as draft
  participant "PlanDraftStore" as store
  participant "Router" as router
  participant "SetupPage" as setup
end box

rider -> page : Change intervals in full setup
page -> draft : toSetupDrafts(draft)
draft --> page : PlanDraft {mode = class kind}, IntervalsDraft for intervals, VideoDraft
page -> store : save(planDraft) — replaces the saved draft [L2-080 AC12]
opt intervals class
  page -> store : saveIntervals(intervalsDraft)
end
page -> store : saveVideo({on, url, start})
page -> router : navigate /setup
router -> setup : Activate
setup -> store : load(), loadIntervals(), loadVideo()
store --> setup : The class's drafts
setup --> rider : Set up your ride in the class's mode, with its plan and video [L2-080 AC12]
@enduml
