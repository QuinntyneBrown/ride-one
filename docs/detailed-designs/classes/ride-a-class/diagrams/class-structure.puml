@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Ride a class

class ClassEntry <<generated>> {
  +id: string
  +title: string
  +channel: string
  +focus: string
  +description: string
  +shelf: ShelfRef
  +plan: WorkoutPlan
}
class ClassDraft {
  +plan: WorkoutPlan
  +url: string
  +start: number
}
class LevelRowView {
  +name: 'Work' | 'Recover' | 'Steady'
  +level: number
  +canLower: boolean
  +canRaise: boolean
}
class "class-draft.ts" as cd <<pure>> {
  +draftOf(entry): ClassDraft
  +levelRows(plan): LevelRowView[]
  +shiftLevels(plan, row, dir): WorkoutPlan
  +isEdited(draft, entry): boolean
  +structureLine(plan): string
  +cadenceLine(plan): string
  +stretchLine(plan): string
  +toStartRequest(draft): StartPlan
  +toSetupDrafts(draft): SetupDrafts
}
class SetupDrafts {
  +plan: PlanDraft
  +intervals: IntervalsDraft | null
  +video: VideoDraft
}
class ClassPage {
  -entry: Signal<ClassEntry | 'not-found' | null>
  -draft: Signal<ClassDraft>
  -phase: Signal<'idle' | 'starting' | 'failed'>
  +step(row, dir): void
  +reset(): void
  +start(): Promise<void>
  +openFullSetup(): void
}
class LevelRow <<component>> {
  +name: input
  +level: input
  +canLower: input
  +canRaise: input
  +step: output<-1 | 1>
}
interface ClassApi {
  +get(id): Promise<ClassEntry | 'not-found'>
}
interface WorkoutApi {
  +start(plan: StartPlan): Promise<void>
}
class PlanDraftStore {
  +save(draft: PlanDraft): void
  +saveIntervals(draft: IntervalsDraft): void
  +saveVideo(draft: VideoDraft): void
}
interface YouTubePlayer {
  +create(host, videoId, startSeconds): Promise<PlayerHandle>
}
class "video-link.ts" as vl <<pure>> {
  +videoIdOf(url): string | null
  +stepStart(seconds, dir): number
  +formatStart(seconds): string
}
class "ride-preview.ts" as rp <<pure>> {
  +previewOf(plan): BikeRidePreview
}

cd ..> ClassDraft : builds and changes
cd ..> LevelRowView : returns
cd ..> SetupDrafts : returns
cd ..> vl : validates links with
ClassDraft ..> ClassEntry : built from
ClassPage --> ClassDraft : holds
ClassPage ..> cd : applies
ClassPage ..> rp : plan card
ClassPage "1" *-- "1..2" LevelRow : renders
ClassPage ..> ClassApi : CLASS_API
ClassPage ..> WorkoutApi : WORKOUT_API
ClassPage ..> PlanDraftStore : full setup
ClassPage ..> YouTubePlayer : YOUTUBE_PLAYER
@enduml
