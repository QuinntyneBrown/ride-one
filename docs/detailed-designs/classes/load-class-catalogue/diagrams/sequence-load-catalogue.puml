@startuml
title UML sequence behaviour — Open the class library
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "Class library page" as page
  participant "Service worker" as sw
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserClassApi" as api
  participant "readCatalogue" as reader
end box
box "Hosting — Static host" #FFF4E5
  participant "classes.json" as file
end box

rider -> page : Open /classes
page -> api : list()
api -> sw : fetch('classes.json', no-cache) (first call only)
alt online
  sw -> file : GET
  file --> sw : 200 text
else offline
  sw -> sw : last cached copy
end
sw --> api : response
alt 404, network error, over 1 MB or not a catalogue [L2-096 AC3]
  api -> api : console.error('classes.json: <reason>')
  api --> page : empty catalogue
  page --> rider : Empty state; Set up a ride still offered
else catalogue
  api -> reader : readCatalogue(text)
  reader --> api : kept shelves and classes, problems [L2-096 AC2]
  api -> api : console.warn per problem (class id and field)
  api --> page : ClassCatalogue
  page --> rider : Shelves with covers from i.ytimg.com
end
@enduml
