@startuml
title UML sequence behaviour — Reload the catalogue after a save
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Owner" as owner
box "Backend — Infrastructure" #FFF4E5
  database "classes.json" as file
  participant "PhysicalFileProvider" as fp
  participant "TimeProvider" as time
end box
box "Backend — Wattzup API application" #D1FADF
  participant "ClassCatalogueService" as svc
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "ClassCatalogueReader" as reader
  participant "ClassCatalogueStore" as store
  participant "WorkoutEngine" as engine
end box

owner -> file : Save an edited catalogue
file -> fp : Change detected
fp -> svc : Change token fires
svc -> time : Start 500 ms debounce (restarted by each further change)
time --> svc : Debounce elapsed
svc -> reader : Read(stream, length)
alt valid as a whole
  reader --> svc : Catalogue + problems
  svc -> store : Replace(new catalogue) within 2 s of the save [L2-077 AC7]
else invalid as a whole
  reader --> svc : FileError
  svc -> svc : Keep the last valid catalogue; log the error [L2-077 AC7]
end
note over engine : A ride in progress never reads the catalogue,\nso a reload does not affect it [L2-077 AC7]
svc -> fp : Re-arm the change token
@enduml
