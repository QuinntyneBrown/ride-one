@startuml
title UML sequence behaviour — Browse the class library
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "ClassLibraryPage" as page
  participant "class-library-view.ts" as view
  participant "ClassCard" as card
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserClassApi (CLASS_API)" as client
end box
participant "Static host" as ep
participant "i.ytimg.com" as yt

rider -> page : Open /classes
  page --> rider : Skeletons, tabs disabled [L2-079 AC8]
  page -> client : list()
  opt first call on this page load
    client -> ep : fetch classes.json (no-cache)
    ep --> client : file; read and validated (classes/load-class-catalogue)
  end
  client -> client : shelves in file order [L2-078 AC1]
  alt call failed
    client --> page : error
    page --> rider : Couldn't load the classes, Try again [L2-079 AC10]
  else shelves empty
    client --> page : {shelves:[]}
    page --> rider : No classes yet, Build your own ride [L2-079 AC9]
  else shelves
    client --> page : catalogue
    page -> view : visibleShelves(catalogue, all); cardView(entry) for each
    view --> page : ClassCardView: length, Peak L<n>, strip, cover or null [L2-079 AC5]
    page --> rider : Tabs All + one per shelf; shelves with n classes [L2-079 AC2, AC4]
    card -> yt : GET /vi/<video_id>/mqdefault.jpg, lazy [L2-079 AC6]
    alt image loads
      yt --> card : Thumbnail in the 16:9 cover
    else image fails or no video
      card --> page : coverFailed
      page --> rider : Poster, Video link not set when no video [L2-079 AC6, AC7]
    end
    rider -> page : Arrow keys to the 30 min tab [L2-079 AC2]
    page -> view : visibleShelves(catalogue, 30-min)
    page --> rider : Only that shelf [L2-079 AC3]
    rider -> card : Open a card
    card --> rider : Navigate to /classes/<id> (classes/ride-a-class)
  end
@enduml
