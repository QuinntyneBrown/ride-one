@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Browse the class library

package "@wattzup/api" {
  interface ClassShelf {
    +id: string
    +title: string
    +tagline: string
    +classes: ClassEntry[]
  }
  interface ClassEntry {
    +id: string
    +title: string
    +channel: string
    +focus: string
    +description: string
    +shelf: {id, title, tagline}
    +plan: WorkoutPlan
  }
  interface ClassCatalogue {
    +shelves: ClassShelf[]
  }
}
package "@wattzup/api contract" {
  interface ClassApi {
    +list(): Promise<ClassCatalogue>
    +get(id: string): Promise<ClassEntry | 'not-found'>
  }
}
package "@wattzup/browser" {
  class BrowserClassApi
}
package "wattzup app" {
  class ClassCardView {
    +href: string
    +cover: string | null
    +length: string
    +title: string
    +meta: string
    +profile: ProfileBar[]
    +profileTotal: number
    +profileLabel: string
  }
  class "class-library-view.ts" as clv <<pure>> {
    +cardView(entry): ClassCardView
    +visibleShelves(catalogue, tab): ClassShelf[]
    +countLabel(n): string
    +thumbnailUrl(videoId): string | null
  }
  class ClassLibraryPage {
    -phase: Signal<'loading' | 'ready' | 'empty' | 'error'>
    -tab: Signal<'all' | string>
    +retry(): void
  }
}

ClassCatalogue "1" *-- "*" ClassShelf
ClassShelf "1" *-- "*" ClassEntry
BrowserClassApi ..|> ClassApi
ClassLibraryPage ..> ClassApi : CLASS_API
ClassLibraryPage ..> clv : maps with
clv ..> ClassCardView : builds
@enduml
