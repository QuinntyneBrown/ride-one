@startuml
title UML sequence behaviour — Open the class library from the Ride Dashboard
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "RidePage" as ride
  participant "AppBar" as bar
  participant "Router" as router
  participant "ClassLibraryPage" as page
  participant "LiveStateService" as live
end box
box "Backend — Wattzup API application" #D1FADF
  participant "ClassEndpoints" as ep
  participant "WorkoutEngine" as engine
end box

note over engine : A workout is running or paused
ride -> bar : machine = bike
bar --> rider : Library link after the lockup [L2-079 AC15]
rider -> bar : Tap, click, or Enter on Library
bar -> router : routerLink /classes
router -> ride : Destroy
router -> page : Activate
note right of bar : No POST to /api/workout… is sent;\nthe workout is untouched [L2-079 AC15]
page -> ep : GET /api/classes
ep --> page : 200 {shelves:[…]}
page --> rider : Ride a class [L2-079 AC1]
live -> live : Event stream stays open (root service)
engine -> engine : Keeps ticking
rider -> page : Browser Back
page -> router : Navigate to /
router -> ride : Activate
live --> ride : Current state, workout still in progress
ride --> rider : Dashboard with the same workout
@enduml
