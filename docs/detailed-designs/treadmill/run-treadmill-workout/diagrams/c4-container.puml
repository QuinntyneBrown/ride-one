@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Run a treadmill workout

Person(rider, "Rider", "Runs on the treadmill")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "Setup form, ride dashboard, speed and incline controls")
  Container(api, "Wattzup API", "ASP.NET Core (.NET LTS)", "Plan validation, workout engine; includes Wattzup.Core and Wattzup.Protocol")
}
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")
System_Ext(treadmill, "Echelon treadmill", "Echelon BLE GATT service")

Rel(rider, web, "Uses", "Browser")
Rel(web, api, "POST /api/workout, /api/speed, /api/incline, back-to-plan", "JSON/HTTP")
Rel(api, web, "Pushes workout, target_speed, target_incline, distance_km", "SSE")
Rel(api, os, "Writes B2 set-speed and B1 set-incline", "IBikeTransport")
Rel(os, treadmill, "D3 and D2 reports; B1 and B2 commands", "BLE GATT")
@enduml
