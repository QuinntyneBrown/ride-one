@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
title Workout status on the treadmill — state machine
state "waiting for bike" as Waiting
state "starting belt" as Starting
state "running" as Running
state "paused" as Paused
state "paused: belt stopped" as BeltStopped
state "paused: bike disconnected" as Disconnected
state "ended" as Ended
state "ended: bike shut off" as ShutOff
state "stopped" as Stopped

[*] --> Waiting : start (treadmill not connected)
[*] --> Starting : start (treadmill connected, belt not running)
Waiting --> Starting : treadmill connects [L2-066 AC9]
Starting --> Running : speed > 0 reported [L2-066 AC3]
Starting --> BeltStopped : 10 s without speed > 0 [L2-066 AC4]
Running --> BeltStopped : speed 0 reported (console or safety key) [L2-066 AC7]
Running --> Paused : pause / stop-belt
Starting --> Paused : pause / stop-belt
Paused --> Starting : resume, belt not running
Paused --> Running : resume, belt running [L2-066 AC5]
BeltStopped --> Starting : resume
Running --> Disconnected : treadmill disconnects
Starting --> Disconnected : treadmill disconnects (ride started)
Starting --> Waiting : treadmill disconnects (ride not started)
Paused --> Disconnected : treadmill disconnects
BeltStopped --> Disconnected : treadmill disconnects
Disconnected --> Paused : reconnect within 90 s [L2-066 AC8]
Disconnected --> ShutOff : disconnected > 90 s [L2-013]
Running --> Ended : elapsed = total / stop-belt
Waiting --> Stopped : stop
Starting --> Stopped : stop / stop-belt
Running --> Stopped : stop / stop-belt
Paused --> Stopped : stop / stop-belt
BeltStopped --> Stopped : stop / stop-belt
Disconnected --> Stopped : stop
Ended --> [*]
ShutOff --> [*]
Stopped --> [*]
@enduml
