@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Run a treadmill workout

Person(rider, "Rider", "Runs on the treadmill and watches the dashboard")
System(wattzup, "Wattzup", "Live telemetry and interval workouts for an Echelon bike or treadmill")
System_Ext(treadmill, "Echelon treadmill", "Stride treadmill exposing the Echelon BLE GATT service")
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")

Rel(rider, wattzup, "Starts a plan and overrides speed or incline in", "Browser")
Rel(wattzup, os, "Writes set-speed and set-incline through")
Rel(os, treadmill, "Exchanges speed and incline reports and commands with", "BLE GATT")
@enduml
