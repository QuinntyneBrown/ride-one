@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Run a treadmill workout

enum Machine {
  Bike
  Treadmill
}

abstract class WorkoutPlan <<record>>

class HiitPlan <<record>> {
  +int Rounds
  +int WorkSeconds
  +int RestSeconds
  +int? WorkLevel
  +int? RestLevel
  +double? WorkSpeed
  +double? RestSpeed
  +int? WorkIncline
  +int? RestIncline
  +bool Warmup
  +bool Cooldown
}

class FlatPlan <<record>> {
  +int Minutes
  +int? Level
  +int? Cadence
  +double? Speed
  +int? Incline
}

class Segment <<record>> {
  +SegmentKind Kind
  +int Start
  +int Duration
  +int? Level
  +int? Cadence
  +int? Round
  +double? Speed
  +int? Incline
}

class WorkoutPlanValidator <<static>> {
  +Validate(body: JsonElement, machine: Machine): PlanValidationResult
}

class PlanExpander <<static>> {
  +Expand(plan: WorkoutPlan): IReadOnlyList<Segment>
}

class WorkoutRun {
  +Machine Machine
  +IReadOnlyList<Segment> Segments
  +int Segment
  +int Remaining
  +ResistanceMode Mode
  +int? PlanLevel
  +int? SentForSegment
  +int? LastSentLevel
  +double? LastSentSpeed
  +int? LastSentIncline
}

interface ITreadmillControl {
  +SetManualSpeedAsync(kmh: double, ct): Task<SendResult>
  +SetManualInclineAsync(percent: int, ct): Task<SendResult>
}

interface IResistanceControl {
  +SetManualAsync(level: int, ct): Task<SendResult>
}

class WorkoutEngine {
  +StartAsync(plan, ct): Task<WorkoutSnapshot>
  +BackToPlanAsync(ct): Task<WorkoutSnapshot?>
  -DriveAsync(run, ct): Task
  -DriveBikeAsync(run, ct): Task
  -DriveTreadmillAsync(run, ct): Task
}

interface ITreadmillCommander {
  +SendSpeedAsync(kmh: double, source: CommandSource, rideSeconds: int?, ct): Task<SendResult>
  +SendInclineAsync(percent: int, source: CommandSource, rideSeconds: int?, ct): Task<SendResult>
}

interface IResistanceCommander {
  +SendAsync(level: int, source: CommandSource, rideSeconds: int?, ct): Task<SendResult>
}

WorkoutPlan <|-- HiitPlan
WorkoutPlan <|-- FlatPlan
WorkoutPlanValidator ..> WorkoutPlan : creates
WorkoutPlanValidator ..> Machine : rules by
PlanExpander ..> Segment : yields
WorkoutEngine "1" *-- "0..1" WorkoutRun : owns
WorkoutRun "1" *-- "*" Segment
WorkoutRun --> Machine
WorkoutEngine ..|> ITreadmillControl
WorkoutEngine ..|> IResistanceControl
WorkoutEngine --> ITreadmillCommander : treadmill drive
WorkoutEngine --> IResistanceCommander : bike drive
WorkoutEngine ..> PlanExpander
@enduml
