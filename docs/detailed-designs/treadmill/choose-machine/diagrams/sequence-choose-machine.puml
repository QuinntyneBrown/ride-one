@startuml
title UML sequence behaviour — Choose the treadmill while the bike is connected
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "SetupPage / MachineChoice" as page
  participant "MACHINE_API" as client
end box
box "Backend — Wattzup API application" #D1FADF
  participant "MachineEndpoints" as ep
  participant "BikeConnectionService" as svc
end box
box "Backend — Wattzup Core and Protocol" #ECFDF3
  participant "WorkoutEngine (IMachineControl)" as engine
  participant "MachineSelector" as sel
  participant "BikeStateStore" as store
end box
box "Backend — Wattzup Infrastructure (BLE)" #FFF4E5
  participant "IBikeConnection (bike)" as conn
end box

rider -> page : Choose Treadmill
page -> client : choose('treadmill')
client -> ep : POST /api/machine {"machine":"treadmill"}
ep -> ep : Validate body [L2-062 AC6: 400 invalid_machine]
ep -> engine : ChooseAsync(Treadmill)
engine -> engine : Run on the engine loop
alt workout active
  engine --> ep : WorkoutActive
  ep --> client : 409 ProblemDetails, code = workout_active [L2-062 AC5]
else machine already treadmill
  engine --> ep : Unchanged
  ep --> client : 200 {"machine":"treadmill"}, link left as it is [L2-062 AC4]
else other machine
  engine -> sel : Select(Treadmill)
  sel -> store : Update(machine = treadmill, ble = scanning,\n device, speeds, distance, commands = [],\n bike and treadmill fields = null) [L2-062 AC3, L2-070 AC3]
  store --> page : broadcast (SSE)
  sel -> svc : Changed(Treadmill)
  svc -> svc : Cancel the current attempt (scan, connect, init or keepalive)
  svc -> conn : DisposeAsync (closes the bike link)
  svc -> svc : Clear ActiveConnectionRegistry
  engine --> ep : Changed
  ep --> client : 200 {"machine":"treadmill"}
  svc -> svc : Next attempt with MachineProfile.For(Treadmill)
end
client --> page : Result; the form switches to the treadmill's fields
@enduml
