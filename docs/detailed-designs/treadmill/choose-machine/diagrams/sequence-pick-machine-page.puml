@startuml
title UML sequence behaviour — Pick a machine on the machine page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Runner" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "MachinePage" as page
  participant "MachineHistoryStore" as history
  participant "LiveStateService" as live
  participant "MACHINE_API" as client
  participant "Router" as router
end box
box "Backend — Wattzup API application" #D1FADF
  participant "MachineEndpoints" as ep
  participant "BikeConnectionService" as svc
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "WorkoutEngine (IMachineControl)" as engine
  participant "BikeStateStore" as store
end box

rider -> page : Open /machine
page -> history : lastUsed, session(bike), session(treadmill)
page -> live : state()
live --> page : nearby [bike 3 bars, treadmill 4 bars]
page --> rider : "2 machines nearby", two cards; Last used tag [L2-073 AC1-4]
rider -> page : Run on the Stride
page -> page : picked = treadmill; disable both cards;\n"Connecting to treadmill…" [L2-073 AC6]
page -> client : choose('treadmill')
client -> ep : POST /api/machine {"machine":"treadmill"}
ep -> engine : ChooseAsync(Treadmill)
alt workout active
  engine --> ep : WorkoutActive
  ep --> client : 409 code = workout_active
  client --> page : rejects
  page --> rider : "End the run in progress to change the machine." [L2-073 AC8]
else server does not answer
  client --> page : rejects
  page --> rider : "Couldn't switch the machine" / "The Wattzup server didn't answer. Try again." [L2-073 AC8]
else changed
  engine --> ep : Changed
  ep --> client : 200 {"machine":"treadmill"}
  svc -> store : Scan with the treadmill profile
  alt treadmill found and connected
    store --> live : machine = treadmill, ble = connected (SSE)
    live --> page : state()
    page -> router : navigate('/setup'); the bike's card navigates to '/classes' instead (L2-079) [L2-073 AC6]
  else nothing found within 20 s
    store --> live : error = "No Echelon treadmill found yet — …" [L2-063 AC8]
    live --> page : state()
    page --> rider : Red card: "The Stride isn't answering. …" with Try again [L2-073 AC7]
  end
end
@enduml
