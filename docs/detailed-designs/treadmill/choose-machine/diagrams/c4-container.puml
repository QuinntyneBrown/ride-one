@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Choose the machine

Person(rider, "Rider", "Chooses the machine")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "Machine page at /machine: cards, signal, last session")
  Container(api, "Wattzup API", "ASP.NET Core (.NET)", "POST /api/machine, connection loop, state; includes Wattzup.Core and Wattzup.Protocol")
}
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")
System_Ext(machine, "Echelon bike or treadmill", "Proprietary BLE GATT service")

Rel(rider, web, "Picks the bike or the Stride", "HTTPS")
Rel(web, api, "POST /api/machine; reads machine, ble, error and nearby", "JSON / SSE")
Rel(api, os, "Scans, connects, subscribes and writes", "IBikeTransport")
Rel(os, machine, "Notifications and commands", "BLE GATT")
@enduml
