@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Choose the machine

Container_Boundary(web, "Wattzup Web") {
  Component(page, "MachinePage", "Angular component", "Cards as one radio group; connects on pick; opens /classes for the bike or /setup for the treadmill when connected")
  Component(card, "MachineCard / SignalBars", "Angular components", "One machine: signal, names, controls, last session")
  Component(view, "machine-page-view", "Pure helper", "Heading, card view, card status")
  Component(history, "MachineHistoryStore", "Service over localStorage", "Last session per machine, last used")
  Component(live, "LiveStateService", "Service", "Owns the EventSource; state signal")
  Component(mapi, "MACHINE_API", "Injection token", "choose(machine)")
}
Container_Boundary(api, "Wattzup API") {
  Component(ep, "MachineEndpoints", "Minimal API", "POST /api/machine: validates the body, maps the result")
  Component(engine, "WorkoutEngine", "IMachineControl, Wattzup.Core", "ChooseAsync on the engine loop: refuses during a workout")
  Component(sel, "MachineSelector", "Wattzup.Core.Machines", "Select(machine): resets fields, raises Changed")
  Component(profile, "MachineProfile", "Wattzup.Core.Machines", "Filter, notify list, init, keepalive, not-found message")
  Component(svc, "BikeConnectionService", "BackgroundService", "Scan, connect, initialise and keepalive per profile")
  Component(ingest, "TelemetryIngestor", "Wattzup.Core", "Decodes frames; echoes D0, D2, D3 on the treadmill")
  Component(store, "BikeStateStore", "Wattzup.Core", "Holds machine and every field; broadcasts")
  Component(proto, "Wattzup.Protocol", "Library", "EchelonDeviceFilter, EchelonTreadmillFilter, EchelonUuids, EchelonTreadmillCommands")
  Component(transport, "IBikeTransport / IBikeConnection", "Wattzup.Ble.Abstractions", "ScanAsync, ConnectAsync, SubscribeAsync(list), WriteAsync")
}
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")

Rel(page, card, "Renders two")
Rel(page, view, "Builds the views")
Rel(page, history, "Reads")
Rel(page, live, "Reads machine, ble, error, nearby")
Rel(page, mapi, "choose(machine)")
Rel(mapi, ep, "POST /api/machine", "JSON/HTTPS")
Rel(store, live, "Broadcasts", "SSE")
Rel(ep, engine, "ChooseAsync(machine)")
Rel(engine, sel, "Select(machine)")
Rel(sel, store, "Update: machine, ble = scanning, resets")
Rel(sel, svc, "Changed: cancel the attempt")
Rel(svc, store, "Reads machine; sets ble, device, error")
Rel(svc, profile, "For(machine) per attempt")
Rel(profile, proto, "Reads filters and commands")
Rel(svc, transport, "Scan, connect, subscribe, write")
Rel(transport, ingest, "onNotify(frame)")
Rel(ingest, transport, "Echo D0 / D2 / D3 without response")
Rel(transport, os, "Calls native APIs")
@enduml
