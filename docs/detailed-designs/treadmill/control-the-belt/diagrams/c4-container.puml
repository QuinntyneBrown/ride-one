@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Control the belt

Person(rider, "Rider", "Stands on the treadmill")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "Countdown overlay and announcement; Pause, Resume and End")
  Container(api, "Wattzup API", "ASP.NET Core (.NET LTS)", "Workout engine with the belt rules; includes Wattzup.Core and Wattzup.Protocol")
}
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")
System_Ext(treadmill, "Echelon treadmill", "Echelon BLE GATT service")

Rel(rider, web, "Uses", "Browser")
Rel(web, api, "POST /api/workout, pause, resume, stop", "JSON/HTTP")
Rel(api, web, "Pushes belt, belt_countdown and workout.status", "SSE")
Rel(api, os, "Writes belt commands", "IBikeTransport")
Rel(os, treadmill, "D3 speed reports and B0 belt frames", "BLE GATT")
@enduml
