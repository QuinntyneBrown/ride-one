@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Treadmill dashboard and setup

interface MachineApi {
  +choose(machine: Machine): Promise<void>
  +setSpeed(speed: number): Promise<void>
  +setIncline(incline: number): Promise<void>
}
class HttpMachineApi
class "MACHINE_API" as token <<InjectionToken>>

class LiveStateService {
  +state: Signal<BikeState | null>
  +connection: Signal<StreamConnection>
}

class TreadmillCommandService {
  +setSpeed(speed: number): Promise<void>
  +setIncline(incline: number): Promise<void>
}

class SpeedView <<interface>> {
  +valueText: string
  +paceText: string
  +statusText: string
  +statusTone: 'success' | 'warning' | 'neutral'
}
class InclineView <<interface>> {
  +valueText: string
  +noteText: string
}
class TreadmillControlsState <<interface>> {
  +slowerDisabled: boolean
  +fasterDisabled: boolean
  +lowerInclineDisabled: boolean
  +raiseInclineDisabled: boolean
  +quickSpeedsDisabled: boolean
  +pickerDisabled: boolean
  +pressedQuickSpeed: number | null
  +note: string | null
}
class "treadmill-view" as tv <<helper>> {
  +speedView(state): SpeedView
  +inclineView(state): InclineView
}
class "treadmill-controls" as tc <<helper>> {
  +MIN_SPEED = 0.8
  +MAX_SPEED = 19.3
  +SPEED_STEP = 0.5
  +QUICK_SPEEDS = [5, 8, 10, 12, 14, 16]
  +MIN_INCLINE = 0
  +MAX_INCLINE = 10
  +INCLINE_STEP = 1
  +baseSpeed(state): number
  +stepSpeed(state, dir): number
  +baseIncline(state): number
  +stepIncline(state, dir): number
  +treadmillControlsState(state, commandsEnabled): TreadmillControlsState
  +treadmillPlanNote(state): PlanNote
}
class "treadmill-trace" as tt <<helper>> {
  +speedMaxFor(topSpeed): number
  +treadmillTickStep(total): number
  +treadmillTraceGeometry(workout, elapsed, samples): TreadmillTraceScene
}
class TreadmillTraceStore {
  +history: TreadmillTraceHistory
  +version: Signal<number>
}
class "treadmill-energy" as te <<helper>> {
  +kcalPerSecond(speedKmh, incline): number
}
class "pace" as pace <<helper>> {
  +formatPace(speedKmh: number | null): string
  +formatAvgPace(elapsedSeconds, distanceKm): string
}
class "machine-words" as mw <<helper>> {
  +machineWords(machine): MachineWords
}
class "treadmill-plan-form" as tpf <<helper>> {
  +TREADMILL_PRESETS: TreadmillPreset[]
  +DEFAULT_TREADMILL_DRAFT: TreadmillPlanDraft
  +presetPressed(draft, id): boolean
  +applyTreadmillPreset(draft, id): TreadmillPlanDraft
  +validateTreadmillDraft(draft): TreadmillDraftError[]
  +stepTreadmillDraft(draft, field, dir): TreadmillPlanDraft
  +toTreadmillPlan(draft): WorkoutPlan | null
}
class PlanDraftStore {
  +load(): PlanDraft
  +save(draft: PlanDraft): void
  +loadTreadmill(): TreadmillPlanDraft
  +saveTreadmill(draft: TreadmillPlanDraft): void
}
class MachineHistoryStore {
  +recordStart(machine, summary, startedAt): void
}
class RideActions {
  +switchMachine(target: Machine): Promise<void>
}
class "ride-preview" as rp <<helper>> {
  +previewOf(plan): BikeRidePreview
  +treadmillPreviewOf(plan): TreadmillRidePreview
}

class RidePage
class SpeedControl {
  +view: SpeedView
  +controls: TreadmillControlsState
  +step: output<1 | -1>
}
class QuickSpeeds {
  +pressed: number | null
  +disabled: boolean
  +pick: output<number>
}
class InclineControl {
  +view: InclineView
  +controls: TreadmillControlsState
  +step: output<1 | -1>
  +pick: output<number>
}
class RideTrace
class RideOverlay
class SetupPage
class EffortRow {
  +label: 'Work' | 'Recover' | 'Hold'
  +speed: string
  +incline: number
  +error: string | null
  +stepSpeed: output<1 | -1>
  +pickIncline: output<number>
}
class RideProfile

MachineApi <|.. HttpMachineApi
token ..> MachineApi : provides
TreadmillCommandService --> token : injects
RidePage --> LiveStateService
RidePage ..> tv
RidePage ..> tc
RidePage ..> pace
RidePage ..> mw
RidePage *-- SpeedControl
SpeedControl *-- QuickSpeeds
RidePage *-- InclineControl
RidePage *-- RideTrace
RidePage *-- RideOverlay
RidePage --> TreadmillCommandService
RidePage --> RideActions : End and switch to bike
RideTrace ..> tt
RideTrace --> TreadmillTraceStore
SpeedControl ..> SpeedView
SpeedControl ..> TreadmillControlsState
InclineControl ..> InclineView
SetupPage *-- "2" EffortRow
SetupPage *-- RideProfile
SetupPage --> PlanDraftStore
SetupPage --> MachineHistoryStore : recordStart
SetupPage --> RideActions : Switch to bike
SetupPage ..> tpf
SetupPage ..> rp
rp ..> te
SetupPage --> LiveStateService
@enduml
