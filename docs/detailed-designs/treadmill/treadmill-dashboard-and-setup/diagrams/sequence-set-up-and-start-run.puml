@startuml
title UML sequence behaviour — Set up and start a run
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Runner" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "SetupPage" as page
  participant "treadmill-plan-form" as form
  participant "ride-preview / plan-expansion" as preview
  participant "PlanDraftStore" as drafts
  participant "MachineHistoryStore" as history
  participant "WORKOUT_API" as wapi
  participant "Router" as router
end box
box "Backend — Wattzup API application" #D1FADF
  participant "WorkoutEndpoints" as ep
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "WorkoutPlanValidator / WorkoutEngine" as engine
end box

rider -> page : Open /setup (machine = treadmill)
page -> drafts : loadTreadmill()
drafts --> page : last submitted draft, else Minute on [L2-072 AC4, AC10]
page --> rider : "Set up your run", HIIT intervals, Minute on pressed [L2-072 AC2, AC3]
rider -> page : Hill repeats
page -> form : applyTreadmillPreset(draft, 'hill-repeats')
form --> page : 6 × 1:30 / 1:30, 9.0 / 5.5 km/h, 8 / 0 %
page -> form : validateTreadmillDraft(draft)
form --> page : []
page -> preview : treadmillPreviewOf(toTreadmillPlan(draft))
preview --> page : total, speed and incline profiles,\nTop speed, Steepest, ~km, ~m, ~kcal [L2-072 AC8]
rider -> page : Start run
page --> rider : "Starting…" [L2-072 AC11]
page -> wapi : start(plan)
wapi -> ep : POST /api/workout {"kind":"hiit", "work_speed":9.0, ...}
ep -> engine : Validate(body, Treadmill) [L2-067]
alt valid
  engine --> ep : WorkoutPlan; workout starts, belt countdown 3 [L2-066 AC1]
  ep --> wapi : 200
  page -> drafts : saveTreadmill(draft)
  page -> history : recordStart(treadmill, "HIIT · 6 × 1:30 / 1:30", now) [L2-072 AC10]
  page -> router : navigate('/')
  router --> rider : Run Dashboard with the belt countdown
else invalid
  engine --> ep : field errors
  ep --> wapi : 400 ProblemDetails naming each field [L2-067]
  page --> rider : fields marked, form summary, Start run disabled [L2-072 AC7]
end
@enduml
