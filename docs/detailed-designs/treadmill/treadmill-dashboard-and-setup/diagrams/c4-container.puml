@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Treadmill dashboard and setup

Person(rider, "Rider", "Uses the ride dashboard and the setup screen")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "Ride dashboard at / and setup screen at /setup")
  Container(api, "Wattzup API", "ASP.NET Core", "State store, workout engine, machine, speed, incline and workout endpoints")
}
System_Ext(treadmill, "Echelon treadmill", "BLE GATT")

Rel(rider, web, "Uses", "HTTPS")
Rel(web, api, "GET /api/events", "SSE")
Rel(web, api, "POST /api/machine, /api/speed, /api/incline, /api/workout", "JSON/HTTPS")
Rel(api, treadmill, "Commands and notifications", "BLE GATT")
@enduml
