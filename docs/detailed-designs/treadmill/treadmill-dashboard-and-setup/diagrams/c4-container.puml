@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Treadmill dashboard and setup

Person(rider, "Runner", "Uses the Run Dashboard and Run Setup")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "Run Dashboard at / and Run Setup at /setup")
  ContainerDb(storage, "Browser local storage", "localStorage", "Plan draft per machine, last session, last used machine")
  Container(api, "Wattzup API", "ASP.NET Core", "State store, workout engine, speed, incline and workout endpoints")
}
System_Ext(treadmill, "Echelon Stride", "BLE GATT")

Rel(rider, web, "Uses", "HTTPS")
Rel(web, storage, "Reads and writes drafts and the last session")
Rel(web, api, "GET /api/events", "SSE")
Rel(web, api, "POST /api/speed, /api/incline, /api/workout", "JSON/HTTPS")
Rel(api, treadmill, "Commands and notifications", "BLE GATT")
@enduml
