@startuml
title UML sequence behaviour — Belt countdown, belt stopped and resume
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "RidePage" as page
  participant "rideViewState / rideOverlayText" as view
  participant "RideOverlay" as overlay
  participant "LiveStateService" as live
  participant "WORKOUT_API" as wapi
end box
box "Backend — Wattzup API application" #D1FADF
  participant "Wattzup API" as api
end box

api --> live : data: status "starting belt", belt "starting", belt_countdown 3
live --> page : state signal
page -> view : rideViewState(state)
view --> page : overlay belt-countdown
page -> overlay : "Belt starting in 3" / "Stand on the side rails. The belt starts when the count reaches zero." [L2-071]
overlay --> rider : overlay and polite announcement "Belt starting in 3"
api --> live : data: belt_countdown 2, then 1
page -> overlay : heading (polite live region) changes to 2, then 1
overlay --> rider : "Belt starting in 2", "Belt starting in 1", each announced once
api --> live : data: status "starting belt", belt_countdown null
page -> overlay : "Starting the belt…" [L2-071]
api --> live : data: status "running", belt "running", speed_kmh 1.0
page -> overlay : no overlay; speed and incline readouts [L2-066]
== The belt stops from the console ==
api --> live : data: status "paused: belt stopped", speed_kmh 0.0
page -> view : rideViewState(state)
view --> page : overlay belt-stopped; Resume enabled
page -> overlay : "Belt stopped" / "... paused the ride at <elapsed>. Press Resume ..." [L2-071]
rider -> page : Resume
page -> wapi : resume()
wapi -> api : POST /api/workout/resume
api --> wapi : 200
api --> live : data: status "starting belt", belt_countdown 3
page -> overlay : countdown again, as above [L2-066]
@enduml
