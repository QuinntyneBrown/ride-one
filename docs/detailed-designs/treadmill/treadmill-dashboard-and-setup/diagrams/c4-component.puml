@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Treadmill dashboard and setup

Container_Boundary(web, "Wattzup Web") {
  Component(live, "LiveStateService", "Root service", "Only EventSource; state signal with machine")
  Component(ride, "RidePage", "Component", "Readouts, trace, metrics, side panel, overlays, log")
  Component(controls, "SpeedControl / QuickSpeeds / InclineControl", "Components", "Slower, Faster, quick speeds, incline buttons and picker")
  Component(trace, "RideTrace", "Component", "Speed vs. plan with an incline lane")
  Component(renderer, "TraceRenderer", "Service", "WebGL with Canvas 2D fallback; pauses when hidden")
  Component(traceStore, "TreadmillTraceStore", "Root service", "Appends reported speed and incline per running second")
  Component(overlay, "RideOverlay", "Component", "Countdown, starting, belt stopped, Lost the Stride, scanning; live region")
  Component(setup, "SetupPage", "Component", "Run Setup: header, mode cards, presets, effort rows, toggles")
  Component(preview, "RidePreview", "Component", "Your run: speed and incline profiles, expected distance, climb, energy")
  Component(helpers, "Pure helpers", "src/app/core", "treadmill-view, treadmill-controls, treadmill-trace, treadmill-energy, pace, treadmill-plan-form, plan-expansion, ride-preview, cue-text, ride-overlay-text")
  Component(cmds, "TreadmillCommandService", "Root service", "Sends speed and incline; 503 toasts")
  Component(stores, "PlanDraftStore / MachineHistoryStore", "Root services", "Drafts per machine; last session")
  Component(actions, "RideActions", "Root service", "switchMachine: end dialog, then /machine")
  Component(machineApi, "MACHINE_API", "MachineApi token", "setSpeed, setIncline")
  Component(workoutApi, "WORKOUT_API", "WorkoutApi token", "start, stop, pause, resume, back to plan")
}
Container(api, "Wattzup API", "ASP.NET Core", "Endpoints and live state")

Rel(ride, live, "Reads state")
Rel(setup, live, "Reads machine, device_label and workout")
Rel(ride, helpers, "Builds views")
Rel(setup, helpers, "Validates, steps, presets and previews drafts")
Rel(ride, controls, "Renders")
Rel(ride, trace, "Renders")
Rel(trace, traceStore, "Reads samples")
Rel(traceStore, live, "Reads running seconds")
Rel(trace, renderer, "Draws the scene")
Rel(ride, overlay, "Renders")
Rel(setup, preview, "Renders")
Rel(setup, stores, "Saves the draft; records the last session")
Rel(ride, actions, "End and switch to bike")
Rel(setup, actions, "Switch to bike")
Rel(controls, cmds, "Speed or incline")
Rel(cmds, machineApi, "setSpeed / setIncline")
Rel(setup, workoutApi, "start")
Rel(machineApi, api, "POST", "JSON/HTTPS")
Rel(workoutApi, api, "POST", "JSON/HTTPS")
Rel(live, api, "GET /api/events", "SSE")
@enduml
