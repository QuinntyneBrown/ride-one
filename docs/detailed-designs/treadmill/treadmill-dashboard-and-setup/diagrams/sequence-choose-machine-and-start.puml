@startuml
title UML sequence behaviour — Choose the machine and start a treadmill ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "MachineChoice" as choice
  participant "SetupPage" as page
  participant "PlanDraftStore" as store
  participant "treadmill-plan-form / ride-preview" as form
  participant "MACHINE_API" as mapi
  participant "WORKOUT_API" as wapi
  participant "LiveStateService" as live
end box
box "Backend — Wattzup API application" #D1FADF
  participant "Wattzup API" as api
end box

live --> page : state: machine "bike", workout null
page -> choice : machine bike, enabled [L2-072]
rider -> choice : Treadmill
choice -> page : machineChange(treadmill)
page -> store : loadTreadmill()
store --> page : last treadmill draft, or DEFAULT_TREADMILL_DRAFT [L2-072]
page -> form : validateTreadmillDraft, treadmillPreviewOf
page --> rider : treadmill fields and preview
page -> mapi : choose(treadmill)
mapi -> api : POST /api/machine {"machine":"treadmill"}
alt answered
  api --> mapi : 200 {"machine":"treadmill"} [L2-062]
  api --> live : data: machine "treadmill", ble "scanning"
else no answer or error
  mapi --> page : rejects
  page --> rider : alert "Couldn't switch the machine" / "The Wattzup server didn't answer. Try again." [L2-072]
  page -> choice : back to state machine (bike); bike fields
end
rider -> page : Start ride
page -> store : saveTreadmill(draft)
page -> wapi : start(toTreadmillPlan(draft))
wapi -> api : POST /api/workout
api --> wapi : 200 {"started": workout}
page -> page : navigate to / [L2-072]
page --> rider : dashboard; belt countdown runs [L2-066]
@enduml
