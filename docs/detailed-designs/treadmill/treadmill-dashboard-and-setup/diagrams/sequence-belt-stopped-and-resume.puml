@startuml
title UML sequence behaviour — Belt stopped, link lost and resume
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Runner" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "RidePage" as page
  participant "rideViewState / rideOverlayText" as view
  participant "OverlayPanel" as overlay
  participant "ConnectionBanner" as banner
  participant "LiveStateService" as live
  participant "WORKOUT_API" as wapi
end box
box "Backend — Wattzup API application" #D1FADF
  participant "Wattzup API" as api
end box

alt the belt stops (console stop or safety key)
  api --> live : data: status "paused: belt stopped", belt "stopped", speed_kmh 0.0
  live --> page : state signal
  page -> view : rideViewState(state)
  view --> page : overlay belt-stopped; header Resume enabled
  page -> overlay : key icon, "Belt stopped" / "The belt stopped, so Wattzup paused the run at 9:33.\nIf you pulled the safety key, clip it back in, then press Resume — ..." [L2-071 AC16]
  page --> rider : badge "Belt stopped"; speed status "Belt stopped"; controls disabled [L2-071 AC3, AC10, AC18]
  rider -> overlay : Resume
  overlay -> wapi : resume()
  wapi -> api : POST /api/workout/resume
  api --> wapi : 200
  api --> live : data: status "starting belt", belt_countdown 3
  page -> overlay : belt countdown, as in the countdown sequence [L2-066 AC1]
else the link drops
  api --> live : data: ble "disconnected", status "paused: bike disconnected", belt null
  page -> view : rideViewState(state)
  view --> page : overlay bike-lost
  page -> overlay : "Lost the Stride" / "The Stride stopped answering and stopped its belt.\nStep onto the side rails, then reconnect — your run is saved at 9:33." with Reconnect [L2-071 AC17]
  page -> banner : danger, no Dismiss: "Lost the Stride" /\n"Step onto the side rails. If the Stride stays off for 90 seconds, Wattzup ends the run."
  note over overlay, banner : the belt claim rests on the hardware check of L2-043 AC5 (ADR 0010)
  api --> live : data: ble "connected", status "paused"
  page --> rider : run stays paused; Resume runs the countdown [L2-066 AC8]
end
@enduml
