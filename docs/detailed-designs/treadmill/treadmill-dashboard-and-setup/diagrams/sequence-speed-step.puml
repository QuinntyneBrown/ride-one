@startuml
title UML sequence behaviour — Step the speed
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "SpeedControl" as control
  participant "RidePage" as page
  participant "treadmill-controls" as tc
  participant "TreadmillCommandService" as cmds
  participant "MACHINE_API" as mapi
  participant "ToastService" as toast
  participant "LiveStateService" as live
end box
box "Backend — Wattzup API application" #D1FADF
  participant "TreadmillEndpoints" as api
end box

rider -> control : Raise speed
control -> page : step(1)
page -> tc : stepSpeed(state, 1)
tc --> page : reported 7.0 + 0.5 = 7.5, clamped to 1.0-16.0 [L2-071]
page -> cmds : setSpeed(7.5)
cmds -> mapi : setSpeed(7.5)
mapi -> api : POST /api/speed {"speed":7.5}
alt treadmill connected
  api --> mapi : 200 {"sent":7.5} [L2-069]
  api --> live : data: target_speed 7.5, speed_kmh 7.0, commands SPD 7.5 sending
  live --> page : state
  page --> rider : "Setting 7.5…"; log "SPD 7.5 · manual" [L2-071]
  api --> live : data: speed_kmh 7.5, entry ack
  page --> rider : "7.5 km/h", "Target 7.5 km/h", "4.7 mph"
else treadmill not connected
  api --> mapi : 503 code treadmill_not_connected [L2-069]
  mapi --> cmds : rejects
  cmds -> toast : danger "Couldn't set speed" / "The treadmill isn't connected. Switch it on, then try again." [L2-071]
  toast --> rider : toast
end
@enduml
