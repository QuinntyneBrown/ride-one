@startuml
title UML sequence behaviour — Set the treadmill's speed and acknowledge it
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "SpeedControl" as ctl
  participant "MACHINE_API" as client
end box
box "Backend — Wattzup API application" #D1FADF
  participant "TreadmillEndpoints" as ep
end box
box "Backend — Wattzup Core and Protocol" #ECFDF3
  participant "WorkoutEngine (ITreadmillControl)" as engine
  participant "TreadmillCommander" as cmdr
  participant "BikeStateStore" as store
  participant "TelemetryIngestor" as ingest
end box
box "Backend — Wattzup Infrastructure (BLE)" #FFF4E5
  participant "IBikeConnection" as conn
end box
participant "Echelon treadmill" as tm

rider -> ctl : Raise speed
ctl -> client : setSpeed(9.0)
client -> ep : POST /api/speed {"speed":9.0}
alt bike chosen
  ep --> client : 409 code = wrong_machine [L2-069 AC5]
else not 0.8-19.3 or more than 1 decimal
  ep --> client : 400 code = invalid_speed, "speed must be 0.8-19.3" [L2-069 AC2]
else valid
  ep -> engine : SetManualSpeedAsync(9.0)
  engine -> cmdr : SendSpeedAsync(9.0, manual, rideSeconds)
  alt no connection
    cmdr -> store : Update(commands + {speed, 9.0, failed}) [L2-065 AC7]
    cmdr --> engine : NotConnected
    ep --> client : 503 code = treadmill_not_connected [L2-069 AC4]
  else connected
    cmdr -> store : Update(commands + {command: speed, value: 9.0, level: null, status: sending})
    cmdr -> conn : WriteAsync(F0 B2 02 23 28 EF, withResponse: true) [L2-065 AC1]
    conn -> tm : write …f2
    cmdr -> store : Update(target_speed = 9.0) [L2-065 AC4]
    cmdr --> engine : Sent
    engine -> engine : workout in plan mode becomes manual [L2-068 AC7]
    ep --> client : 200 {"sent":9.0} [L2-069 AC1]
    tm -> conn : notify F0 D3 02 23 28 10
    conn -> ingest : OnNotify(frame)
    ingest -> store : Update(speed_kmh = 9.0,\n Acknowledge(Speed, 9.0): status = ack, ack_ms) [L2-065 AC4, AC6]
  end
end
@enduml
