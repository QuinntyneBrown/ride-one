@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Decode treadmill telemetry

Container_Boundary(api, "Wattzup API") {
  Component(conn, "IBikeConnection", "Wattzup.Ble.Abstractions", "Hands every frame from …f3 and …f4 to onNotify")
  Component(ingest, "TelemetryIngestor", "Wattzup.Core", "Counts, logs, decodes by machine, derives belt, acknowledges, echoes")
  Component(dec, "TreadmillPacketDecoder", "Wattzup.Protocol", "D3 to SpeedUpdate, D2 to InclineUpdate")
  Component(bikeDec, "PacketDecoder", "Wattzup.Protocol", "The bike's decoder, used when the bike is chosen")
  Component(log, "CommandLog", "Wattzup.Core", "Acknowledge(log, kind, value, nowMs)")
  Component(sinks, "IRawPacketSink", "Wattzup.Core", "Raw packet log and recent packet buffer")
  Component(store, "BikeStateStore", "Wattzup.Core", "speed_kmh, speed_mph, incline, belt; broadcasts")
  Component(engine, "WorkoutEngine", "Wattzup.Core", "Writes distance_km, climb_m and kcal per running tick")
  Component(totals, "RideTotals", "Wattzup.Core", "Distance, climb and energy of the ride")
  Component(energy, "TreadmillEnergy", "Wattzup.Core", "ACSM kcal per second, 75 kg runner")
}

Rel(conn, ingest, "OnNotify(frame)")
Rel(ingest, sinks, "Add(packet)")
Rel(ingest, dec, "Decode(frame) on the treadmill")
Rel(ingest, bikeDec, "Decode(frame) on the bike")
Rel(ingest, log, "Acknowledge speed or incline entries")
Rel(ingest, store, "One Update per frame")
Rel(ingest, conn, "Echo D0 / D2 / D3 without response")
Rel(engine, store, "Reads speed_kmh, incline; Update(distance_km, climb_m, kcal)")
Rel(engine, totals, "TickTreadmill(speed, incline)")
Rel(totals, energy, "KcalPerSecond(speed, incline)")
@enduml
