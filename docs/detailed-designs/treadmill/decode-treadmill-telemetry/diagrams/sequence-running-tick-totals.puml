@startuml
title UML sequence behaviour — Add a treadmill running tick's distance, climb and energy
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web application" #E0F2FE
  participant "LiveStateService" as live
  participant "MetricsStrip" as strip
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "WorkoutEngine" as engine
  participant "RideTotals" as totals
  participant "TreadmillEnergy" as energy
  participant "BikeStateStore" as store
end box

engine -> engine : Running tick (TimeProvider, 1 s)
engine -> store : Read speed_kmh, incline
store --> engine : 13.0 km/h, 2 %
engine -> totals : TickTreadmill(13.0, 2)
totals -> totals : DistanceKm += 13.0 ÷ 3600 [L2-064 AC9]
totals -> totals : ClimbM += 13.0 ÷ 3600 × 1000 × 2 ÷ 100 [L2-064 AC10]
totals -> energy : KcalPerSecond(13.0, 2)
energy -> energy : v = 216.7 m/min, g = 0.02;\nrunning equation from 6.5 km/h
energy --> totals : 0.3171 kcal [L2-064 AC11]
totals --> engine : New RideTotals
engine -> store : Update(distance_km 2 dp, climb_m, kcal whole)
store --> live : broadcast (SSE)
live --> strip : Distance, Climbed, Energy
note over engine, store
  A new treadmill workout starts from RideTotals.Empty;
  an ended or stopped one keeps its values [L2-064 AC12]
end note
@enduml
