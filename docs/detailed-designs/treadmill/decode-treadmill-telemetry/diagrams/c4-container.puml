@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Decode treadmill telemetry

Person(rider, "Rider", "Watches the dashboard")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "Speed, incline, pace and distance readouts")
  Container(api, "Wattzup API", "ASP.NET Core (.NET)", "Notify handler, decoder, state store, SSE")
}
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")
System_Ext(tm, "Echelon treadmill", "Proprietary BLE GATT service")

Rel(rider, web, "Reads", "HTTPS")
Rel(api, web, "Pushes speed_kmh, speed_mph, incline, belt, distance_km", "SSE")
Rel(os, api, "Delivers frames", "IBikeConnection")
Rel(tm, os, "D3 and D2 notifications", "BLE GATT")
@enduml
