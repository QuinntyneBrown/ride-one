@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Read bike telemetry
class TelemetrySample <<api>> {
  +at: number
  +cadence?: number
  +resistance?: number
  +speedKmh?: number
  +powerW?: number
  +heartRate?: number
}
class EchelonFrameDecoder <<domain/protocol>> {
  +decode(bytes: Uint8Array): TelemetrySample | null
}
class IndoorBikeDataDecoder <<domain/protocol>> {
  +decode(view: DataView): TelemetrySample
  -fieldsFromFlags(flags: number): FtmsField[]
}
class BikeTelemetry <<domain/engine>> {
  +cadence: Signal<number | null>
  +resistance: Signal<number | null>
  +speedKmh: Signal<number | null>
  +powerW: Signal<number | null>
  +powerIsEstimate: Signal<boolean>
  +accept(sample: TelemetrySample): void
  -expireCadence(now: number): void
}
class SpeedModel <<domain/engine>> {
  +{static} KMH_PER_RPM: number = 0.37497622
  +speedKmh(cadence: number): number
}
class PowerModel <<domain/engine>> {
  +estimate(cadence: number | null, level: number | null): number | null
  +target(cadenceAim: number, level: number): number
}
class EnergyModel <<domain/engine>> {
  +kcal(avgPowerW: number, runningSeconds: number): number
}
class "bankersRound()" as Round <<domain/engine>> {
  +bankersRound(value: number, digits: number): number
}
class RideTotals <<domain/engine>> {
  +distanceKm: Signal<number>
  +outputKj: Signal<number>
  +avgPowerW: Signal<number | null>
  +energyKcal: Signal<number>
  +onRunningSecond(): void
}
class RideClock <<domain/engine>> {
  +runningSeconds: Signal<number>
  +paused: Signal<boolean>
}
class RideReadout <<components>> {
  +label: input<string>
  +value: input<string | null>
  +unit: input<string>
}
EchelonFrameDecoder ..> TelemetrySample : creates
IndoorBikeDataDecoder ..> TelemetrySample : creates
BikeTelemetry ..> TelemetrySample : accepts
BikeTelemetry ..> SpeedModel
BikeTelemetry ..> PowerModel
SpeedModel ..> Round
PowerModel ..> Round
RideTotals --> BikeTelemetry : reads
RideTotals --> RideClock : ticks from
RideTotals ..> EnergyModel
@enduml
