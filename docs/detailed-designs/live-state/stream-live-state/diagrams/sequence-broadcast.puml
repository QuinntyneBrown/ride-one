@startuml
title UML sequence behaviour — Broadcast a state change
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Backend — Wattzup Core and Protocol" #ECFDF3
  participant "TelemetryIngestor" as ing
  participant "BikeStateStore" as store
  participant "StateBroadcaster" as bc
  participant "DisplayTimeTracker" as track
end box
box "Backend — Wattzup API application" #D1FADF
  participant "SseClient A" as a
  participant "SseClient B (slow)" as b
end box

ing -> store : Update(cadence, last_data_at)
store -> bc : StateChanged
bc -> track : Apply(state, now)
alt ui_clients > 0 and now - last_data_at < 5 s
  track --> bc : displayed_since ??= now; displayed_seconds = round(now - since, 1) [L2-032]
else
  track --> bc : displayed_since = null; displayed_seconds kept [L2-032]
end
bc -> store : write back tracked fields (no re-raise)
bc -> bc : serialise once {...state, ts} (snake_case, explicit nulls) [L2-014]
bc -> a : TryWrite(json) -> queued
bc -> b : TryWrite(json)
alt B has 50 undelivered
  b --> bc : false; Dropped += 1 (A unaffected) [L2-015]
end
note over a, b : p95 notify-to-browser under 100 ms on localhost [L2-037]
@enduml
