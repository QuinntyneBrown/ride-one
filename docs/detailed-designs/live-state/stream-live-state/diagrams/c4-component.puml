@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Stream live state

Container_Boundary(be, "Wattzup API") {
  Component(facts, "HostFacts", "Wattzup.Api", "transport, simulated, exposed, bind_address, connection_id")
  Component(writers, "State writers", "Wattzup.Core", "Connection service, ingestor, commander, workout engine")
  Component(store, "BikeStateStore", "Wattzup.Core", "Only writer; lock and reference swap")
  Component(der, "StateDerivations", "Wattzup.Core", "device_label, displayed time")
  Component(bc, "StateBroadcaster", "Wattzup.Core", "Serialise once, fan out")
  Component(clients, "SseClient channels", "Channel, bounded 50", "One per open stream")
  Component(events, "EventsEndpoints", "Minimal API", "GET /api/events (SSE)")
  Component(status, "StatusEndpoints", "Minimal API", "GET /api/status")
}
Container_Boundary(web, "Wattzup Web") {
  Component(live, "LiveStateService", "Angular service", "EventSource to read-only signals")
}

Rel(facts, store, "Seeds initial state")
Rel(writers, store, "Update(change)")
Rel(store, der, "Apply(next, now)")
Rel(store, bc, "StateChanged")
Rel(bc, clients, "TryWrite(json)")
Rel(events, clients, "Registers and drains")
Rel(status, store, "Reads Current")
Rel(live, status, "Initial load", "JSON/HTTP")
Rel(events, live, "data: / : ping", "SSE")
@enduml
