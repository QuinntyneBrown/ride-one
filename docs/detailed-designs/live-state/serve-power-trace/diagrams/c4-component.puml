@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Serve the power trace

Container_Boundary(be, "Wattzup API") {
  Component(eng, "WorkoutEngine", "Wattzup.Core", "1 s tick while running")
  Component(hist, "PowerTraceHistory", "Wattzup.Core", "Ring of 10,800 samples")
  Component(store, "BikeStateStore", "Wattzup.Core", "Current power and elapsed_seconds")
  Component(ep, "WorkoutTraceEndpoint", "Minimal API", "GET /api/workout/trace")
  Component(sse, "EventsEndpoints", "Minimal API", "GET /api/events")
}
Container_Boundary(web, "Wattzup Web") {
  Component(api, "BikeApi", "Angular service behind BIKE_API", "getTrace()")
  Component(live, "LiveStateService", "Angular service", "Read-only state signal")
  Component(trace, "RideTrace", "Angular component", "Draws power vs. plan")
}

Rel(eng, hist, "Reset() on start; Append(elapsed, power) per running tick")
Rel(eng, store, "Reads power")
Rel(ep, hist, "Snapshot()")
Rel(api, ep, "GET", "JSON/HTTP")
Rel(sse, live, "data: BikeState", "SSE")
Rel(trace, api, "Loads history on open and reconnect")
Rel(trace, live, "Appends new seconds")
@enduml
