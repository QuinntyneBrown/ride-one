@startuml
title UML sequence behaviour — A packet reaches the screen
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Browser — Web Bluetooth" #FFF4E5
  participant "Echelon bike (GATT)" as bike
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BikeLink" as link
  participant "TelemetryIngestor" as ing
  participant "PacketDecoder" as dec
  participant "BikeStateStore" as store
  participant "BrowserStateSource" as src
end box
box "Frontend — Wattzup Web" #E0F2FE
  participant "LiveStateService" as live
  participant "Ride Dashboard" as page
end box

bike -> link : characteristicvaluechanged(bytes)
link -> ing : onPacket(bytes)
ing -> dec : decode(bytes) [L2-005..L2-007 rules]
dec --> ing : TelemetryUpdate(cadence, resistance)
ing -> store : update(cadence, speed, power, last_data_at)
store -> store : derive device_label
store -> src : subscriber(newState)
src -> live : listener.state(newState) (same task) [L2-093 AC1]
live -> page : state signal changes
page -> page : OnPush render readouts [p95 < 50 ms, L2-093 AC2]
@enduml
