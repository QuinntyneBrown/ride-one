@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Run rides

Person(rider, "Rider", "Rides")
System_Boundary(browser, "Rider's browser") {
  Container(app, "Wattzup Web", "Angular + @wattzup/browser", "Screens; protocol and workout engine")
  ContainerDb(idb, "Wattzup database", "IndexedDB", "journal store: the ride in progress")
}
System_Ext(bike, "Echelon bike", "BLE")
Rel(rider, app, "Uses")
Rel(app, bike, "Notifications in, commands out", "Web Bluetooth")
Rel(app, idb, "Writes the journal every 10 s; reads it at start")
@enduml
