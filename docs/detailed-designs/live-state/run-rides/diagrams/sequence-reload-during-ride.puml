@startuml
title UML sequence behaviour — Reload during a ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web, browser edition" #E0F2FE
  participant "Progress" as progress
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "WorkoutEngine" as engine
  participant "SessionStore" as store
  participant "buildSession()" as builder
end box
box "Browser — storage" #FFF4E5
  database "IndexedDB" as idb
end box

loop each 10 running seconds, and on pagehide
  engine -> store : keepJournal(entry)
  store -> idb : put journal {plan, segments, samples, totals, savedAt}
end
rider -> engine : Reload or close the tab
engine --> rider : beforeunload: confirm leaving [L2-092 AC5]
rider -> engine : Leave
== next load ==
store -> idb : loadAll(), readJournal()
idb --> store : sessions; entry or none
alt entry with at least 60 running seconds (L2-081)
  store -> builder : entry, ended at savedAt; completed by its rule
  builder --> store : SessionRecord
  store -> idb : write(session); clear journal
else shorter
  store -> idb : clear journal; nothing resumed
end
rider -> progress : Open Progress
progress -> store : list()
store --> progress : the ride, among the sessions
@enduml
