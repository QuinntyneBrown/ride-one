@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Persist the status snapshot

class StatusSnapshotWriter {
  -BikeStateStore store
  -Channel<bool> dirty
  -TimeProvider time
  -StatusSnapshotOptions options
  #ExecuteAsync(ct): Task
  +StopAsync(ct): Task
}
class StatusSnapshotOptions {
  +string Path = "status.json"
  +TimeSpan MinInterval = 500 ms
  +bool Enabled = true
}
class AtomicFile <<static>> {
  +WriteAllTextAsync(path: string, text: string, ct): Task
}
class BikeStateStore {
  +BikeState Current
  +event StateChanged
}

StatusSnapshotWriter --> BikeStateStore : subscribes / reads
StatusSnapshotWriter --> StatusSnapshotOptions
StatusSnapshotWriter ..> AtomicFile
@enduml
