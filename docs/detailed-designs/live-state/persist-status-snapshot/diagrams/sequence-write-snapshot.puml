@startuml
title UML sequence behaviour — Coalesce, throttle and atomically write status.json
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Backend — Wattzup Core and Protocol" #ECFDF3
  participant "BikeStateStore" as store
  participant "StatusSnapshotWriter" as writer
end box
box "Backend — Wattzup Infrastructure (files)" #FFF4E5
  participant "AtomicFile" as atomic
  database "status.json" as file
end box

store -> writer : StateChanged (x N in a burst)
writer -> writer : dirty.TryWrite(true) (coalesced to 1)
loop while running
  writer -> writer : await dirty signal
  writer -> writer : wait until 500 ms since last write [L2-031]
  writer -> store : Current
  writer -> writer : serialise indented, no ts
  writer -> atomic : WriteAllTextAsync("status.json", json)
  atomic -> file : write status.json.tmp; flush
  atomic -> file : rename tmp over status.json (atomic) [L2-031]
  note right of writer : changes during the wait re-set dirty, so a trailing write follows
end
@enduml
