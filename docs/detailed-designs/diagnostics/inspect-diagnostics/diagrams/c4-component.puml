@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Inspect diagnostics
Person(rider, "Rider", "Rides a smart bike at home")
Container_Boundary(app, "Ride app") {
  Component(opener, "ProfilePage / RideHeader status link", "Angular page · ride; presentation · components", "Opens Diagnostics")
  Component(launcher, "DiagnosticsLauncher", "Service · ride", "Lazy-loads and opens the dialog with CDK Dialog")
  Component(dialog, "DiagnosticsDialog", "Angular dialog · ride", "Modal labelled Diagnostics")
  Component(facts, "DiagnosticsFactsList", "Presentation component · components", "Description list of facts")
  Component(reporter, "BrowserDiagnostics", "Service · domain/bluetooth", "Builds DiagnosticsFacts as a signal")
  Component(conn, "BikeConnection", "Contract · api", "Bike, state, connected since, RSSI, reconnects")
  Component(support, "BluetoothSupport", "Contract · api", "Web Bluetooth availability")
  Component(sent, "SentToBikeLog", "Service · domain/engine", "Last command")
  ComponentDb(outbox, "RideOutbox", "Store · domain/storage", "Rides waiting to send")
  ComponentDb(remembered, "RememberedBikeStore", "Store · domain/storage", "Last seen")
  Component(build, "BUILD_INFO", "Injection token · api", "App version and client commit")
}
Rel(rider, opener, "Chooses Diagnostics")
Rel(opener, launcher, "open()")
Rel(launcher, dialog, "Opens, restores focus on close")
Rel(dialog, reporter, "Reads facts via DIAGNOSTICS")
Rel(dialog, facts, "Renders")
Rel(reporter, conn, "Reads")
Rel(reporter, support, "Reads")
Rel(reporter, sent, "Reads")
Rel(reporter, outbox, "Counts")
Rel(reporter, remembered, "Reads")
Rel(reporter, build, "Reads")
@enduml
