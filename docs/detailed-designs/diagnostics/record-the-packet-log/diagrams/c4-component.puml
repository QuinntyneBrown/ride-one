@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Record the packet log
Person(rider, "Rider", "Rides a smart bike at home")
Container_Boundary(app, "Ride app") {
  Component(dialog, "DiagnosticsDialog", "Angular dialog · ride", "Switch, count and download")
  Component(sw, "Switch", "Presentation component · components", "role=switch, Log every packet")
  Component(conn, "WebBluetoothBikeConnection", "Service · domain/bluetooth", "Taps every write and notification")
  Component(log, "PacketLog", "Service · domain/bluetooth", "Mode, counts, entry framing")
  ComponentDb(store, "PacketLogStore", "Store · domain/storage", "IndexedDB, oldest dropped past 10 MB")
  Component(exporter, "PacketLogExporter", "Service · domain/storage", "JSON Lines file and object URL")
  Component(logger, "ConsoleAppLogger", "AppLogger · domain", "Browser console only; redacts")
  Component(settings, "SettingsStore", "Store · domain/storage", "Remembers the switch")
}
Rel(rider, sw, "Toggles")
Rel(dialog, sw, "Renders")
Rel(dialog, log, "Reads count, sets mode")
Rel(dialog, exporter, "Download packet log")
Rel(conn, log, "record(direction, bytes)")
Rel(log, store, "Appends")
Rel(log, logger, "Per-packet lines only in every-packet mode")
Rel(log, settings, "Persists mode")
Rel(exporter, store, "Reads all entries")
@enduml
