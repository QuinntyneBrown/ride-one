@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Record the packet log
enum PacketDirection {
  ToBike
  FromBike
}
enum PacketLogMode {
  CommandsOnly
  EveryPacket
}
class PacketEntry <<api>> {
  +time: string
  +direction: PacketDirection
  +frameType: string
  +hex: string
}
class PacketLog <<domain/bluetooth>> {
  +mode: Signal<PacketLogMode>
  +count: Signal<number>
  +bytes: Signal<number>
  +setMode(mode: PacketLogMode): void
  +record(direction: PacketDirection, data: Uint8Array): void
}
class PacketLogStore <<domain/storage>> {
  +{static} CAP_BYTES: number = 10485760
  +append(entry: PacketEntry): Promise<void>
  +readAll(): AsyncIterable<PacketEntry>
  -dropOldestOver(cap: number): Promise<void>
}
class PacketLogExporter <<domain/storage>> {
  +fileName(today: Date): string
  +download(): Promise<void>
}
interface AppLogger <<api>> {
  +info(area: string, message: string): void
  +error(area: string, error: unknown): void
}
class ConsoleAppLogger <<domain>> {
  +info(area: string, message: string): void
  +error(area: string, error: unknown): void
  -redact(text: string): string
}
class "packetLogSummary()" as Summary <<domain/bluetooth>> {
  +packetLogSummary(mode, count, bytes): string
}
PacketLog --> PacketLogMode
PacketLog ..> PacketEntry : creates
PacketEntry --> PacketDirection
PacketLog --> PacketLogStore : appends
PacketLog ..> AppLogger
PacketLogExporter --> PacketLogStore : reads
ConsoleAppLogger ..|> AppLogger
PacketLog ..> Summary
@enduml
