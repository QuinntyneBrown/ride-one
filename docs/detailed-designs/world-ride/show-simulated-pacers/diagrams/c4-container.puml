@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show simulated pacers

Person(rider, "Rider", "Watches the board")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "Computes and shows the pacer board")
  Container(api, "Wattzup API", "ASP.NET Core", "Streams the live state; knows no pacer")
}

Rel(rider, web, "Uses", "Browser")
Rel(api, web, "elapsed_seconds, speed_kmh", "SSE")
@enduml
