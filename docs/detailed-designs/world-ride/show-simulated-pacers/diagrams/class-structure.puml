@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show simulated pacers

class Pacer <<interface>> {
  +name: string
  +jersey: 1 | 2 | 3 | 5 | 6 | 7
  +base: number
  +amp: number
  +period: number
  +phase: number
}
class PacerRow <<interface>> {
  +name: string
  +jersey: 1..7
  +timeGap: string | null
  +you: boolean
}
class "pacers.ts" as pacersmod <<module>> {
  +PACERS: readonly Pacer[]
  +pacerGap(pacer, t): number
  +formatGap(seconds): string
  +pacerBoard(t, speedKmh): PacerRow[]
}
class WorldRidePage <<component>> {
  -pacers: Signal<PacerRow[]>
}
class WorldRide <<component>> {
  +pacers: input<PacerRow[]>
}

pacersmod "1" *-- "6" Pacer : holds
pacersmod ..> PacerRow : builds 7 per call
WorldRidePage ..> pacersmod : pacerBoard
WorldRidePage --> WorldRide : passes rows
@enduml
