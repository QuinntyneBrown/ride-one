@startuml
!include <C4/C4_Component>
title Render the scene at a quality tier — components
Person(rider, "Rider")
Container_Boundary(web, "Wattzup Web (Angular)") {
  Component(page, "WorldRidePage", "Angular component", "Passes the live state to the scene")
  Component(scene, "WorldScene", "Angular component", "Starts the renderer, drives frames")
  Component(renderer, "WorldRenderer", "Three.js WebGPURenderer", "Draws the scene and its passes")
  Component(quality, "render-quality.ts", "Pure TypeScript", "Tiers, technique table, frame budget")
  Component(frames, "FrameScheduler", "Angular service", "The app's only frame loop")
}
Container(assets, "Scene assets", "Static files, same origin", "public/worlds/<id>/")
Rel(rider, page, "Watches")
Rel(page, scene, "Inputs")
Rel(scene, frames, "Starts the loop")
Rel(scene, renderer, "start / draw")
Rel(renderer, quality, "startTier, techniquesAt, FrameBudget")
Rel(renderer, assets, "Loads", "HTTPS, same origin")
@enduml
