@startuml
title Drop a tier on the frame budget
box "Frontend" #EEF
participant FrameScheduler
participant WorldScene
participant WorldRenderer
participant FrameBudget
participant "frame-period.ts" as FP
participant "render-quality.ts" as RQ
end box
== World Ride opens ==
WorldScene -> FrameScheduler : measurePeriod()
FrameScheduler -> FP : estimateFramePeriod(intervals)
FP --> FrameScheduler : P
FrameScheduler --> WorldScene : P
WorldScene -> WorldRenderer : start(canvas, world)
WorldScene -> WorldRenderer : setFramePeriod(P)
WorldRenderer -> FrameBudget : setPeriod(P)
== Each frame ==
FrameScheduler -> WorldScene : now()
WorldScene -> WorldRenderer : draw(frame)
WorldRenderer -> FrameBudget : sample(now, frameMs)
alt second window in a row over 1.2 x P, tier above low
  FrameBudget --> WorldRenderer : drop
  WorldRenderer -> RQ : techniquesAt(lower tier, backend, reducedMotion)
  RQ --> WorldRenderer : technique ids
  WorldRenderer -> WorldRenderer : rebuild passes
else otherwise
  FrameBudget --> WorldRenderer : keep
end
WorldRenderer -> WorldRenderer : render
== Tab visible again, or another screen ==
WorldScene -> WorldRenderer : pauseBudget()
WorldRenderer -> FrameBudget : pause()
WorldScene -> FrameScheduler : measurePeriod()
FrameScheduler --> WorldScene : P2
WorldScene -> WorldRenderer : setFramePeriod(P2)
WorldRenderer -> FrameBudget : setPeriod(P2)
@enduml
