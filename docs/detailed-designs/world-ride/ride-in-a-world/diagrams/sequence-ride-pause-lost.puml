@startuml
title UML sequence behaviour — Ride, pause and lose the bike
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "WorldRide" as hud
  participant "WorldRidePage" as page
  participant "world-ride-view.ts" as view
  participant "LiveStateService" as live
  participant "RideActions" as actions
  participant "ResistanceCommandService" as res
end box
box "Backend — Wattzup API application" #D1FADF
  participant "Workout, resistance and bike endpoints" as ep
end box

live --> page : state message
page -> view : worldRideView(state, entry, world)
view --> page : WorldRideView [L2-091, L2-092, L2-093]
page -> hud : view, clock, countdown
rider -> hud : Raise resistance
hud -> page : stepped(1)
page -> res : set(stepLevel(state, 1))
res -> ep : POST /api/resistance [L2-096 AC2, L2-047]
rider -> hud : Pause
hud -> page : pauseToggled
page -> actions : pause()
actions -> ep : POST /api/workout/pause [L2-046]
ep --> live : status paused
live --> page : state message
page -> hud : overlay paused: Paused on Cathedral Circuit [L2-097 AC1]
ep --> live : status paused: bike disconnected
live --> page : state message
page -> hud : overlay lost: Lost the bike, parked at 1.61 km [L2-097 AC2]
hud -> hud : HUD inert; focus on Reconnect [L2-097 AC4]
rider -> hud : Reconnect
hud -> page : reconnected
page -> actions : reconnect()
actions -> ep : POST /api/bike/reconnect [L2-004 AC5]
ep --> live : ble connected
live --> page : state message
page -> hud : overlay closed; focus to the app bar [L2-097 AC3, AC4]
@enduml
