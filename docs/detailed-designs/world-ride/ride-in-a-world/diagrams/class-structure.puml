@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Ride in a world

enum WorldRideAccess {
  show
  class-page
}
enum WorldOverlay {
  paused
  lost
}
class WorldRideView <<interface>> {
  +worldName: string
  +classLine: string
  +bikeName: string
  +running: boolean
  +power: string
  +target: string
  +delta: string
  +cadence: string
  +heart: string
  +speed: string
  +segmentLabel: string
  +nextLine: string
  +level: number
  +levelCaption: string
  +canLower: boolean
  +canRaise: boolean
  +overlay: WorldOverlay | null
  +overlayText: string | null
}
class "world-ride-access.ts" as access <<module>> {
  +worldRideAccess(routeId, entry, workout): WorldRideAccess
}
class "world-ride-view.ts" as viewfn <<module>> {
  +worldRideView(state, entry, world): WorldRideView
}
class World <<interface>> {
  +id: WorldId
  +name: string
  +route: string
  +effortName: string
}
class WorldRide <<component>> {
  +view: input<WorldRideView>
  +clock: input<string>
  +segmentLeft: input<string>
  +segmentProgress: input<number>
  +profile: input<RouteProfileView>
  +pacers: input<PacerRow[]>
  +pauseToggled: output<void>
  +ended: output<void>
  +stepped: output<-1 | 1>
  +reconnected: output<void>
}
class WorldRidePage <<component>> {
  -id: string
  -entry: ClassResponse
  -onStep(delta): void
}
class RideActions <<service>> {
  +pause(): Promise<void>
  +resume(): Promise<void>
  +end(): void
  +reconnect(): Promise<void>
}
class ResistanceCommandService <<service>>

access --> WorldRideAccess : returns
viewfn --> WorldRideView : builds
viewfn ..> World : reads
WorldRideView --> WorldOverlay
WorldRidePage ..> access : decides with
WorldRidePage ..> viewfn : builds with
WorldRidePage *-- WorldRide : renders
WorldRide --> WorldRideView : shows
WorldRidePage ..> RideActions : commands
WorldRidePage ..> ResistanceCommandService : sets level
@enduml
