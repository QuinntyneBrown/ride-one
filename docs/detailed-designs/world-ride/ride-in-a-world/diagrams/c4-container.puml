@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Ride in a world

Person(rider, "Rider", "Rides a class")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "World Ride at /classes/:id/world")
  Container(api, "Wattzup API", "ASP.NET Core", "Class, live state, ride commands")
}
System_Ext(bike, "Echelon bike", "BLE")

Rel(rider, web, "Uses", "Browser")
Rel(web, api, "GET /api/classes/{id}; GET /api/events", "JSON/HTTP, SSE")
Rel(web, api, "POST /api/workout/pause, resume, stop; /api/resistance; /api/bike/reconnect", "JSON/HTTP")
Rel(api, bike, "Drives", "BLE")
@enduml
