@startuml
title UML sequence behaviour — Show the route profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web application" #E0F2FE
  participant "LiveStateService" as live
  participant "WorldRidePage" as page
  participant "route-profile.ts" as profile
  participant "worlds.ts" as worlds
  participant "WorldRide" as hud
end box
box "Backend — Wattzup API application" #D1FADF
  participant "StateBroadcaster" as broadcaster
end box

broadcaster --> live : state message
live --> page : state {workout.segments, elapsed_seconds, distance_km, status}
opt segments changed (new ride)
  page -> profile : routeProfile(world, segments)
  loop each second of the plan
    profile -> worlds : targetGrade(world, kind, s)
    worlds --> profile : percent
    profile -> profile : g += (target - g) × 0.12; rise = g / 100 × v; s += v [L2-101 AC3]
  end
  profile --> page : RouteProfile
end
page -> profile : routeProfileView(profile, segments, elapsed_seconds)
profile --> page : +0.5%, 10 m climbed, area, done width, strip, playhead, label [L2-106 AC1 to AC3]
page -> hud : profile, distance 1.61 km
note over page
  elapsed_seconds does not change while the ride is
  not running, so the panel holds still [L2-106 AC4].
end note
@enduml
