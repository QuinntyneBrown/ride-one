@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Draw the class scene

Person(rider, "Rider", "Watches the world")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular, WebGL", "World Ride chunk: scene, renderer, route profile")
  Container(assets, "Scene assets", "Static files", "public/worlds/<id>/: panorama and textures (.webp)")
  Container(api, "Wattzup API", "ASP.NET Core", "Serves wwwroot and streams the live state")
}

Rel(rider, web, "Uses", "Browser")
Rel(web, api, "GET /api/events", "SSE")
Rel(web, assets, "Loads, same origin", "HTTP")
Rel(api, assets, "Serves from wwwroot")
@enduml
