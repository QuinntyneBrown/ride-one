@startuml
title UML sequence behaviour — Bend the road each frame
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — World Ride chunk" #E0F2FE
  participant "ThreeWorldRenderer" as renderer
  participant "scene-bend.ts" as bend
  participant "SceneStreet" as street
  participant "BendNode (vertex stage)" as node
end box

== start ==
renderer -> street : build(ROAD_HALF, steps)
renderer -> node : set positionNode on every material but the sky and the panorama [ADR 0023]
renderer -> renderer : frustumCulled = false on bent meshes

== each frame ==
renderer -> renderer : roadAhead(world, segments, start, AHEAD) [L2-110 AC1]
renderer -> street : lay(points, s); place(s, heightAt) — straight coordinates
renderer -> bend : bendAhead(world, s)
bend -> bend : heading(s + m) − heading(s), every 4 m from −40 to 468 m [L2-101 AC6]
bend -> bend : centre line by the midpoint rule; heading eased to 0 past 300 m
bend --> renderer : 128 samples (x, z, φ, k)
renderer -> node : upload samples (uniformArray)
renderer -> bend : bendPoint(samples, lamp x, lamp z)
renderer -> bend : bendPoint(eye) and bendPoint(look-at 24 m ahead)
note right of renderer : no sway with reducedMotion;\nthe camera turns only as s moves [L2-110 AC6]
renderer -> node : render
node -> node : world position → bendPoint → local position\n(road, ribbons, crowds, terrain, props, pacers, arch) [L2-110 AC9]
@enduml
