@startuml
title UML sequence behaviour — Carry the class of a running workout
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web application" #E0F2FE
  participant "WORKOUT_API" as client
  participant "LiveStateService" as live
end box
box "Backend — Wattzup API application" #D1FADF
  participant "WorkoutEndpoints" as ep
  participant "StateBroadcaster" as broadcaster
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "ClassCatalogueStore" as store
  participant "WorkoutEngine" as engine
  participant "WorkoutRun" as run
  participant "BikeStateStore" as state
end box

client -> ep : POST /api/workout {plan, class_id: "30-minute-hiit-cardio"}
ep -> store : Current.Find(class_id) [L2-081 AC7]
store --> ep : ClassEntry
ep -> engine : StartAsync(plan, RideOrigin(id, title))
engine -> run : new run with Origin
loop each tick and change
  engine -> run : ToSnapshot()
  run --> engine : WorkoutSnapshot {ClassId = Origin?.ClassId} [L2-102 AC5]
  engine -> state : Apply(workout)
  state -> broadcaster : Publish
  broadcaster --> live : state message {workout: {…, class_id}} [L2-014]
end
ep --> client : 200
note over run
  A ride from /setup has no origin,
  so class_id is null.
end note
@enduml
