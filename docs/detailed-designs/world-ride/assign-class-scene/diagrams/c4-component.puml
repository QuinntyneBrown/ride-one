@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Assign a class scene

ContainerDb(file, "classes.json", "JSON file", "Catalogue with world per class")
Container_Boundary(api, "Wattzup API") {
  Component(service, "ClassCatalogueService", "Hosted service", "Loads and reloads the catalogue")
  Component(reader, "ClassCatalogueReader", "Static reader", "Applies L2-077 and L2-100")
  Component(worlds, "ClassWorlds", "Static list", "The six scene ids")
  Component(store, "ClassCatalogueStore", "Singleton", "Current catalogue")
  Component(classes, "ClassEndpoints", "Minimal API", "GET /api/classes, /api/classes/{id}")
  Component(workouts, "WorkoutEndpoints", "Minimal API", "POST /api/workout with class_id")
  Component(engine, "WorkoutEngine", "Hosted service", "Runs the workout, keeps its RideOrigin")
  Component(state, "BikeStateStore", "Singleton", "Publishes workout with class_id")
}

Rel(service, file, "Reads", "File system")
Rel(service, reader, "Read(stream)")
Rel(reader, worlds, "IsWorld(world)")
Rel(service, store, "Replace(catalogue)")
Rel(classes, store, "Reads Current")
Rel(workouts, store, "Finds the class for class_id")
Rel(workouts, engine, "StartAsync(plan, origin)")
Rel(engine, state, "Publishes WorkoutSnapshot.ClassId")
@enduml
