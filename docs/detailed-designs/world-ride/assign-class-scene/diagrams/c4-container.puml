@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Assign a class scene

Person(owner, "Owner", "Edits classes.json")
Person(rider, "Rider", "Rides a class")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "Class page and World Ride")
  Container(api, "Wattzup API", "ASP.NET Core", "Serves classes with their scene, and the live state")
  ContainerDb(file, "classes.json", "JSON file", "Shelves and classes, each with an optional world")
}

Rel(owner, file, "Edits")
Rel(api, file, "Reads and watches", "File system")
Rel(rider, web, "Uses", "Browser")
Rel(web, api, "GET /api/classes, /api/classes/{id}; GET /api/events", "JSON/HTTP, SSE")
@enduml
