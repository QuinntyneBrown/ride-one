@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Assign a class scene

class ClassWorlds <<static>> {
  +IReadOnlyList<string> Ids
  +IsWorld(id: string?): bool
}
class ClassEntry <<record>> {
  +string Id
  +string Title
  +string Channel
  +string Focus
  +string Description
  +string ShelfId
  +WorkoutPlan Plan
  +string? World
}
class ClassCatalogueReader <<static>> {
  +Read(file: Stream, length: long): CatalogueLoadResult
}
class CatalogueEntryProblem <<record>> {
  +string Entry
  +string Field
  +string Message
}
class ClassResponse <<record>> {
  +string Id
  +string Title
  +string Channel
  +string Focus
  +string Description
  +ShelfRef Shelf
  +WorkoutPlan Plan
  +string? World
}
class RideOrigin <<record>> {
  +string ClassId
  +string Title
}
class WorkoutRun {
  +RideOrigin? Origin
  +string? SessionId
  +ToSnapshot(): WorkoutSnapshot
}
class WorkoutSnapshot <<record>> {
  +WorkoutPlan Plan
  +string Status
  +int ElapsedSeconds
  +string? SessionId
  +string? ClassId
}

ClassCatalogueReader ..> ClassWorlds : checks world with
ClassCatalogueReader ..> ClassEntry : builds
ClassCatalogueReader ..> CatalogueEntryProblem : reports
ClassResponse ..> ClassEntry : copies World from
WorkoutRun --> "0..1" RideOrigin : started from
WorkoutRun ..> WorkoutSnapshot : publishes
@enduml
