@startuml
title UML sequence behaviour — Read a class's scene
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Owner" as owner
box "Backend — Wattzup API application" #D1FADF
  participant "ClassCatalogueService" as service
  participant "ClassEndpoints" as ep
end box
box "Backend — Wattzup Core" #ECFDF3
  participant "ClassCatalogueReader" as reader
  participant "ClassWorlds" as worlds
  participant "ClassCatalogueStore" as store
end box
box "Backend — Wattzup Infrastructure" #FFF4E5
  database "classes.json" as file
end box
box "Frontend — Wattzup Web application" #E0F2FE
  participant "CLASS_API" as client
end box

owner -> file : Save "world": "oldtown" on a class
service -> file : Read (file changed)
file --> service : JSON
service -> reader : Read(stream)
loop each class
  alt "world" missing or null
    reader -> reader : World = null [L2-100 AC1]
  else "world" is a string
    reader -> worlds : IsWorld(value)
    alt one of the six ids
      worlds --> reader : true
      reader -> reader : World = value [L2-100 AC1]
    else anything else
      worlds --> reader : false
      reader -> reader : Leave the class out; problem (id, "world") [L2-100 AC2, L2-077 AC3]
    end
  else any other JSON value
    reader -> reader : Leave the class out; problem (id, "world") [L2-100 AC2]
  end
end
reader --> service : CatalogueLoadResult
service -> service : Log a warning per problem
service -> store : Replace(catalogue)
client -> ep : GET /api/classes/{id}
ep -> store : Current.Find(id)
store --> ep : ClassEntry
ep --> client : 200 {…, plan, world} [L2-078, L2-100 AC5]
@enduml
