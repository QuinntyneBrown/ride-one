@startuml
title UML sequence behaviour — Open the dialog and choose a kind
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "CustomRidePage" as page
  participant "FeedbackDialog" as dialog
  participant "FeedbackStore" as store
end box
box "Frontend — Ride app (components and domain libraries)" #E0F2FE
  participant "FeedbackForm" as form
  participant "WorkoutEngine" as engine
  participant "RideContextBuilder" as ctx
end box
actor -> page : Press "Feedback"
page -> engine : pause() (L2-116 AC1)
page -> ctx : build()
ctx -> engine : Read workout, segment, resistance, power, ...
ctx --> page : RideContext
alt viewport below sm
  page -> dialog : Dialog.open as bottom sheet (L2-116 AC4)
else sm or wider
  page -> dialog : Dialog.open as 400 px popover under the button (L2-116 AC4)
end
dialog -> store : Provide; kind = bug, attachDiagnostics = true
dialog -> form : kind, copy, context, status = editing
form --> actor : "Send feedback", "What went wrong?", "Attach diagnostics", "Context is sent with your note." (L2-117 AC1, AC3)
actor -> form : Choose "Improvement"
form -> dialog : kindChange(improvement)
dialog -> store : kind.set(improvement)
store --> form : "What could be better?", "Send idea"; no diagnostics check (L2-116 AC2, L2-117 AC1)
actor -> form : Expand the context
form --> actor : "Attached from Ride", summary and details (L2-117 AC2)
actor -> form : Type a message
form -> store : message.set(text)
alt empty
  store --> form : canSend = false; button disabled (L2-116 AC3)
else over 2,000 characters
  store --> form : tooLong; count shown; refused (L2-116 AC3)
else valid
  store --> form : canSend = true
end
@enduml
