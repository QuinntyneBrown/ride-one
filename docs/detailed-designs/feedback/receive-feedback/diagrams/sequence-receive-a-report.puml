@startuml
title UML sequence behaviour — Receive a report
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Ride app (api library)" #E0F2FE
  participant "HttpFeedbackApi" as client
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "Fallback authorization policy" as auth
  participant "feedback rate limiter" as limiter
  participant "FeedbackController" as controller
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "SubmitFeedbackCommandValidator" as validator
  participant "SubmitFeedbackCommandHandler" as handler
  participant "FeedbackReport" as entity
end box
box "Backend — Telo.Ride.Infrastructure" #FFF4E5
  database "Telo Ride database" as db
end box
client -> auth : POST /api/feedback with session cookie
alt no valid session
  auth --> client : 401 (L2-119 AC2)
else signed in
  auth -> limiter : Partition by rider id
  alt more than 10 in the last hour
    limiter --> client : 429 ProblemDetails, code rate_limited, Retry-After (L2-119 AC3)
  else within the limit
    limiter -> controller : Submit(request)
    controller -> validator : SubmitFeedbackCommand(riderId from claims, ...)
    alt invalid kind, message or diagnostics
      validator --> client : 400 ProblemDetails, code invalid_feedback
    else valid
      validator -> handler : Handle
      handler -> entity : Create(kind, message, context, diagnostics, riderId, now)
      entity --> handler : Report kept as data (L2-119 AC4)
      handler -> db : Insert and save in one unit of work
      db --> handler : Committed
      handler --> controller : Report id
      controller --> client : 201 Created (L2-119 AC1)
    end
  end
end
@enduml
