@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Show the app header
class MainShell <<ride>> {
  -progress: ProgressStore
  -bike: BikeConnection
  +items: Home, Race, Classes, Profile
  +level: Signal<LevelView | undefined>
}
interface ProgressStore <<api>> {
  +progress: Signal<ProgressDto | undefined>
  +level: Signal<LevelView | undefined>
  +refresh(): Promise<void>
}
class RiderProgressStore <<ride>> {
  -progressApi: ProgressApi
  +refresh(): Promise<void>
}
interface ProgressApi <<api>> {
  +getProgress(): Promise<ProgressDto>
}
class HttpProgressApi <<api>> {
  +getProgress(): Promise<ProgressDto>
}
class AppHeaderLink <<components>> {
  selector: a[wz-app-header-link]
}
class AppHeaderLevel <<components>> {
  selector: a[wz-app-header-level]
  +level: input<LevelView>
}
class RouterLinkActive <<Angular router>> {
  +ariaCurrentWhenActive: "page"
}
class AppHeader <<components>> {
  +streakDays: input<number>
  +bikeStatus: input<BikeStatusView>
  +fullScreen: input<boolean>
  +fullScreenToggle: output<void>
}
class LevelView <<api>> {
  +level: number
  +totalXp: number
  +nextThresholdXp: number | null
  +fillPercent: number
  +ariaLabel: string
  +label: string
}
class ProgressDto <<api>> {
  +level: number
  +totalXp: number
  +nextLevelXp: number | null
  +streakDays: number
}
class LevelBadge <<components>> {
  +level: input<number>
}
class XpBar <<components>> {
  +fillPercent: input<number>
  +label: input<string>
}
class "toLevelView()" as toLevelView <<ride helper>> {
  +toLevelView(p: ProgressDto): LevelView
}
MainShell ..> ProgressStore : injects PROGRESS_STORE
MainShell ..> AppHeader : renders
MainShell ..> toLevelView : uses
RiderProgressStore ..|> ProgressStore
HttpProgressApi ..|> ProgressApi
RiderProgressStore --> ProgressApi : PROGRESS_API
ProgressStore --> ProgressDto
MainShell *-- AppHeaderLink : nav slot
MainShell *-- AppHeaderLevel : end slot
AppHeaderLink ..> RouterLinkActive : current item
AppHeaderLevel *-- LevelBadge
AppHeaderLevel *-- XpBar
AppHeaderLevel --> LevelView
toLevelView ..> LevelView : creates
@enduml
