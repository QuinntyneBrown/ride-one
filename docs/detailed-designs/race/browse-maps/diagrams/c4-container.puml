@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Browse maps
Person(rider, "Rider", "Rides a smart bike at home")
System_Boundary(telo, "Telo Ride") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "Every screen, Web Bluetooth, protocol and workout engine")
  ContainerDb(idb, "Browser storage", "IndexedDB", "Cached map catalogue")
  Container(api, "Telo Ride API", "ASP.NET Core, SignalR", "Sign-in, progress, catalogues, ride hub, feedback")
  ContainerDb(db, "Telo Ride database", "EF Core; engine <TO SUPPLY>", "Map definitions and rider progress")
}
Rel(rider, app, "Opens Map Select in", "HTTPS")
Rel(app, api, "GET /api/maps, GET /api/progress", "JSON/HTTPS")
Rel(app, idb, "Caches and reads the catalogue")
Rel(api, db, "Reads", "EF Core")
@enduml
