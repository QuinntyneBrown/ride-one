@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Celebrate an unlock

Container_Boundary(app, "Ride app") {
  Component(page, "ResultsPage", "Angular page · ride", "Places the unlock card when a map opened")
  Component(store, "ResultsStore", "Route-scoped signal store · ride", "unlock: Signal<UnlockCardView | null>")
  Component(catalogue, "CatalogueApi", "HTTP client · api (CATALOGUE_API)", "Map name, place and photo")
  Component(card, "UnlockCard", "Presentation component · components", "Gold card with entrance motion")
  Component(outbox, "RideOutbox", "Service · domain/storage (RIDE_OUTBOX)", "Recorded answer with openedMapId")
}
Container(api, "Telo Ride API", "ASP.NET Core", "POST /api/rides returns openedMapId")

Rel(page, store, "Reads unlock")
Rel(store, outbox, "status(rideId)")
Rel(store, catalogue, "Map details for openedMapId")
Rel(page, card, "Renders")
Rel(outbox, api, "Submits", "JSON/HTTPS")
@enduml
