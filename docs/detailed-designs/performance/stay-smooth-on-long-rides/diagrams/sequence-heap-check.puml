@startuml
title UML sequence behaviour — Check the heap over a long ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as dev
participant "Playwright" as pw
participant "Chromium (DevTools Protocol)" as cdp
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "Custom ride page (?simulate)" as page
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "SimulatedBike" as sim
end box
dev -> pw : Run e2e/heap/long-ride.heap.ts (on request only)
pw -> page : page.clock.install(); open /ride?simulate
page -> sim : Connect the simulated bike
pw -> page : Start a 3-hour ride
pw -> pw : page.clock.runFor(1 minute)
pw -> cdp : HeapProfiler.collectGarbage; Performance.getMetrics
cdp --> pw : JSHeapUsedSize at minute 1
pw -> pw : page.clock.runFor(179 minutes)
pw -> cdp : HeapProfiler.collectGarbage; Performance.getMetrics
cdp --> pw : JSHeapUsedSize at minute 180
pw -> pw : Assert growth at most 50 MB (L2-138 AC1)
pw --> dev : Result naming both readings
@enduml
