@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Stay smooth on long rides

ContainerDb(idb, "Browser storage", "IndexedDB", "ride-samples")
Container_Boundary(app, "Ride app") {
  Component(store, "RideSessionStore", "Route-scoped store · ride", "Owns the ride's parts")
  Component(ticker, "RideTicker", "Service · domain/engine", "One tick a second")
  Component(recorder, "RideRecorder", "Service · domain/engine", "One sample a second")
  Component(chunk, "SampleChunk", "Class · domain/engine", "600 samples in typed arrays")
  Component(series, "TraceSeries", "Class · domain/engine", "Decimated points, at most one per pixel")
  Component(samples, "RideSampleStore", "Service · domain/storage", "Persists full chunks")
  Component(trace, "RideTrace", "Presentation component · components", "Canvas trace")
}
Rel(store, recorder, "Owns")
Rel(ticker, recorder, "Signals each second")
Rel(recorder, chunk, "Appends to")
Rel(recorder, samples, "Hands full chunks to")
Rel(recorder, series, "Feeds")
Rel(samples, idb, "Writes", "IndexedDB")
Rel(store, trace, "Passes points input to")
Rel(series, store, "Exposes points signal")
@enduml
