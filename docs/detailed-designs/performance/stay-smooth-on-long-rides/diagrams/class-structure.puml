@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Stay smooth on long rides
hide empty members

class Sample <<api>> {
  +second: number
  +powerW: number
  +cadenceRpm: number
  +speedKmh: number
  +resistance: number
  +heartRateBpm: number | null
}
class SampleChunk <<domain/engine>> {
  +index: number
  +length: number
  -power: Float32Array(600)
  -cadence: Float32Array(600)
  -speed: Float32Array(600)
  -resistance: Uint8Array(600)
  -heartRate: Uint8Array(600)
  +append(sample: Sample): boolean
  +isFull(): boolean
}
class RideRecorder <<domain/engine>> {
  -current: SampleChunk
  -lastSecond: number
  +record(sample: Sample): void
  +finish(): Promise<StoredRide>
}
class TraceSeries <<domain/engine>> {
  -width: number
  +points: Signal<Point[]>
  +add(point: Point): void
  +resize(width: number): void
}
interface RideSampleStore <<api>> {
  +put(rideId: string, chunk: SampleChunk): Promise<void>
  +readAll(rideId: string): Promise<SampleChunk[]>
  +delete(rideId: string): Promise<void>
}
class IndexedDbRideSampleStore <<domain/storage>>
class RingBuffer<T> <<domain/engine>> {
  -capacity: number
  -start: number
  +push(value: T): void
  +values(): T[]
}
class RideTrace <<components>> {
  +points: InputSignal<Point[]>
}
RideRecorder *-- "1" SampleChunk : current
RideRecorder *-- TraceSeries
RideRecorder --> RideSampleStore : hands full chunks
IndexedDbRideSampleStore ..|> RideSampleStore
SampleChunk ..> Sample : stores columns of
RideTrace ..> TraceSeries : draws points of
@enduml
