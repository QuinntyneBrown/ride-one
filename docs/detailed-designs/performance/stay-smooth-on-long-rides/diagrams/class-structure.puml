@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Stay smooth on long rides

class RideTotals <<reshaped>> {
  +runningSeconds: Signal<number>
  +outputKj: Signal<number>
  +aimedSeconds: Signal<number>
  +onTargetSeconds: Signal<number>
  -effortJoules: Float64Array(8)
  -effortSeconds: Uint16Array(8)
  +onRunningSecond(state: PlanState): void
  +effortWatts(): number[]
}

class RideRecorder <<no longer used by the class ride>> {
  -speedsKmh: Float64Array(14400)
  +record(powerW, speedKmh, seconds, onTarget): void
}

class ClassRideStore <<store>> {
  -lastSecond: number
  -pausedByRider: WritableSignal<boolean>
  -pausedByBike: WritableSignal<boolean>
  -player: WritableSignal<VideoPlayer | null>
  -record(second: number): void
}

class ClassRidePage <<component>> {
  providers: ClassRideStore, RideClock, RideTicker,
  WorkoutEngine, ResistanceController,
  BikeTelemetry, VideoClockSync, RideTotals
}

class BikeTelemetry {
  +cadence: Signal<number | null>
  +resistance: Signal<number | null>
  +powerW: Signal<number | null>
  -expiry: Timeout
}

class RideTicker {
  -timer: Timeout | null
  +stop(): void
}

interface PlanState {
  +index: number
  +segment: Segment
  +targetPower: number | null
}

class "long-ride.heap.ts" as LongRide <<heap check, new>> {
  paused ride, 3 hours
  growth at most 50 MB
}

class "enter-and-leave.heap.ts" as EnterLeave <<heap check, new>> {
  10 visits to Class Ride
  third to tenth return: at most 5 MB
}

class "playwright.heap.config.ts" as HeapConfig <<config, new>> {
  testMatch: **/*.heap.ts
  Chromium only, one worker
  runs when a person asks
}

ClassRidePage *-- ClassRideStore
ClassRidePage *-- RideTotals
ClassRidePage *-- BikeTelemetry
ClassRidePage *-- RideTicker
ClassRideStore --> RideTotals : reports each running second
ClassRideStore --> BikeTelemetry : reads the latest power
RideTotals ..> PlanState : reads segment and target
ClassRideStore .. RideRecorder : replaced by RideTotals
HeapConfig ..> LongRide : runs
HeapConfig ..> EnterLeave : runs
LongRide ..> ClassRidePage : measures
EnterLeave ..> ClassRidePage : measures
@enduml
