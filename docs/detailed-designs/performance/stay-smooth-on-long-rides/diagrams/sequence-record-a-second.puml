@startuml
title UML sequence behaviour — Record one second
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "RideTicker" as ticker
  participant "RideRecorder" as recorder
  participant "SampleChunk" as chunk
  participant "TraceSeries" as series
  participant "IndexedDbRideSampleStore" as store
end box
database "Browser storage (IndexedDB)" as idb
ticker -> recorder : record(sample for second n)
alt second n already recorded
  recorder --> ticker : Ignored (one sample a second, L2-138 AC2)
else new second
  recorder -> chunk : append(sample)
  recorder -> series : add(point)
  opt chunk is full (600 samples)
    recorder -> store : put(rideId, chunk)
    store -> idb : Write ride-samples[rideId, index]
    idb --> store : Committed
    recorder -> recorder : Replace with a new SampleChunk; old chunk is released (L2-138 AC1)
  end
end
@enduml
