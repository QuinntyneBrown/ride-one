@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Ride without a network
hide empty members

class WaitingRide <<api>> {
  +rideId: string
  +finishedAt: string
  +attempts: number
  +submission: RideSubmission
}
interface RideOutbox <<api>> {
  +add(ride: WaitingRide): Promise<void>
  +oldestFirst(): Promise<WaitingRide[]>
  +remove(rideId: string): Promise<void>
  +markAttempt(rideId: string): Promise<void>
}
class IndexedDbRideOutbox <<domain/storage>> {
  -dbName: "telo-ride"
  -storeName: "rides-waiting"
}
interface RidesApi <<api>> {
  +submit(ride: RideSubmission): Promise<RideResult>
}
class HttpRidesApi <<api>> {
  -http: HttpClient
}
class NetworkStatus <<ride>> {
  +online: Signal<boolean>
  +backendReachable: Signal<boolean>
}
class OutboxSync <<ride>> {
  -retryTimer: number | null
  -delayMs: number
  +start(): void
  +finish(ride: RideSubmission): Promise<RideResult | Pending>
  -drain(): Promise<void>
  -scheduleRetry(): void
}
class MultiplayerAvailability <<domain/engine>> {
  +forMode(mode: RideMode, online: boolean): Availability
}
IndexedDbRideOutbox ..|> RideOutbox
HttpRidesApi ..|> RidesApi
OutboxSync --> RideOutbox : stores rides in
OutboxSync --> RidesApi : submits with
OutboxSync --> NetworkStatus : listens to
RideOutbox "1" o-- "*" WaitingRide
MultiplayerAvailability ..> NetworkStatus : reads online
@enduml
