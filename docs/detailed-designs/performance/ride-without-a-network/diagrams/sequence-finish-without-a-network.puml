@startuml
title UML sequence behaviour — Finish without a network
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "ClassRideStore" as store
  participant "Angular Router" as router
  participant "Class Done page" as done
end box
box "Frontend — Ride app (domain library)" #ECFDF3
  participant "RideTicker" as ticker
  participant "Record store" as record
end box
box "Device — Browser" #F2F4F7
  database "localStorage" as ls
end box
box "External — Static host" #FFF4E5
  participant "Static host" as host
end box
rider -> store : Start the class, with a network
store -> host : Preload Class Done's chunk with a dynamic import
host --> store : Module, kept by the browser
note over store, host : The network is lost some time later
ticker -> store : Tick: second 1800
store -> store : Build the ride result from the running totals
store -> record : Record the finished ride
record -> ls : Write count, best output and last output
ls --> record : Written
record --> store : Updated record (L2-135 AC2)
store -> router : navigateByUrl("/done", state: ride result)
router -> done : Resolve the preloaded module; no request
done -> record : Read the record
done --> rider : Class Done shows the result, exactly as with a network (L2-135 AC2)
@enduml
