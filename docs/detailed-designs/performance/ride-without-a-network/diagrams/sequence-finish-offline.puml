@startuml
title UML sequence behaviour — Finish a ride offline
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "Ride page" as page
  participant "OutboxSync" as sync
  participant "ResultsPage" as results
end box
box "Frontend — Ride app (domain and api libraries)" #E0F2FE
  participant "IndexedDbRideOutbox" as outbox
  participant "HttpRidesApi" as client
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RidesController" as ctrl
end box
actor -> page : Finish the ride
page -> sync : finish(submission with rideId)
sync -> outbox : add(WaitingRide) before sending
sync -> client : submit(submission)
client -x ctrl : POST /api/rides
client --> sync : Network error or 5xx
sync -> outbox : markAttempt(rideId)
sync -> sync : scheduleRetry()
sync --> page : Pending
page -> results : Navigate with rideId
results -> outbox : Read the waiting ride
results --> actor : Ride shown with XP pending (L2-135 AC1)
@enduml
