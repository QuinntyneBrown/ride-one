@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Keep the ride clock true
hide empty members

interface MonotonicTime <<api>> {
  +now(): number
}
class RideClock <<domain/engine>> {
  -startedAt: number
  -pausedAt: number | null
  -pausedTotalMs: number
  +start(): void
  +pause(): void
  +resume(): void
  +elapsedMs(): number
}
class RideTicker <<domain/engine>> {
  -timer: number | null
  +second: Signal<number>
  +start(): void
  +stop(): void
  -scheduleNext(): void
  -onVisibilityChange(): void
}
class WorkoutEngine <<domain/engine>> {
  +stateAt(elapsedMs: number): PlanState
}
class PlanState <<domain/engine>> {
  +segment: Segment
  +segmentRemainingMs: number
  +targetResistance: number
}
class DistanceIntegrator <<domain/engine>> {
  -lastTimestampMs: number
  +metres: number
  +add(speedKmh: number, timestampMs: number): void
}
class ReadoutSampler <<domain/engine>> {
  -lastPublishMs: number
  -held: BikeSample | null
  +readout: Signal<BikeSample | null>
  +push(sample: BikeSample): void
  +flush(): void
}
class BoardOrder <<domain/engine>> {
  -lastAppliedMs: number
  +order: Signal<RiderId[]>
  +offer(ranking: RiderId[], nowMs: number): void
}
interface ScreenWakeLock <<api>> {
  +acquire(): Promise<void>
  +release(): Promise<void>
}
class BrowserScreenWakeLock <<ride/browser>> {
  -sentinel: WakeLockSentinel | null
}
class LeaveRideGuard <<ride>> {
  +arm(): void
  +disarm(): void
}
class RideSessionStore <<ride>> {
  +elapsed: Signal<number>
  +planState: Signal<PlanState>
  +start(plan: Plan): void
  +end(): void
}
RideClock ..> MonotonicTime : reads
RideTicker --> RideClock : reads elapsedMs
RideTicker ..> WorkoutEngine : calls stateAt
WorkoutEngine ..> PlanState : returns
BrowserScreenWakeLock ..|> ScreenWakeLock
RideSessionStore *-- RideClock
RideSessionStore *-- RideTicker
RideSessionStore *-- DistanceIntegrator
RideSessionStore *-- ReadoutSampler
RideSessionStore *-- BoardOrder
RideSessionStore --> ScreenWakeLock : acquires
RideSessionStore --> LeaveRideGuard : arms
@enduml
