@startuml
title UML sequence behaviour — Name a new account
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app" #E0F2FE
  participant "DisplayNamePromptPage" as page
  participant "DisplayNameForm" as form
  participant "HttpRidersApi" as client
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RidersController" as ctrl
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "SetDisplayNameCommandValidator" as validator
  participant "SetDisplayNameCommandHandler" as handler
  participant "Rider" as rider
end box
box "Backend — Telo.Ride.Infrastructure" #FFF4E5
  database "Telo Ride database" as db
end box
page --> actor : "What should other riders call you?" (L2-005 AC1)
form --> actor : Continue disabled while the field is empty
actor -> form : Type "Sam", choose Continue
form -> form : DisplayNamePolicy.check (trimmed, 2 to 24, allowed characters)
form -> page : submitted("Sam")
page -> client : setDisplayName("Sam")
client -> ctrl : PUT /api/riders/me/display-name
ctrl -> validator : Through the MediatR validation behaviour
alt breaks the rule (L2-005 AC2)
  validator --> ctrl : Field displayName, code display_name_invalid
  ctrl --> client : 400 ProblemDetails
  client --> page : ApiError
  page --> form : Field says what is allowed, aria-invalid="true"
else valid
  validator -> handler : SetDisplayNameCommand
  handler -> rider : Rename(DisplayName "Sam")
  handler -> db : Save
  handler --> ctrl : RiderMe
  ctrl --> client : 200
  client --> page : Saved
  page --> actor : Go on: Connect Bike, the return URL or Home
end
@enduml
