@startuml
set separator none
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Sign in with an email code
package "api library" {
  interface AuthApi {
    +sendCode(email: string): Promise<void>
    +confirmCode(email: string, code: string): Promise<ConfirmCodeResult>
  }
  class ConfirmCodeResult {
    +isNewAccount: boolean
    +hasDisplayName: boolean
  }
  class ApiError {
    +status: number
    +code: string
    +retryAfterSeconds?: number
  }
  class HttpAuthApi
  AuthApi <|.. HttpAuthApi
  AuthApi ..> ConfirmCodeResult : returns
  HttpAuthApi ..> ApiError : throws
}
package "ride application" {
  class SignInStore {
    +email: Signal<string>
    +sending: Signal<boolean>
    +errorCode: Signal<string | null>
    +resendSecondsLeft: Signal<number>
    +sendCode(email: string): Promise<boolean>
    +confirm(code: string): Promise<SignInOutcome>
    +resend(): Promise<void>
  }
  enum SignInOutcome {
    NameNeeded
    ConnectBike
    ReturnUrl
    Refused
  }
  class SignInPage
  class SignInCodePage
  SignInPage --> SignInStore
  SignInCodePage --> SignInStore
  SignInStore --> AuthApi : AUTH_API
  SignInStore ..> SignInOutcome
}
package "components library" {
  class CodeEntry {
    +invalid: input<boolean>
    +disabled: input<boolean>
    +completed: output<string>
  }
}
SignInCodePage --> CodeEntry
package "Telo.Ride.Api" {
  class AuthController {
    +SendCode(request: SendCodeRequest): Task<IActionResult>
    +ConfirmCode(request: ConfirmCodeRequest): Task<IActionResult>
  }
}
package "Telo.Ride.Application" {
  class SendSignInCodeCommand {
    +string Email
    +IPAddress ClientAddress
  }
  class SendSignInCodeCommandHandler {
    +Handle(command: SendSignInCodeCommand): Task<Result>
  }
  class ConfirmSignInCodeCommand {
    +string Email
    +string Code
  }
  class ConfirmSignInCodeCommandHandler {
    +Handle(command: ConfirmSignInCodeCommand): Task<Result<ConfirmCodeResult>>
  }
  interface IEmailSender {
    +SendSignInCode(to: EmailAddress, code: string): Task
  }
  interface ISignInCodeHasher {
    +Hash(code: string): byte[]
    +Matches(code: string, hash: byte[]): bool
  }
  interface IAppDbContext
}
package "Telo.Ride.Domain" {
  class EmailAddress <<value object>> {
    +string Value
    +{static} Parse(raw: string): EmailAddress
  }
  class SignInCode {
    +Guid Id
    +EmailAddress Email
    +byte[] CodeHash
    +DateTimeOffset IssuedAt
    +int FailedAttempts
    +DateTimeOffset? UsedAt
    +DateTimeOffset? SupersededAt
    +Verify(matches: bool, now: DateTimeOffset): CodeCheck
    +Supersede(now: DateTimeOffset): void
  }
  enum CodeCheck {
    Matched
    Mismatch
    Expired
    Locked
    Used
  }
  class Rider {
    +Guid Id
    +EmailAddress Email
    +DisplayName? DisplayName
    +DateTimeOffset CreatedAt
  }
}
AuthController ..> SendSignInCodeCommand : sends
AuthController ..> ConfirmSignInCodeCommand : sends
SendSignInCodeCommandHandler ..> SendSignInCodeCommand : handles
ConfirmSignInCodeCommandHandler ..> ConfirmSignInCodeCommand : handles
SendSignInCodeCommandHandler --> IEmailSender
SendSignInCodeCommandHandler --> ISignInCodeHasher
ConfirmSignInCodeCommandHandler --> ISignInCodeHasher
SendSignInCodeCommandHandler --> IAppDbContext
ConfirmSignInCodeCommandHandler --> IAppDbContext
SendSignInCodeCommandHandler ..> SignInCode : creates
ConfirmSignInCodeCommandHandler ..> Rider : finds or creates
SignInCode --> EmailAddress
SignInCode ..> CodeCheck
Rider --> EmailAddress
@enduml
