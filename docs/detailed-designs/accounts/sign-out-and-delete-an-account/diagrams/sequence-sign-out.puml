@startuml
title UML sequence behaviour — Sign out
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app" #E0F2FE
  participant "ProfilePage" as page
  participant "CurrentRiderStore" as current
  participant "HttpAuthApi" as client
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "AuthController" as ctrl
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "SignOutCommandHandler" as handler
  participant "RiderSession" as session
end box
box "Backend — Telo.Ride.Infrastructure" #FFF4E5
  participant "Cookie authentication" as cookie
  database "Telo Ride database" as db
end box
actor -> page : Choose "Sign out" in Settings
page -> current : signOut()
current -> client : signOut()
client -> ctrl : POST /api/auth/sign-out (anti-forgery token)
ctrl -> handler : Send SignOutCommand
handler -> session : End(now) (L2-006 AC1)
handler -> db : Save
handler -> cookie : SignOutAsync: clear __Host-telo-session
ctrl --> client : 204
client --> current : Signed out
current --> page : Navigate to /sign-in
note over db : The old session key is refused on its next use (L2-127 AC3)
@enduml
