@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Log resistance commands

Person(rider, "Rider", "Rides the bike and watches the dashboard")
System(wattzup, "Wattzup", "Live telemetry, resistance control and interval workouts for an Echelon bike")
System_Ext(os, "OS Bluetooth stack", "WinRT / BlueZ / CoreBluetooth")
System_Ext(bike, "Echelon bike", "Indoor bike exposing a proprietary BLE GATT service")

Rel(rider, wattzup, "Reads commands sent to the bike in", "Browser")
Rel(wattzup, os, "Writes commands and receives reports through")
Rel(os, bike, "Set-resistance writes and resistance frames", "BLE GATT")
@enduml
