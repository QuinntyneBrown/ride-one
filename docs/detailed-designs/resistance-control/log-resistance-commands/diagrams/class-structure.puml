@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Log resistance commands

package "@wattzup/api" {
  interface CommandEntry {
    +at: number
    +ride_seconds: number | null
    +level: number
    +source: 'plan' | 'manual'
    +status: 'sending' | 'ack' | 'failed'
    +ack_ms: number | null
  }
  interface BikeState {
    +commands: CommandEntry[]
    +connection_id: string
  }
}

package "@wattzup/browser lib/engine" {
  class "command-log" as CommandLogFns <<module>> {
    +CAPACITY = 5
    +add(log, entry): CommandEntry[]
    +fail(log, entry): CommandEntry[]
    +acknowledge(log, level, nowMs): CommandEntry[]
  }
  class ResistanceCommander {
    -store: BikeStateStore
    -link: BikeLink
    -clock: Clock
    +send(level, source, rideSeconds): Promise<SendResult>
  }
  class TelemetryIngestor {
    -store: BikeStateStore
    -clock: Clock
    +onNotify(frame: Uint8Array): void
  }
}

package "wattzup app and components" {
  class CommandLog <<component>> {
    +entries: Signal<CommandEntry[]>
    +connectionId: Signal<string>
  }
  class "command-log-view.ts" as view <<pure>> {
    +formatRideTime(seconds: number): string
    +statusText(entry: CommandEntry): string
  }
  class CommandFeedbackService <<service>> {
    -slowTimers: Map<number, Timer>
    -onCommands(entries: CommandEntry[]): void
  }
}

CommandLogFns ..> CommandEntry : transforms
ResistanceCommander ..> CommandLogFns : add, fail
TelemetryIngestor ..> CommandLogFns : acknowledge
BikeState "1" *-- "0..5" CommandEntry
CommandLog ..> view
CommandLog ..> BikeState : reads the live state
CommandFeedbackService ..> BikeState : reads the live state
@enduml
