@startuml
title UML sequence behaviour — Send, acknowledge or fail a resistance command
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — @wattzup/browser" #ECFDF3
  participant "WorkoutEngine" as eng
  participant "ResistanceCommander" as cmdr
  participant "command-log" as cl
  participant "TelemetryIngestor" as ing
  participant "BikeStateStore" as store
end box
box "Frontend — @wattzup/browser lib/bluetooth" #FFF4E5
  participant "BikeLink" as conn
end box
participant "Echelon bike" as bike

eng -> cmdr : send(18, plan) at ride time 7:01
alt no GATT link
  cmdr -> cl : add(entry 18, status failed)
  cmdr -> store : update(commands) [L2-048]
  cmdr --> eng : not-connected
else connected
  cmdr -> cl : add({at, ride_seconds 421, level 18, plan, sending, ack_ms null})
  cl --> cmdr : 5 newest, newest first [L2-048]
  cmdr -> store : update(commands)
  cmdr -> conn : write(F0 B1 01 12 B4) with response
  alt write throws
    conn --> cmdr : exception
    cmdr -> cl : fail(entry)
    cmdr -> store : update(commands: entry failed) [L2-048]
    cmdr --> eng : failed(message)
  else written
    conn -> bike : write request
    bike --> conn : write response
    cmdr --> eng : sent
    bike -> conn : notify F0 D2 01 12 D5 (40 ms after the write)
    conn -> ing : onNotify(frame)
    ing -> cl : acknowledge(level 18, now)
    cl -> cl : walk newest first; ack each sending 18; stop at first other level [L2-048]
    cl --> ing : entry status ack, ack_ms 40
    ing -> store : update(resistance 18, commands) in one change
  end
end
note over cl : 22 written before 18 is acknowledged: a report of 22 acks 22 and stops; 18 stays sending [L2-048]
@enduml
