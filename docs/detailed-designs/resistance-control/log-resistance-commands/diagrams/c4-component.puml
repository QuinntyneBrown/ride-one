@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Log resistance commands

Person(rider, "Rider", "Watches the dashboard")
Container_Boundary(web, "Wattzup Web") {
  Component(live, "LiveStateService", "Angular service", "Read-only state signal")
  Component(log, "CommandLog", "Angular component", "Sent to bike panel (cmd-log)")
  Component(view, "command-log-view", "Pure helper (core)", "Ride time and status text")
  Component(fb, "CommandFeedbackService", "Angular service", "Success and slow-confirm toasts")
  Component(toast, "ToastService", "Angular service", "Shows toasts (dashboard)")
}
Container_Boundary(lib, "@wattzup/browser") {
  Component(eng, "WorkoutEngine", "@wattzup/browser lib/engine", "Sends plan and manual levels")
  Component(cmdr, "ResistanceCommander", "@wattzup/browser lib/engine", "Adds entries, marks failures")
  Component(ing, "TelemetryIngestor", "@wattzup/browser lib/engine", "Acknowledges on resistance frames")
  Component(cl, "command-log", "@wattzup/browser lib/engine", "Pure add / fail / acknowledge")
  Component(store, "BikeStateStore", "@wattzup/browser lib/engine", "Only writer of BikeState.commands")
  Component(src, "BrowserStateSource", "LIVE_STATE_SOURCE", "Forwards each new state")
}
System_Ext(bike, "Echelon bike", "Proprietary BLE GATT service")

Rel(eng, cmdr, "send(level, source)")
Rel(cmdr, cl, "add, fail")
Rel(cmdr, store, "update(commands)")
Rel(cmdr, bike, "Write with response", "Web Bluetooth GATT")
Rel(bike, ing, "0xD2 resistance frame", "Web Bluetooth GATT")
Rel(ing, cl, "acknowledge(level, now)")
Rel(ing, store, "update(resistance, commands)")
Rel(store, src, "New state")
Rel(src, live, "BikeState")
Rel(log, live, "Reads state()")
Rel(log, view, "Formats entries")
Rel(fb, live, "effect on state().commands")
Rel(fb, toast, "Success / warning toast")
Rel(rider, log, "Reads")
@enduml
