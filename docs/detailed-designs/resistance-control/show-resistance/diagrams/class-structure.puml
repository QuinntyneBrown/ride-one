@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show resistance

package "frontend" {
  class LiveStateService <<service>> {
    +Signal<BikeState | null> state
  }
  class "resistance-view.ts" as view <<pure>> {
    +resistanceView(state: BikeState | null): ResistanceView
  }
  class ResistanceView <<interface>> {
    +string valueText
    +string | null settingText
    +number litUpTo
    +number | null pressedLevel
    +number | null planLevel
  }
  class LevelReadout <<component>> {
    +Signal<ResistanceView> view
  }
  class LevelPicker <<component>> {
    +Signal<ResistanceView> view
    +isLit(level: number): boolean
    +isPressed(level: number): boolean
    +isPlan(level: number): boolean
  }
  class BikeState <<generated>> {
    +resistance: number | null
    +target_resistance: number | null
    +workout: Workout | null
  }
  class Workout <<generated>> {
    +mode: "plan" | "manual"
    +plan_level: number
  }
}

view ..> ResistanceView : returns
view ..> BikeState : reads
BikeState --> Workout
LevelReadout --> LiveStateService
LevelPicker --> LiveStateService
LevelReadout ..> view
LevelPicker ..> view
@enduml
