@startuml
title UML sequence behaviour — Pending then confirmed resistance target
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "LiveStateService" as live
  participant "resistanceView" as view
  participant "LevelReadout" as readout
  participant "LevelPicker" as picker
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserStateSource" as src
end box

src -> live : state {resistance:18, target_resistance:22, workout:{mode:"manual", plan_level:18}}
live -> view : state() changes
view --> live : valueText "18", settingText "Setting 22…", litUpTo 18, pressed 22, plan 18 [L2-019]
live -> readout : computed view
readout --> rider : 18 of 32, Setting 22… (role=status)
live -> picker : computed view
picker --> rider : levels 1–18 is-lit, level 22 aria-pressed, level 18 is-plan
src -> live : state {resistance:22, target_resistance:22, workout:{mode:"manual", plan_level:18}}
live -> view : state() changes
view --> live : valueText "22", settingText null, litUpTo 22, pressed 22, plan 18 [L2-019]
live -> readout : computed view
readout --> rider : 22 of 32, no Setting text
live -> picker : computed view
picker --> rider : levels 1–22 is-lit, level 22 aria-pressed, level 18 is-plan
@enduml
