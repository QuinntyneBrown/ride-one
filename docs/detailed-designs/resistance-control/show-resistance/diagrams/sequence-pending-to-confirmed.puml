@startuml
title UML sequence behaviour — Pending then confirmed resistance target
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "LiveStateService" as live
  participant "ResistanceCard" as card
  participant "ResistanceBar" as bar
end box
box "Backend — Wattzup API application" #D1FADF
  participant "EventsEndpoints" as sse
end box

sse -> live : data: {resistance:12, target_resistance:20, ...}
live -> card : state() changes
card -> card : valueText = "12"; barPercent = 37.5
card -> card : targetLabel = "setting 20…"; markerPercent = 62.5 [L2-019]
card -> bar : percent 37.5, marker 62.5
bar --> rider : bar at 37.5 %, marker at 62.5 %
sse -> live : data: {resistance:20, target_resistance:20, ...}
live -> card : state() changes
card -> card : valueText = "20"; barPercent = 62.5
card -> card : targetLabel = "target 20 ✓" [L2-019]
card -> bar : percent 62.5, marker 62.5
bar --> rider : bar meets marker, label confirms
@enduml
