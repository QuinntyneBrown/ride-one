@startuml
title UML sequence behaviour — Set resistance from the panel
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "LevelControl" as ctl
  participant "ResistanceCommandService" as svc
  participant "ToastService" as toast
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserBikeApi" as api
  participant "WorkoutEngine" as eng
  participant "ResistanceCommander" as cmdr
  participant "echelon-commands" as cmds
  participant "BikeStateStore" as store
  participant "BikeLink" as link
end box
participant "Echelon bike" as bike

rider -> ctl : Press Raise resistance (bike reports 10)
ctl -> ctl : stepLevel(state, +1) = 11 [L2-020]
ctl -> svc : set(11)
svc -> api : setResistance(11)
alt level not an integer in 1-32
  api --> svc : ContractError invalid_level [L2-016]
else valid
  api -> eng : setManual(11)
  eng -> cmdr : send(11, manual)
  alt no GATT link
    cmdr -> store : update(commands + failed entry)
    cmdr --> eng : not-connected (nothing written) [L2-008]
    eng --> api : not-connected (mode unchanged)
    api --> svc : ContractError bike_not_connected [L2-016]
  else connected
    cmdr -> cmds : setResistance(11)
    cmds --> cmdr : F0 B1 01 0B AD [L2-008]
    cmdr -> link : write(bytes) with response, one write at a time
    link -> bike : write request
    bike --> link : write response
    cmdr -> store : update(target_resistance = 11) [L2-009]
    cmdr --> eng : sent
    opt workout active
      eng -> store : update(workout.mode = manual, plan_level unchanged) [L2-047]
    end
    eng --> api : sent
    api --> svc : resolves
  end
end
alt bike_not_connected
  svc -> toast : danger "Couldn't set resistance" / "The bike isn't connected. Pedal to wake it, then try again." [L2-020]
else any other failure
  svc -> toast : danger "The bike didn't take it. Level 11 was not set." + Retry [L2-020]
  rider -> toast : Retry
  toast -> svc : set(11)
end
bike -> link : notify F0 D2 01 0B CE (resistance, see decode-bike-telemetry)
@enduml
