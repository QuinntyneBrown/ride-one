@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Set resistance

package "wattzup app" {
  class LevelControl <<component>> {
    +controls: Signal<ControlsState>
    +lower(): void
    +raise(): void
  }
  class LevelPicker <<component>> {
    +controls: Signal<ControlsState>
    +choose(level: number): void
  }
  class PlanNote <<component>> {
    +note: Signal<string>
    +showBackToPlan: Signal<boolean>
    +backToPlan(): void
  }
  class "resistance-controls.ts" as helpers <<pure>> {
    +baseLevel(state: BikeState): number | null
    +stepLevel(state: BikeState, delta: -1 | 1): number
    +controlsState(state: BikeState): ControlsState
    +planNote(state: BikeState): string
  }
  class ResistanceCommandService <<service>> {
    +set(level: number): Promise<void>
    +backToPlan(): Promise<void>
  }
}

package "@wattzup/api" {
  interface BikeApi <<token BIKE_API>> {
    +setResistance(level: number): Promise<void>
    +reconnect(): Promise<void>
  }
  interface WorkoutApi <<token WORKOUT_API>> {
    +backToPlan(): Promise<void>
  }
  class ContractError {
    +code: string
  }
}

package "@wattzup/browser" {
  class BrowserBikeApi
  class BrowserWorkoutApi
  class WorkoutEngine {
    -run: WorkoutRun | null
    +setManual(level: number): Promise<SendResult>
    +backToPlan(): Promise<WorkoutSnapshot | null>
  }
  class WorkoutRun {
    +mode: 'plan' | 'manual'
    +planLevel: number
  }
  class ResistanceCommander {
    -queue: Promise<unknown>
    +send(level, source, rideSeconds): Promise<SendResult>
  }
  class SendResult <<union>> {
    sent | not-connected | failed(message)
  }
  class "echelon-commands" as EchelonCommands <<module>> {
    +setResistance(level: number): Uint8Array
    +checksum(bytes: Uint8Array): number
  }
}

LevelControl ..> helpers
LevelPicker ..> helpers
PlanNote ..> helpers
LevelControl --> ResistanceCommandService
LevelPicker --> ResistanceCommandService
PlanNote --> ResistanceCommandService
ResistanceCommandService --> BikeApi
ResistanceCommandService --> WorkoutApi
ResistanceCommandService ..> ContractError : branches on code
BrowserBikeApi ..|> BikeApi
BrowserWorkoutApi ..|> WorkoutApi
BrowserBikeApi --> WorkoutEngine
BrowserWorkoutApi --> WorkoutEngine
WorkoutEngine "1" *-- "0..1" WorkoutRun
WorkoutEngine --> ResistanceCommander
ResistanceCommander ..> EchelonCommands
ResistanceCommander ..> SendResult : returns
@enduml
