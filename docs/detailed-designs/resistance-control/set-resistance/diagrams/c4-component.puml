@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Set resistance

Person(rider, "Rider", "Adjusts resistance")
Container_Boundary(web, "Wattzup Web") {
  Component(ctl, "LevelControl", "Angular component", "Lower and Raise stepper")
  Component(pick, "LevelPicker", "Angular component", "32 level buttons")
  Component(note, "PlanNote", "Angular component", "Plan note and Back to plan")
  Component(svc, "ResistanceCommandService", "Angular service", "Sends levels, maps failures to toasts")
  Component(toast, "ToastService", "Angular service", "Shows toasts (dashboard)")
  Component(api, "BikeApi", "Angular service behind BIKE_API", "Typed HTTP client")
}
Container_Boundary(be, "Wattzup API") {
  Component(ep, "ResistanceEndpoints", "Minimal API", "POST /api/resistance")
  Component(wep, "WorkoutEndpoints", "Minimal API", "POST /api/workout/back-to-plan")
  Component(ctrl, "IResistanceControl", "Wattzup.Core", "Hands manual levels to the engine")
  Component(eng, "WorkoutEngine", "Wattzup.Core", "Owns mode and plan_level")
  Component(cmdr, "ResistanceCommander", "Wattzup.Core", "Serialised resistance writes")
  Component(cmds, "EchelonCommands", "Wattzup.Protocol", "SetResistance and Checksum")
  Component(reg, "ActiveConnectionRegistry", "Wattzup.Core", "Current IBikeConnection")
  Component(store, "BikeStateStore", "Wattzup.Core", "Only writer of BikeState")
}
System_Ext(bike, "Echelon bike", "Proprietary BLE GATT service")

Rel(rider, ctl, "Presses Lower or Raise")
Rel(rider, pick, "Chooses a level")
Rel(rider, note, "Presses Back to plan")
Rel(ctl, svc, "send(level)")
Rel(pick, svc, "send(level)")
Rel(svc, api, "setResistance(level)")
Rel(svc, toast, "Danger toast on 503 or timeout")
Rel(note, api, "backToPlan()")
Rel(api, ep, "POST {level}", "JSON/HTTP")
Rel(api, wep, "POST", "JSON/HTTP")
Rel(ep, ctrl, "SetManualAsync(level)")
Rel(wep, eng, "BackToPlan")
Rel(ctrl, eng, "ManualLevel(level)")
Rel(eng, cmdr, "SendAsync(level, source)")
Rel(eng, store, "Update(workout.mode)")
Rel(cmdr, cmds, "SetResistance(level)")
Rel(cmdr, reg, "Reads current connection")
Rel(cmdr, store, "Update(target_resistance)")
Rel(cmdr, bike, "Write with response", "BLE GATT")
@enduml
