@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Set resistance

Person(rider, "Rider", "Adjusts resistance")
Container_Boundary(web, "Wattzup Web") {
  Component(ctl, "LevelControl", "Angular component", "Lower and Raise stepper")
  Component(pick, "LevelPicker", "Angular component", "32-level slider")
  Component(note, "PlanNote", "Angular component", "Plan note and Back to plan")
  Component(svc, "ResistanceCommandService", "Angular service", "Sends levels, maps failures to toasts")
  Component(toast, "ToastService", "Angular service", "Shows toasts (dashboard)")
  Component(bapi, "BrowserBikeApi", "BIKE_API, @wattzup/browser", "Validates the level")
  Component(wapi, "BrowserWorkoutApi", "WORKOUT_API, @wattzup/browser", "backToPlan()")
  Component(eng, "WorkoutEngine", "lib/engine", "Owns mode and plan_level")
  Component(cmdr, "ResistanceCommander", "lib/engine", "Queued resistance writes")
  Component(cmds, "echelon-commands", "lib/protocol", "setResistance and checksum")
  Component(link, "BikeLink", "lib/bluetooth", "Current GATT link")
  Component(store, "BikeStateStore", "lib/engine", "Only writer of BikeState")
}
System_Ext(bike, "Echelon bike", "Proprietary BLE GATT service")

Rel(rider, ctl, "Presses Lower or Raise")
Rel(rider, pick, "Chooses a level")
Rel(rider, note, "Presses Back to plan")
Rel(ctl, svc, "set(level)")
Rel(pick, svc, "set(level)")
Rel(note, svc, "backToPlan()")
Rel(svc, bapi, "setResistance(level)")
Rel(svc, wapi, "backToPlan()")
Rel(svc, toast, "Danger toast on failure")
Rel(bapi, eng, "setManual(level)")
Rel(wapi, eng, "backToPlan()")
Rel(eng, cmdr, "send(level, source)")
Rel(eng, store, "update(workout.mode)")
Rel(cmdr, cmds, "setResistance(level)")
Rel(cmdr, link, "connection()")
Rel(cmdr, store, "update(target_resistance, commands)")
Rel(link, bike, "Write with response", "Web Bluetooth GATT")
@enduml
