@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Maintain the bike connection

Container_Boundary(api, "Wattzup API") {
  Component(svc, "BikeConnectionService", "BackgroundService", "Keepalive loop and recovery loop")
  Component(reg, "ActiveConnectionRegistry", "Singleton", "Holds the current IBikeConnection or null")
  Component(cmds, "EchelonCommands", "Wattzup.Protocol", "Keepalive bytes")
  Component(store, "BikeStateStore", "Wattzup.Core", "Owns BikeState and raises StateChanged")
  Component(conn, "IBikeConnection", "Wattzup.Ble.Abstractions", "Open GATT link")
}
System_Ext(bike, "Echelon bike", "Proprietary BLE GATT service")

Rel(svc, cmds, "Reads Keepalive")
Rel(svc, conn, "WriteAsync every 1 s")
Rel(svc, reg, "Sets and clears")
Rel(svc, store, "Touch / Update(ble, error)")
Rel(conn, bike, "Write with response", "BLE GATT")
@enduml
