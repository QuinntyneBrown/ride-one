@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Maintain the bike connection

class BikeConnectionService {
  -IBikeTransport transport
  -ActiveConnectionRegistry registry
  -BikeStateStore store
  -ConnectivityOptions options
  #ExecuteAsync(ct): Task
  -RunKeepaliveAsync(conn: IBikeConnection, ct): Task
  -HandleFailure(ex: Exception): void
}

class ActiveConnectionRegistry {
  +IBikeConnection? Current
  +bool IsConnected
  +Set(conn: IBikeConnection): void
  +Clear(): void
}

class ConnectivityOptions {
  +TimeSpan KeepaliveInterval = 1 s
  +TimeSpan ErrorBackoff = 3 s
}

interface IBikeConnection {
  +bool IsConnected
  +event Disconnected
  +WriteAsync(characteristic: Guid, data: byte[], withResponse: bool, ct): Task
}

class EchelonCommands <<static>> {
  +byte[] Keepalive
}

class BikeStateStore {
  +Update(change: Func<BikeState,BikeState>): void
  +Touch(): void
}

BikeConnectionService --> ActiveConnectionRegistry : sets / clears
BikeConnectionService --> BikeStateStore : touches / updates
BikeConnectionService --> ConnectivityOptions
BikeConnectionService ..> IBikeConnection : writes keepalive
BikeConnectionService ..> EchelonCommands
ActiveConnectionRegistry o-- "0..1" IBikeConnection
@enduml
