@startuml
title UML sequence behaviour — Disconnect and exception recovery
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Backend — Wattzup API application" #D1FADF
  participant "BikeConnectionService" as svc
  participant "ActiveConnectionRegistry" as reg
end box
box "Backend — Wattzup Core and Protocol" #ECFDF3
  participant "BikeStateStore" as store
end box
box "Backend — Wattzup Infrastructure (BLE)" #FFF4E5
  participant "IBikeConnection" as conn
end box

alt bike disconnects
  conn --> svc : Disconnected / IsConnected = false
  svc -> reg : Clear()
  svc -> store : Update(ble = disconnected) [L2-004]
  svc -> conn : DisposeAsync()
  svc -> svc : Return to scan step immediately
else exception in scan, connect, init or keepalive
  conn --> svc : throws Exception
  svc -> reg : Clear()
  svc -> store : Update(ble = error, error = "<ExceptionType>: <message>") [L2-004]
  svc -> svc : wait 3 s
  svc -> svc : Return to scan step
else host stopping token cancelled
  svc -> svc : Exit loop (see host-and-structure)
end
@enduml
