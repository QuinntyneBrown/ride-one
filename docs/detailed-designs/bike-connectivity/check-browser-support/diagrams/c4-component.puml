@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Check browser support

Container_Boundary(app, "Wattzup Web") {
  Component(port, "WebBluetoothPort", "@wattzup/browser lib/bluetooth", "Only wrapper over navigator.bluetooth")
  Component(verdict, "supportVerdict()", "Pure function", "ready, insecure, unsupported")
  Component(pairing, "BrowserBikePairing", "BIKE_PAIRING implementation", "support signal, checkAgain()")
  Component(store, "BikeStateStore", "lib/engine", "Holds adapter on or off")
  Component(dash, "Ride Dashboard", "Angular page", "Overlay in place of Connect bike; status line")
  Component(banner, "SupportBanner", "app dashboard", "Banner over Setup and Class page; Start ride disabled")
}
System_Ext(webbt, "Web Bluetooth API", "Browser")

Rel(port, webbt, "Reads isSecureContext, getAvailability, availabilitychanged")
Rel(pairing, port, "Reads support and availability")
Rel(port, verdict, "Calls")
Rel(pairing, store, "Writes adapter to")
Rel(dash, pairing, "Reads support")
Rel(dash, store, "Reads adapter (live state)")
Rel(banner, pairing, "Reads support")
@enduml
