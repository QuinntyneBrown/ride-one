@startuml
title UML sequence behaviour — Decide browser support at start
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "Ride Dashboard" as page
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserBikePairing" as pairing
  participant "WebBluetoothPort" as port
  participant "BikeStateStore" as store
end box
box "Browser — platform" #FFF4E5
  participant "navigator.bluetooth" as nb
end box

rider -> page : Open Wattzup
pairing -> port : support() at start
port -> port : supportVerdict(isSecureContext, navigator.bluetooth)
alt unsupported or insecure [L2-089 AC1, AC3]
  page -> pairing : support()
  page --> rider : Open Wattzup in Chrome or Edge / Open the secure version;\nno Connect bike; classes and rides still readable
else ready
  pairing -> port : availability()
  port -> nb : getAvailability()
  nb --> port : true or false
  pairing -> store : adapter 'on' or 'off'
  alt adapter off [L2-089 AC2]
    page --> rider : Bluetooth · Off; Turn on Bluetooth with Check again
  else adapter on [L2-089 AC4]
    page --> rider : Connect bike, no notice
  end
end
nb -> port : availabilitychanged
port -> pairing : listener(available)
pairing -> store : adapter 'on' or 'off'
@enduml
