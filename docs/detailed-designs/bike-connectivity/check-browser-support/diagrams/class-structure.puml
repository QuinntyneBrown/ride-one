@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Check browser support

enum BluetoothSupport {
  ready
  insecure
  unsupported
}
class SupportEnvironment {
  +isSecureContext: boolean
  +hasBluetooth: boolean
}
class "supportVerdict()" as fn <<pure function>> {
  +(env: SupportEnvironment): BluetoothSupport
}
interface BluetoothPort {
  +support(): BluetoothSupport
  +availability(): Promise<boolean>
  +onAvailabilityChanged(listener): void
  +requestBike(): Promise<BikeDevice | null>
}
class WebBluetoothPort
interface BikePairing {
  +support: Signal<BluetoothSupport>
  +required: Signal<boolean>
  +pair(): Promise<void>
  +checkAgain(): Promise<void>
}
class BrowserBikePairing {
  -port: BluetoothPort
  -store: BikeStateStore
  -setAdapter(available: boolean)
}
class "BIKE_PAIRING default" as ServerBikePairing {
  support: always ready
}
class "supportNotice()" as notice <<pure function>> {
  +(support, pageUrl): SupportNotice | null
}
class SupportBanner <<component>>

WebBluetoothPort ..|> BluetoothPort
BrowserBikePairing ..|> BikePairing
ServerBikePairing ..|> BikePairing
BrowserBikePairing --> BluetoothPort
WebBluetoothPort ..> fn : calls
fn ..> SupportEnvironment
fn ..> BluetoothSupport
SupportBanner ..> BikePairing
SupportBanner ..> notice
@enduml
