@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Bluetooth platform transports

System_Boundary(wattzup, "Wattzup") {
  Container(mac, "Wattzup.Mac", "Wattzup.app bundle (bundle.sh)", "Hosts Wattzup API; Info.plist declares NSBluetoothAlwaysUsageDescription")
  Container(api, "Wattzup API", "ASP.NET Core (.NET LTS)", "Hosted services, REST and SSE endpoints; includes Wattzup.Core and Wattzup.Protocol")
}
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")
System_Ext(bike, "Echelon bike", "Proprietary BLE GATT service")

Rel(mac, api, "Hosts in process")
Rel(api, os, "Scans, connects, subscribes and writes", "IBikeTransport")
Rel(os, bike, "Notifications and commands", "BLE GATT")
@enduml
