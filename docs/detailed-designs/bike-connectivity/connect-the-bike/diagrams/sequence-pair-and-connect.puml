@startuml
title UML sequence behaviour — Pick and connect the bike
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "Ride Dashboard" as dash
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserBikePairing" as pairing
  participant "BikeLink" as link
  participant "BikeStateStore" as store
  participant "WebBluetoothPort" as port
end box
box "Browser — Web Bluetooth" #FFF4E5
  participant "Device chooser" as chooser
  participant "Echelon bike (GATT)" as bike
end box

rider -> dash : Press Connect bike
dash -> pairing : pair()
pairing -> link : pair()
link -> port : requestBike() before any await [L2-090 AC6]
port -> chooser : requestDevice(filters ECH*, service; optionalServices) [L2-090 AC2]
chooser --> rider : List of Echelon devices
alt rider cancels [L2-090 AC4]
  rider -> chooser : Cancel
  chooser --> port : NotFoundError
  port --> link : null
  link --> dash : nothing changes (no toast; ble stays disconnected)
else rider picks the bike
  rider -> chooser : Pick ECHEX-3-141844
  chooser --> port : BluetoothDevice
  port --> link : BikeDevice, now the known bike
  link -> store : ble 'connecting', device = name [L2-090 AC3]
  link -> bike : gatt.connect()
  bike --> link : GattLink
  link -> store : ble 'connected'
  link -> bike : startNotifications(notify characteristic)
  link -> bike : write deviceInfo (with response)
  link -> link : wait 300 ms on Clock
  link -> bike : write resistanceRange (with response)
  link -> link : wait 300 ms on Clock
  link -> bike : write startStream (with response)
  link -> link : start keepalive every 1 s
  pairing --> dash : 'paired'
end
@enduml
