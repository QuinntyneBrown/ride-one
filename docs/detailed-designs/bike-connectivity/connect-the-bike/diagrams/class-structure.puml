@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Connect the bike

interface BluetoothPort {
  +support(): BluetoothSupport
  +availability(): Promise<boolean>
  +onAvailabilityChanged(fn): void
  +requestBike(): Promise<BikeDevice | null>
  +knownBikes(): Promise<BikeDevice[]>
}
interface BikeDevice {
  +name: string
  +connect(): Promise<GattLink>
  +onDisconnected(fn): void
  +whenNearby?(): Promise<void>
}
interface GattLink {
  +startNotifications(onPacket: (bytes: Uint8Array) => void): Promise<void>
  +write(bytes: Uint8Array): Promise<void>
  +disconnect(): void
}
interface Clock {
  +now(): number
  +epochMs(): number
  +delay(ms: number): Promise<void>
}
class WebBluetoothPort
class BikeLink {
  -device: Signal<BikeDevice | null>
  -gatt: GattLink | null
  -generation: number
  +pairingRequired: Signal<boolean>
  +connection(): GattLink | null
  +pair(): Promise<void>
  +reconnectKnown(): Promise<void>
  +reconnect(): Promise<ReconnectResult>
  -connect(device): Promise<void>
  -dropped(): void
  -fail(device, e): void
  -keepAlive(gatt, attempt): Promise<void>
}
class EchelonCommands <<lib/protocol>> {
  +deviceInfo: Uint8Array
  +resistanceRange: Uint8Array
  +startStream: Uint8Array
  +keepalive: Uint8Array
  +setResistance(level): Uint8Array
}
class BrowserBikePairing {
  +required: Signal<boolean>
  +support: Signal<BluetoothSupport>
  +pair(): Promise<void>
  +checkAgain(): Promise<void>
}
class BrowserBikeApi {
  +reconnect(): Promise<void>
}
class BikeStateStore {
  +update(fn: (s: BikeState) => BikeState): void
  +touch(): void
}

WebBluetoothPort ..|> BluetoothPort
BluetoothPort ..> BikeDevice : returns
BikeDevice ..> GattLink : returns
BikeLink --> BluetoothPort
BikeLink --> "0..1" BikeDevice : known bike
BikeLink --> Clock
BikeLink ..> EchelonCommands
BikeLink --> BikeStateStore
BrowserBikePairing --> BluetoothPort
BrowserBikePairing --> BikeLink
BrowserBikeApi --> BikeLink
@enduml
