@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Connect the bike in the browser

Person(rider, "Rider", "Rides")
System_Boundary(browser, "Rider's browser (Chrome or Edge)") {
  Container(app, "Wattzup Web, browser edition", "Angular + @wattzup/browser", "BikeLink, state store, engine")
  Container(chooser, "Device chooser", "Browser UI", "Lists matching devices; needs user activation")
  Container(webbt, "Web Bluetooth stack", "navigator.bluetooth", "GATT client")
}
System_Ext(bike, "Echelon bike", "BLE")

Rel(rider, app, "Presses Connect bike")
Rel(app, chooser, "requestDevice(filters)")
Rel(rider, chooser, "Picks the bike")
Rel(app, webbt, "connect, startNotifications, writeValueWithResponse")
Rel(webbt, bike, "GATT", "BLE")
@enduml
