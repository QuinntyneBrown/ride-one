@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Discover and connect the bike

class BikeConnectionService {
  -IBikeTransport transport
  -BikeStateStore store
  -ConnectivityOptions options
  -ILogger logger
  #ExecuteAsync(ct: CancellationToken): Task
  -ScanAsync(ct): Task<BikeAdvertisement?>
  -InitialiseAsync(conn: IBikeConnection, ct): Task
}

class ConnectivityOptions {
  +TimeSpan ScanTimeout = 20 s
  +TimeSpan InitCommandSpacing = 300 ms
  +TimeSpan ErrorBackoff = 3 s
}

interface IBikeTransport {
  +ScanAsync(filter: Func<BikeAdvertisement,bool>, timeout: TimeSpan, ct): Task<BikeAdvertisement?>
  +ConnectAsync(ad: BikeAdvertisement, ct): Task<IBikeConnection>
}

interface IBikeConnection {
  +bool IsConnected
  +event Disconnected
  +SubscribeAsync(characteristic: Guid, onNotify: Action<ReadOnlyMemory<byte>>, ct): Task
  +WriteAsync(characteristic: Guid, data: byte[], withResponse: bool, ct): Task
  +DisposeAsync(): ValueTask
}

class BikeAdvertisement <<record>> {
  +string? Name
  +string Address
  +IReadOnlyList<Guid> ServiceUuids
  +string DisplayName
}

class EchelonDeviceFilter <<static>> {
  +IsEchelon(ad: BikeAdvertisement): bool
}

class EchelonUuids <<static>> {
  +Guid Service
  +Guid WriteCharacteristic
  +Guid NotifyCharacteristic
}

class EchelonCommands <<static>> {
  +byte[] DeviceInfo
  +byte[] ResistanceRange
  +byte[] StartDataStream
  +IReadOnlyList<byte[]> InitSequence
}

class BikeStateStore {
  +BikeState Current
  +event StateChanged
  +Update(change: Func<BikeState,BikeState>): void
}

enum BleStatus {
  Starting
  Scanning
  Connecting
  Connected
  Disconnected
  Error
}

class BluetoothUnavailableException

BikeConnectionService --> IBikeTransport : uses
BikeConnectionService --> BikeStateStore : updates
BikeConnectionService --> ConnectivityOptions : configured by
BikeConnectionService ..> EchelonDeviceFilter : scan predicate
BikeConnectionService ..> EchelonCommands : init sequence
IBikeTransport ..> IBikeConnection : creates
IBikeTransport ..> BikeAdvertisement : returns
IBikeTransport ..> BluetoothUnavailableException : throws
EchelonDeviceFilter ..> EchelonUuids : reads Service
BikeStateStore --> BleStatus : state.ble
@enduml
