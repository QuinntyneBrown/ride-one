@startuml
title UML sequence behaviour — Scan, connect and initialise the bike
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Backend — Wattzup API application" #D1FADF
  participant "BikeConnectionService" as svc
end box
box "Backend — Wattzup Core and Protocol" #ECFDF3
  participant "EchelonDeviceFilter" as filter
  participant "EchelonCommands" as cmds
  participant "BikeStateStore" as store
end box
box "Backend — Wattzup Infrastructure (BLE)" #FFF4E5
  participant "IBikeTransport" as transport
  participant "IBikeConnection" as conn
end box
participant "Echelon bike" as bike

loop until a device is found
  svc -> store : Update(ble = scanning, error = null) [L2-001]
  svc -> transport : ScanAsync(IsEchelon, 20 s)
  svc -> store : Update(adapter = on) once the scan starts
  transport -> filter : IsEchelon(advertisement) per device
  filter --> transport : name starts with ECH or service UUID present
  alt no match within 20 s
    transport --> svc : null
    svc -> store : Update(error = "No Echelon bike found yet — pedal to wake it up")
  else match
    transport --> svc : BikeAdvertisement
  end
end
svc -> store : Update(ble = connecting, device = DisplayName) [L2-002]
store -> store : StateDerivations: device_label = Bike:DisplayName ?? device
svc -> transport : ConnectAsync(advertisement)
transport -> bike : GATT connect
bike --> transport : connected
transport --> svc : IBikeConnection
svc -> store : Update(ble = connected)
svc -> conn : SubscribeAsync(NotifyCharacteristic, onNotify)
conn -> bike : enable notifications
svc -> cmds : InitSequence
cmds --> svc : [F0 A1 00 91, F0 A3 00 93, F0 B0 01 01 A2]
loop each init command, in order
  svc -> conn : WriteAsync(WriteCharacteristic, cmd, withResponse: true)
  conn -> bike : write request
  bike --> conn : write response
  svc -> svc : wait 300 ms [L2-002]
end
note over svc : Hand-off to maintain-bike-connection (keepalive loop)
@enduml
