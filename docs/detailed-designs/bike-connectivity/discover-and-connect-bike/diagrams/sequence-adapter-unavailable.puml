@startuml
title UML sequence behaviour — Start-up without a Bluetooth adapter
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "LiveStateService" as live
end box
box "Backend — Wattzup API application" #D1FADF
  participant "Kestrel host" as host
  participant "BikeConnectionService" as svc
end box
box "Backend — Wattzup Core and Protocol" #ECFDF3
  participant "BikeStateStore" as store
end box
box "Backend — Wattzup Infrastructure (BLE)" #FFF4E5
  participant "IBikeTransport" as transport
end box

host -> host : Start HTTP listener on 127.0.0.1:8787
host -> svc : StartAsync (non-blocking)
note over store : HostFacts set transport = "CoreBluetooth", simulated = false
loop until the adapter is available
  svc -> transport : ScanAsync(...)
  transport --> svc : throws BluetoothUnavailableException
  svc -> store : Update(ble = error, adapter = off,\n error = "BluetoothUnavailableException: <message>") [L2-039]
  svc -> svc : wait 3 s (TimeProvider)
end
rider -> live : Open dashboard
live -> host : GET /api/events
host --> live : first event: ble = error, adapter = off
live --> rider : Status line "Bluetooth · Off", banner and overlay (see dashboard)
transport --> svc : AdapterStateChanged(On)
svc -> store : Update(adapter = on)
svc -> transport : ScanAsync(IsEchelon, 20 s)
svc -> store : Update(ble = scanning, error = null) [L2-001]
host --> live : data: ble = scanning, adapter = on
live --> rider : Bluetooth-off banner and overlay clear
@enduml
