@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — List nearby machines

Person(rider, "Rider", "Picks a machine")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular", "Machine page; reads nearby from the live state")
  Container(api, "Wattzup API", "ASP.NET Core (.NET LTS)", "Scan loop, NearbyMachines, SSE; includes Wattzup.Core and Wattzup.Protocol")
}
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")

Rel(rider, web, "Uses", "HTTPS")
Rel(web, api, "Reads nearby", "SSE /api/events")
Rel(api, os, "Scans, reading name, services and RSSI", "IBikeTransport")
@enduml
