@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — List nearby machines

Person(rider, "Rider", "Picks the bike or the treadmill on the machine page")
System(wattzup, "Wattzup", "Live training display for an Echelon bike or treadmill")
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")
System_Ext(bike, "Echelon bike", "Advertises the Echelon service")
System_Ext(treadmill, "Echelon Stride", "Advertises STRIDE and the treadmill service")

Rel(rider, wattzup, "Sees nearby machines and their signal in", "Browser")
Rel(wattzup, os, "Scans through")
Rel(bike, os, "Advertises to", "BLE")
Rel(treadmill, os, "Advertises to", "BLE")
@enduml
