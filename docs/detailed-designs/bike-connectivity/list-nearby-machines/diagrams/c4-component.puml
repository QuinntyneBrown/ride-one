@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — List nearby machines

Container_Boundary(api, "Wattzup API") {
  Component(svc, "BikeConnectionService", "Hosted service", "Scans for the chosen machine; holds its entry while connected")
  Component(filter, "NearbyFilter", "Wattzup.Core", "Records both machines, accepts only the chosen one")
  Component(bikeF, "EchelonDeviceFilter", "Wattzup.Protocol", "The bike's filter (L2-001)")
  Component(trF, "EchelonTreadmillFilter", "Wattzup.Protocol", "The treadmill's filter (L2-063)")
  Component(nearby, "NearbyMachines", "Wattzup.Core", "Heard, Hold, Release, Expire; flushes once a second")
  Component(bars, "SignalBars", "Wattzup.Core", "RSSI to 0–4 bars")
  Component(store, "BikeStateStore", "Wattzup.Core", "Only writer of BikeState; broadcasts")
  Component(transport, "IBikeTransport", "Wattzup.Ble.Abstractions", "ScanAsync calls the filter per advertisement")
}

Rel(svc, transport, "ScanAsync(filter, 20 s)")
Rel(transport, filter, "Calls with each BikeAdvertisement")
Rel(filter, bikeF, "Matches(name, uuids)")
Rel(filter, trF, "Matches(name, uuids)")
Rel(filter, nearby, "Heard(machine, advertisement)")
Rel(svc, nearby, "Hold / Release the chosen machine")
Rel(nearby, bars, "FromRssi(rssi)")
Rel(nearby, store, "Update(nearby), at most once a second")
@enduml
