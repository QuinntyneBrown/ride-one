@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Simulate the bike

Container_Boundary(app, "Wattzup Web") {
  Component(provide, "provideBrowserContracts()", "@wattzup/browser", "Binds BluetoothPort by isDevMode() and ?simulate")
  Component(link, "BikeLink", "lib/bluetooth", "Same in every mode")
  Component(web, "WebBluetoothPort", "lib/bluetooth", "Production and specs")
  Component(sim, "SimulatedBluetoothPort", "lib/bluetooth", "ECHSIM-0001; dev builds only")
  Component(clock, "Clock", "lib/bluetooth", "Drives the simulator's frames")
}
Container_Boundary(fx, "Playwright fixtures") {
  Component(fake, "fake-bluetooth.ts", "Init script", "Scripted navigator.bluetooth; records writes")
  Component(wzb, "browser-test.ts", "Fixture", "test and expect for the specs")
}
Rel(provide, web, "Binds in production or without ?simulate")
Rel(provide, sim, "Binds when isDevMode() and ?simulate")
Rel(link, web, "Uses")
Rel(link, sim, "Uses")
Rel(sim, clock, "Frames every 1 s")
Rel(web, fake, "Calls, under test")
Rel(wzb, fake, "Installs")
@enduml
