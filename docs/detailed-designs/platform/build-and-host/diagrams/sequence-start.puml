@startuml
title UML sequence behaviour — Start Wattzup
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Hosting — Static host" #FFF4E5
  participant "Static host" as host
end box
box "Frontend — Wattzup Web" #E0F2FE
  participant "Service worker" as sw
  participant "Angular bootstrap\n(app.config.ts)" as boot
  participant "LiveStateService" as live
  participant "Ride Dashboard" as page
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserStateSource" as src
  participant "BikeStateStore" as rt
end box

rider -> sw : Open https://<host>/
alt first visit or online
  sw -> host : GET index.html, chunks, classes.json
  host --> sw : Static files
else offline after a first visit [L2-098 AC1]
  sw -> sw : Serve from cache
end
sw --> boot : index.html with CSP meta [L2-097 AC2]
boot -> boot : provideBrowserContracts()
boot -> live : create
live -> src : ensureStarted()
src -> rt : read state()
rt --> src : initial BikeState (ble 'disconnected')
src --> live : state signal (BikeState)
live --> page : state signal
page --> rider : Dashboard with Connect bike [no request to another origin, L2-088 AC2]
@enduml
