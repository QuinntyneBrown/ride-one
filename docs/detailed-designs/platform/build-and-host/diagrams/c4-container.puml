@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Build and host Wattzup

Person(rider, "Rider", "Rides the bike")
System_Ext(host, "Static host", "Serves files over HTTPS")
System_Boundary(browser, "Rider's browser (Chrome or Edge)") {
  Container(app, "Wattzup Web", "Angular, app.config.ts", "Screens, in-browser contracts, workout engine")
  Container(sw, "Service worker", "@angular/service-worker", "Caches the app shell and classes.json; offline start")
  ContainerDb(idb, "Wattzup database", "IndexedDB", "Sessions and the ride journal")
}
System_Ext(bike, "Echelon bike", "BLE")
System_Ext(youtube, "YouTube", "Player and thumbnails")

Rel(rider, app, "Uses", "Touch, keyboard")
Rel(host, sw, "Delivers static files to", "HTTPS")
Rel(sw, app, "Serves cached files to")
Rel(app, idb, "Reads and writes")
Rel(app, bike, "Connects to", "Web Bluetooth")
Rel(app, youtube, "Embeds", "HTTPS, CSP-limited")
@enduml
