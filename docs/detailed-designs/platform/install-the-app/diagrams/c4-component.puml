@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Install the app

Container(host, "Static host", "HTTPS", "manifest.webmanifest, ngsw.json, build")
Container_Boundary(app, "Ride app") {
  Component(manifest, "manifest.webmanifest", "Web app manifest · ride/public", "Name, icons, theme colour, standalone")
  Component(sw, "Angular service worker", "ngsw-worker.js", "Version checks and caches")
  Component(swupdate, "SwUpdate", "@angular/service-worker", "versionUpdates, activateUpdate")
  Component(prompt, "UpdatePrompt", "Root service · ride", "Offers the reload outside a ride")
  Component(activity, "RideActivity", "Root service · ride", "inProgress signal")
  Component(toast, "Toast", "Presentation component · components", "Message and Reload action")
  Component(pages, "Ride pages", "Angular pages · ride", "Set and clear inProgress")
}
Rel(sw, host, "Fetches ngsw.json from")
Rel(swupdate, sw, "Talks to")
Rel(prompt, swupdate, "Listens to VERSION_READY")
Rel(prompt, activity, "Reads inProgress")
Rel(pages, activity, "Sets")
Rel(prompt, toast, "Shows")
@enduml
