@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Workspace projects

Container_Boundary(ws, "frontend/ Angular workspace") {
  Component(app, "wattzup", "Application", "Pages, dialogs, core services and helpers; app.config.ts")
  Component(root, "app.config.ts", "Composition root", "Binds every contract token")
  Component(components, "@wattzup/components", "Library", "Presentation components and design-system partials")
  Component(browser, "@wattzup/browser", "Library", "Contract implementations, Web Bluetooth, protocol, engine, IndexedDB")
  Component(api, "@wattzup/api", "Library", "Contracts, tokens, contract types (schema.d.ts)")
}

Rel(app, components, "Imports")
Rel(app, api, "Injects tokens of")
Rel(root, browser, "provideBrowserContracts() (only importer)")
Rel(app, root, "Bootstraps with")
Rel(components, api, "Types only")
Rel(browser, api, "Implements")
@enduml
