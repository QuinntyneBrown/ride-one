@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Workspace structure

Person(rider, "Rider", "Rides and watches")
System_Boundary(browser, "Rider's browser (Chrome or Edge)") {
  Container(app, "Wattzup Web", "Angular + @wattzup/browser", "The wattzup application and its libraries")
  ContainerDb(db, "IndexedDB", "Database wattzup", "Sessions and the ride journal")
  Container(webbt, "Web Bluetooth stack", "navigator.bluetooth", "GATT client")
}
System_Ext(bike, "Echelon bike", "BLE GATT")
System_Ext(youtube, "YouTube", "IFrame player and thumbnails")

Rel(rider, app, "Uses")
Rel(app, db, "Reads and writes")
Rel(app, webbt, "connect, notify, write")
Rel(webbt, bike, "GATT", "BLE")
Rel(app, youtube, "Embeds", "HTTPS, CSP-limited")
@enduml
