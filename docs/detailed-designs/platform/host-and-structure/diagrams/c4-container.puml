@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Host and solution structure

Person(rider, "Rider", "Rides the bike and watches the dashboard")
System_Boundary(wattzup, "Wattzup") {
  Container(web, "Wattzup Web", "Angular SPA", "Ride dashboard, setup, unlock and not-found pages in the browser; bundled fonts")
  Container(mac, "Wattzup.Mac", "Wattzup.app bundle (bundle.sh)", "Hosts the Wattzup API on macOS with NSBluetoothAlwaysUsageDescription")
  Container(api, "Wattzup API", "ASP.NET Core (net10.0)", "Hosted services, REST and SSE endpoints; includes Wattzup.Core and Wattzup.Protocol")
  ContainerDb(files, "Local files", "File system", "raw_packets.log, status.json")
}
System_Ext(os, "OS Bluetooth stack", "CoreBluetooth / BlueZ / WinRT")
System_Ext(bike, "Echelon bike", "Proprietary BLE GATT service")

Rel(rider, web, "Uses", "HTTP / localhost")
Rel(web, api, "Calls REST and subscribes to SSE", "JSON/HTTP, same origin")
Rel(mac, api, "Hosts in process")
Rel(api, files, "Appends and writes")
Rel(api, os, "Scans, connects, subscribes and writes", "IBikeTransport")
Rel(os, bike, "Notifications and commands", "BLE GATT")
@enduml
