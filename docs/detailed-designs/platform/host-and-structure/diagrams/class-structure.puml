@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Host composition

package "Wattzup.Api" {
  class Program <<static>> {
    +Main(args: string[]): Task
  }
  class WattzupOptions {
    +string Urls = "http://127.0.0.1:8787"
    +SecurityOptions Security
    +CorsOptions Cors
    +BleOptions Ble
    +BikeOptions Bike
    +RawPacketLogOptions RawPacketLog
    +StatusSnapshotOptions StatusSnapshot
  }
  class BikeOptions {
    +string? DisplayName
  }
  abstract class BackgroundService {
    #ExecuteAsync(ct): Task
  }
  class BikeConnectionService
  class WorkoutEngineHost
  class RawPacketLogWriter
  class StatusSnapshotWriter
  class StateChangeLogger
  class EndpointGroups <<static>> {
    +MapStatus / MapEvents / MapResistance
    +MapWorkout / MapDiagnostics / MapHealth
  }
}
package "Wattzup.Core" {
  class BikeStateStore <<singleton>>
  class StateBroadcaster <<singleton>>
  class ActiveConnectionRegistry <<singleton>>
}
package "Wattzup.Mac" {
  class AppDelegate {
    +DidFinishLaunching(): void
    +WillTerminate(): void
  }
}
package "frontend/projects/wattzup" {
  class appConfig <<ApplicationConfig>> {
    +provideZonelessChangeDetection()
    +provideRouter(routes)
    +provideHttpClient(withInterceptors([apiKeyInterceptor]))
    +BIKE_API -> HttpBikeApi
    +WORKOUT_API -> HttpWorkoutApi
    +MACHINE_API -> HttpMachineApi
    +YOUTUBE_PLAYER -> IframeYouTubePlayer
    +UNAUTHORIZED_HANDLER -> redirectToUnlock
  }
  class routes <<Routes>> {
    + "" : RidePage
    + "setup" : SetupPage
    + "machine" : MachinePage
    + "unlock" : UnlockPage
    + "**" : NotFoundPage
  }
  class RidePage <<page>>
}
package "frontend/projects/api" {
  interface BikeApi
  class HttpBikeApi
  class apiKeyInterceptor <<HttpInterceptorFn>>
  class UNAUTHORIZED_HANDLER <<InjectionToken>>
}
package "frontend/projects/components" {
  class AppBar <<presentation>>
  class Readout <<presentation>>
}

BackgroundService <|-- BikeConnectionService
BackgroundService <|-- WorkoutEngineHost
BackgroundService <|-- RawPacketLogWriter
BackgroundService <|-- StatusSnapshotWriter
BackgroundService <|-- StateChangeLogger
WattzupOptions *-- BikeOptions
Program ..> WattzupOptions : binds json, env, args
Program ..> BackgroundService : registers
Program ..> BikeStateStore : registers
Program ..> StateBroadcaster : registers
Program ..> ActiveConnectionRegistry : registers
Program ..> EndpointGroups : maps
AppDelegate ..> Program : starts and stops the host
appConfig --> routes
BikeApi <|.. HttpBikeApi
appConfig ..> HttpBikeApi : binds
appConfig ..> UNAUTHORIZED_HANDLER : binds
apiKeyInterceptor ..> UNAUTHORIZED_HANDLER : calls on 401
routes --> RidePage
RidePage ..> AppBar : inputs and outputs
RidePage ..> Readout : inputs
RidePage ..> BikeApi : via BIKE_API
@enduml
