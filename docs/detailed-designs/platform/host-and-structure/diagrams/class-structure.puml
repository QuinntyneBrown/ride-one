@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Composition root

class "app.config.ts" as root <<composition root>> {
  +appConfig: ApplicationConfig
}
class "app.routes.ts" as routes {
  +'' RidePage
  +'setup' SetupPage
  +'classes' ClassLibraryPage
  +'classes/:id' ClassPage
  +'sessions/:id' SessionPage (lazy)
  +'progress' ProgressPage (lazy)
  +'**' NotFoundPage
}
class "provideBrowserContracts()" as provide <<@wattzup/browser>> {
  +BIKE_API, WORKOUT_API, CLASS_API, SESSION_API
  +LIVE_STATE_SOURCE, BIKE_PAIRING, SESSION_ARCHIVE, PACKET_LOG
  +shared services, environment initializers
}
class IframeYouTubePlayer <<app core>>
class "provideServiceWorker('ngsw-worker.js')" as sw
class ThemeService <<app core>>
class LiveStateService <<app core>> {
  +state: Signal<BikeState | null>
}

root ..> routes : provideRouter
root ..> provide : calls
root ..> IframeYouTubePlayer : YOUTUBE_PLAYER
root ..> sw : registers
root ..> ThemeService : app initializer
LiveStateService ..> provide : reads LIVE_STATE_SOURCE
@enduml
