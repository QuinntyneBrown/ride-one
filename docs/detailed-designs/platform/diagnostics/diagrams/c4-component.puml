@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Diagnose in the browser

Container_Boundary(app, "Wattzup Web, browser edition") {
  Component(dialog, "Diagnostics dialog", "Angular dialog", "Browser rows, Log every packet, Download packet log")
  Component(api, "BrowserBikeApi", "BIKE_API implementation", "diagnosticsPackets(): newest 60 lines")
  Component(link, "BikeLink", "lib/bluetooth", "Logs each write, and each packet on request")
  Component(ring, "PacketLog", "lib/bluetooth, PACKET_LOG", "Newest 2,000 raw_packets.log lines")
  Component(log, "BROWSER_LOG", "lib/engine", "Console: info, warn, debug per packet on request")
  Component(archive, "BrowserSessionArchive", "SESSION_ARCHIVE", "stored(): rides and storage use")
}
Rel(dialog, ring, "view, setEveryPacket, file()")
Rel(dialog, archive, "stored()")
Rel(api, ring, "lines()")
Rel(link, ring, "sent(), received()")
Rel(link, log, "Connections, drops, errors, packets")
@enduml
