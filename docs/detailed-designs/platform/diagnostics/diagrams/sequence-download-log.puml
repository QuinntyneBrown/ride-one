@startuml
title UML sequence behaviour — Download the packet log
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider or helper" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "Diagnostics dialog" as dlg
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BikeLink" as link
  participant "PacketLog" as ring
  participant "BROWSER_LOG" as log
end box
loop each write to the bike
  link -> ring : sent(epochMs, bytes) [newest 2,000, L2-095 AC1]
end
loop each packet from the bike
  opt Log every packet is on [L2-095 AC1, AC4]
    link -> ring : received(epochMs, bytes)
    link -> log : console.debug
  end
end
rider -> dlg : Open Diagnostics
dlg -> ring : view()
dlg --> rider : Browser, bike and storage rows [L2-023 AC1];\n212 commands · 20 KB
rider -> dlg : Log every packet on
dlg -> ring : setEveryPacket(true)
rider -> dlg : Download packet log
dlg -> ring : file()
dlg -> dlg : saveFile(wattzup-packets-<yyyy-mm-ddThh-mm>.log) [L2-095 AC2]
dlg --> rider : Saved to Downloads
@enduml
