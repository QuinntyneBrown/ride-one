@startuml
title UML sequence behaviour — Hidden tab pauses animation
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "FrameScheduler" as frames
  participant "RideTrace" as trace
  participant "PowerTraceStore" as pts
  participant "LiveStateService" as live
end box
box "Backend — Wattzup API application" #D1FADF
  participant "EventsEndpoints" as ep
end box

rider -> frames : switch to another tab (visibilitychange, hidden)
frames -> frames : cancelAnimationFrame; request no frames [L2-038]
ep -> live : data: state (each second)
live -> pts : append(elapsed_seconds, power)
trace -> frames : request(draw)
frames -> frames : queued, not scheduled while hidden
rider -> frames : return to tab (visible)
frames -> frames : requestAnimationFrame
frames -> trace : draw() once for this frame [L2-028]
trace -> pts : read all samples since 0:00
trace --> rider : whole ride drawn up to the playhead
@enduml
