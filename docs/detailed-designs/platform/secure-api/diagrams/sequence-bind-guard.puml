@startuml
title UML sequence behaviour — Start-up binding check
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Operator" as op
box "Backend — Wattzup API application" #D1FADF
  participant "Program" as program
  participant "BindAddressGuard" as guard
  participant "Kestrel" as kestrel
end box


op -> program : start with Wattzup:Urls
program -> guard : StartingAsync
alt all URLs loopback (default http://127.0.0.1:8787)
  guard --> program : ok (no key required) [L2-034]
  program -> kestrel : bind and listen
else any non-loopback URL
  alt ApiKey configured
    guard --> program : ok; API key auth enforced [L2-035]
    program -> kestrel : bind and listen
  else no ApiKey
    guard -> guard : log Critical "Non-loopback binding requires Wattzup:Security:ApiKey"
    guard --> program : StopApplication, exit code 1 [L2-034]
  end
end
@enduml
