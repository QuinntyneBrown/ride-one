@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Secure the API

Container_Boundary(web, "Wattzup Web") {
  Component(interceptor, "apiKeyInterceptor", "Angular HttpInterceptorFn", "Adds X-Api-Key from ApiKeyStore; 401 to /unlock")
  Component(live, "LiveStateService", "Angular service", "Requests event token, opens EventSource")
}
Container_Boundary(api, "Wattzup API") {
  Component(guard, "BindAddressGuard", "Startup check", "Non-loopback requires API key")
  Component(headers, "SecurityHeadersMiddleware", "Middleware", "nosniff, Referrer-Policy, CSP with style nonce")
  Component(cors, "CORS policy", "ASP.NET Core", "Configured origins only")
  Component(auth, "ApiKeyAuthenticationHandler", "AuthenticationHandler", "Constant-time key check")
  Component(rate, "Rate limiter 'control'", "ASP.NET Core", "20 req/s per client on /api/resistance and /api/workout*")
  Component(tokens, "EventTokenService", "Wattzup.Api", "60 s single-use SSE tokens")
  Component(endpoints, "Endpoints", "Minimal API", "/api/* incl. workout pause, resume, back-to-plan, trace; diagnostics/packets")
}

Rel(interceptor, headers, "HTTP with X-Api-Key", "JSON/HTTP")
Rel(live, tokens, "POST /api/events/token, GET /api/events?token=")
Rel(headers, cors, "Next")
Rel(cors, auth, "Next")
Rel(auth, rate, "Next")
Rel(rate, endpoints, "Next")
Rel(endpoints, tokens, "TryConsume(token)")
@enduml
