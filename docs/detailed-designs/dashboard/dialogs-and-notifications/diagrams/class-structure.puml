@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Dialogs and notifications

class DialogLauncher <<service>> {
  -Dialog dialog
  +openDiagnostics(): DialogRef
  +openEndRide(): DialogRef
}
class Dialog <<component wz-dialog>> {
  +input tone: 'info' | 'danger'
  +input size: 'default' | 'sm'
  +slots: description, body, footer
}
class Alert <<component wz-alert>> {
  +input tone: 'danger' | 'warning' | 'success' | 'info'
  +input banner: boolean
}
class DiagnosticsDialog <<component wz-diagnostics-dialog>> {
  +rows: Signal<DiagnosticsRow[]>
  +setEveryPacket(on: boolean): void
  +download(): void
}
class DiagnosticsRow <<value>> {
  +string label
  +string value
}
class EndRideDialog <<component wz-end-ride-dialog>> {
  +Signal<'default' | 'busy' | 'failed'> phase
  +endRide(): Promise<void>
  +keepRiding(): void
}
interface WorkoutApi <<contract, WORKOUT_API>> {
  +stop(): Promise<string | null>
}
interface PacketLogContract <<contract, PACKET_LOG>> {
  +view: Signal<PacketLogView>
  +setEveryPacket(on: boolean): void
  +file(): Blob
}
class Toast <<value>> {
  +ToastId id
  +'info' | 'success' | 'warning' | 'danger' tone
  +string title
  +string text
  +ToastAction | null action
  +number | null expiresAt
  +number | null remainingMs
}
class toastQueue <<pure reducer>> {
  +add(queue, toast, now): Queue
  +dismiss(queue, id): Queue
  +pause(queue, id, now): Queue
  +resume(queue, id, now): Queue
  +expire(queue, now): Queue
  -MAX_VISIBLE = 3
  -AUTO_DISMISS_MS = 5000
}
class ToastService <<service>> {
  +Signal<Toast[]> visible
  +show(toast): ToastId
  +dismiss(id): void
  +pause(id): void
  +resume(id): void
}
class ToastRegion <<component wz-toast-region>>
class ToastView <<component wz-toast>> {
  +input toast
}

DialogLauncher ..> DiagnosticsDialog : opens
DialogLauncher ..> EndRideDialog : opens
DiagnosticsDialog *-- Dialog
EndRideDialog *-- Dialog
EndRideDialog *-- Alert : failed state
DiagnosticsDialog ..> PacketLogContract
EndRideDialog ..> WorkoutApi
DiagnosticsDialog "1" *-- "*" DiagnosticsRow
ToastService ..> toastQueue
ToastService "1" o-- "0..3 visible" Toast
ToastRegion --> ToastService
ToastRegion *-- "*" ToastView
@enduml
