@startuml
title UML sequence behaviour — Toast lifecycle
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "Caller feature\n(resistance, cues)" as caller
  participant "ToastService" as svc
  participant "toastQueue" as queue
  participant "ToastRegion" as region
  participant "Toast" as toast
end box

caller -> svc : show(info "Beeps on")
svc -> queue : add(queue, toast, now)
queue --> svc : visible [info], expiresAt now + 5 s
svc -> region : visible signal
region -> toast : render at the bottom, close button "Dismiss" [L2-053]
rider -> toast : hover or focus
toast -> svc : pause(id)
svc -> queue : pause: remainingMs kept, timer cleared [L2-053]
rider -> toast : leave
toast -> svc : resume(id)
svc -> queue : resume: expiresAt = now + remainingMs
caller -> svc : show(danger "Couldn't set resistance", action Retry)
svc -> queue : add: danger, no expiry [L2-053]
region -> toast : role="alert"
caller -> svc : show(success "Resistance set to 20")
caller -> svc : show(warning "Bike is slow to confirm")
svc -> queue : add: 4 toasts would show
queue -> queue : evict oldest info toast first; at most 3 visible [L2-053]
queue --> svc : visible [danger, success, warning]
svc -> svc : timer fires 5 s after success showed
svc -> queue : expire(now): success leaves
rider -> toast : press Dismiss on the danger toast
toast -> svc : dismiss(id)
@enduml
