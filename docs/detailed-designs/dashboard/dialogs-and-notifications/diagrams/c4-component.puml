@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Dialogs and notifications

Person(rider, "Rider", "Opens Diagnostics, ends rides, reads toasts")
Container_Boundary(web, "Wattzup Web") {
  Component(bar, "AppBar", "Angular component", "Diagnostics and End buttons")
  Component(launcher, "DialogLauncher", "Angular service", "Wraps CDK Dialog; restoreFocus")
  Component(cdk, "CDK Dialog", "Angular CDK", "Backdrop, focus trap, Escape")
  Component(diag, "DiagnosticsDialog", "Angular component", "Blocks diag, diag-log")
  Component(end, "EndRideDialog", "Angular component", "Default, busy, failed")
  Component(shell, "Dialog + Alert", "Angular components", "Blocks dialog, alert")
  Component(report, "diagnosticsReport", "Pure helper", "Plain-text copy")
  Component(toasts, "ToastService + toastQueue", "Angular service, pure reducer", "At most 3; 5 s info and success expiry")
  Component(region, "ToastRegion + Toast", "Angular components", "Blocks toast-region, toast")
  Component(live, "LiveStateService", "Angular service", "Live state")
  Component(api, "BIKE_API", "Injection token (HttpBikeApi)", "diagnosticsPackets, stopWorkout")
  Component(others, "Other features", "resistance-control, workouts", "Call ToastService.show")
}
Container(server, "Wattzup API", "ASP.NET Core", "GET /api/diagnostics/packets, POST /api/workout/stop")

Rel(rider, bar, "Presses")
Rel(bar, launcher, "openDiagnostics / openEndRide")
Rel(launcher, cdk, "open(component, config)")
Rel(cdk, diag, "Hosts")
Rel(cdk, end, "Hosts")
Rel(diag, shell, "Composes")
Rel(end, shell, "Composes")
Rel(diag, live, "Reads")
Rel(diag, report, "Copy details")
Rel(diag, api, "Fetches packet lines")
Rel(end, api, "Stops the workout")
Rel(api, server, "Calls", "JSON/HTTP")
Rel(others, toasts, "show(toast)")
Rel(region, toasts, "Reads visible")
@enduml
