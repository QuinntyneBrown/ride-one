@startuml
title UML sequence behaviour — Diagnostics dialog
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "AppBar" as bar
  participant "DialogLauncher / CDK Dialog" as cdk
  participant "DiagnosticsDialog" as diag
  participant "LiveStateService" as live
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "PacketLog (PACKET_LOG)" as log
end box

rider -> bar : press Diagnostics
bar -> cdk : openDiagnostics() (restoreFocus, ariaModal)
cdk -> diag : create inside focus trap [L2-041]
diag -> live : read state
live --> diag : ble, device, adapter, commands, ...
diag -> log : view()
log --> diag : entries 212, 20 KB, everyPacket off
diag -> diag : rows: Browser, Web Bluetooth, Page, Bike, Connection,\nLast command, Rides stored [L2-023]
opt rider turns on Log every packet
  rider -> diag : Log every packet
  diag -> log : setEveryPacket(true) [L2-095 AC1]
end
opt rider presses Download packet log
  rider -> diag : Download packet log
  diag -> log : file()
  log --> diag : Blob of "<epoch> <hex bytes>" lines
  diag -> diag : save wattzup-packets-<date>.log [L2-095 AC2]
end
rider -> diag : press Done or Escape
diag -> cdk : close()
cdk -> bar : restore focus to Diagnostics [L2-023]
@enduml
