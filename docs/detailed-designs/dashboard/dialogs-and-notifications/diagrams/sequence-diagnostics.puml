@startuml
title UML sequence behaviour — Diagnostics dialog
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "AppBar" as bar
  participant "DialogLauncher / CDK Dialog" as cdk
  participant "DiagnosticsDialog" as diag
  participant "LiveStateService" as live
  participant "HttpBikeApi (BIKE_API)" as api
end box
box "Backend — Wattzup API application" #D1FADF
  participant "DiagnosticsEndpoints" as ep
end box
box "Backend — Wattzup Core and Protocol" #ECFDF3
  participant "RecentPacketBuffer" as ring
end box

rider -> bar : press Diagnostics
bar -> cdk : openDiagnostics() (restoreFocus, ariaModal)
cdk -> diag : create inside focus trap [L2-041]
diag -> live : read state
live --> diag : ui_clients 2, ble connected, device, device_label, transport, packets 2517, ...
diag -> diag : rows: Server, Bluetooth, Transport, Packets "2,517",\nLive on screen "41 min 30 s", Last update, Trace renderer, Last error [L2-023]
diag -> api : diagnosticsPackets()
api -> ep : GET /api/diagnostics/packets
ep -> ring : newest 60 lines, oldest first (L2-057)
ring --> ep : lines
ep --> api : 200 {"lines":[...]}
api --> diag : lines
diag --> rider : "Latest packets (raw_packets.log)" in scrollable pre.diag-log
rider -> diag : press Copy details
diag -> diag : diagnosticsReport(rows, lines)
diag -> diag : navigator.clipboard.writeText(text) [L2-023]
rider -> diag : press Done or Escape
diag -> cdk : close()
cdk -> bar : restore focus to Diagnostics [L2-023]
@enduml
