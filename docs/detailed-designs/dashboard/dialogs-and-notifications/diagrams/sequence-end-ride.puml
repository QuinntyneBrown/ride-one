@startuml
title UML sequence behaviour — End a ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "AppBar" as bar
  participant "DialogLauncher / CDK Dialog" as cdk
  participant "EndRideDialog" as dlg
  participant "HttpBikeApi (BIKE_API)" as api
  participant "Router" as router
end box
box "Backend — Wattzup API application" #D1FADF
  participant "WorkoutEndpoints" as ep
end box
box "Backend — Wattzup Core and Protocol" #ECFDF3
  participant "WorkoutEngine" as engine
end box

rider -> bar : press End (workout active)
bar -> cdk : openEndRide() (autoFocus Keep riding)
cdk -> dlg : "End this ride?" / "You're 7:07 into 12:40. Wattzup stops changing\nthe resistance and leaves the bike at level 18." [L2-051]
alt Keep riding, Escape or close button
  rider -> dlg : Keep riding
  dlg -> cdk : close()
  cdk -> bar : focus returns to End; ride continues [L2-051]
else End ride
  rider -> dlg : End ride
  dlg -> dlg : phase busy: "Ending…", aria-busy, buttons disabled, disableClose
  dlg -> api : stopWorkout()
  api -> ep : POST /api/workout/stop
  alt success
    ep -> engine : stop (status stopped, bike left at its level)
    ep --> api : 200 {"stopped":true}
    api --> dlg : ok
    dlg -> cdk : close()
    dlg -> router : navigate('/setup') [L2-051]
  else request fails or times out
    ep --[#red]x api : no answer
    api --> dlg : error
    dlg -> dlg : phase failed: Alert "Couldn't end the ride" / "The Wattzup server didn't\nanswer. The ride is still running — try again." with Try again [L2-051]
    dlg -> dlg : focus Keep riding
  end
end
@enduml
