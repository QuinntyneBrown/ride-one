@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Responsive and accessible layout

Person(rider, "Rider", "Phone, tablet, desktop; touch, keyboard or screen reader")
Container_Boundary(web, "Wattzup Web") {
  Component(page, "RidePage", "Angular component", "Skip link; blocks app, ride-layout, ride-main, ride-aside, readouts")
  Component(bar, "AppBar", "Angular component", "Block app-bar; wraps below 40 rem")
  Component(main, "Main area components", "Angular components", "Readout, interval card, RideTrace, MetricList")
  Component(aside, "Resistance panel", "resistance-control components", "Stepper, level picker, plan note, Sent to bike")
  Component(motion, "MotionPreference", "Angular service", "prefers-reduced-motion signal")
  Component(announcer, "LiveAnnouncer", "Angular CDK", "Polite segment announcements")
  Component(dialog, "CDK Dialog", "Angular CDK", "Focus trap, Escape, focus return")
  Component(resize, "ResizeObserver", "Browser API", "Trace canvas re-sizing")
}

Rel(rider, page, "Uses with touch, mouse or keyboard")
Rel(page, bar, "Lays out")
Rel(page, main, "Lays out")
Rel(page, aside, "Lays out beside main from 64 rem")
Rel(main, motion, "Reads reduced")
Rel(main, announcer, "announce(phase), polite")
Rel(main, resize, "Observes trace plot")
Rel(bar, dialog, "Opens Diagnostics and End ride")
@enduml
