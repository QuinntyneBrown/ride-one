@startuml
title UML sequence behaviour — Rotation and segment announcement
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "Browser layout (CSS)" as css
  participant "RideTrace" as trace
  participant "IntervalCard (workouts)" as card
  participant "LiveAnnouncer" as announcer
  participant "LiveStateService" as live
end box
box "Backend — Wattzup API application" #D1FADF
  participant "EventsEndpoints" as ep
end box

rider -> css : rotate phone from 24 rem to 52 rem wide
css -> css : min-width 40 rem: readouts two across, divider shown [L2-040]
css -> css : min-width 48 rem: metrics in one row of 5 [L2-040]
css -> trace : ResizeObserver callback
trace -> trace : resize(w, h, min(devicePixelRatio, 2)); request a draw [L2-040]
ep -> live : data: segment 9 (work), remaining 40
live -> card : segment index changed
card -> announcer : announce("Work, resistance 18, 40 seconds", "polite") [L2-041]
announcer --> rider : read aloud without moving focus
loop each second
  ep -> live : data: remaining - 1
  live -> card : countdown text changes (role="timer", aria-live="off")
end
note over card : The per-second countdown is not announced [L2-041]
@enduml
