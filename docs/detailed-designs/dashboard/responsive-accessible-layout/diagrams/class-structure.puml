@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Responsive and accessible layout

class RidePage <<component wz-ride-page>> {
  blocks: app, ride-layout, ride-main, ride-aside, readouts
}
class AppBar <<component wz-app-bar>> {
  block: app-bar
}
class StatusLine <<component wz-status-line>>
class ConnectionBanner <<component wz-connection-banner>>
class RideOverlay <<component wz-ride-overlay>>
class Readout <<component wz-readout>>
class IntervalCard <<component, workouts>>
class RideTrace <<component wz-ride-trace>>
class MetricsStrip <<component wz-metrics-strip>>
class ResistancePanel <<component, resistance-control>>
class CommandLog <<component, resistance-control>>
class MotionPreference <<service>> {
  +Signal<boolean> reduced
}
class LiveAnnouncer <<CDK service>> {
  +announce(msg: string, politeness): Promise<void>
}
class Dialog <<CDK service>> {
  +open(component, config): DialogRef
}

RidePage *-- AppBar
RidePage *-- ConnectionBanner
RidePage *-- "2" Readout
RidePage *-- IntervalCard
RidePage *-- RideTrace
RidePage *-- MetricsStrip
RidePage *-- RideOverlay
RidePage *-- ResistancePanel
RidePage *-- CommandLog
AppBar *-- StatusLine
AppBar ..> Dialog : opens dialogs
StatusLine ..> MotionPreference
IntervalCard ..> MotionPreference
IntervalCard ..> LiveAnnouncer
@enduml
