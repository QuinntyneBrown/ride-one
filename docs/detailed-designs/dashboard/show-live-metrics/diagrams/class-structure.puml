@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show live metrics

interface TraceRenderer {
  +'WebGL' | 'Canvas 2D' kind
  +resize(cssWidth, cssHeight, pixelRatio): void
  +draw(scene: TraceScene, samples: TraceSamples): void
  +dispose(): void
}
class WebGlTraceRenderer {
  -WebGL2RenderingContext gl
  -WebGLProgram program
  -WebGLBuffer vertices
}
class Canvas2dTraceRenderer {
  -CanvasRenderingContext2D ctx
}
class createTraceRenderer <<factory>> {
  +createTraceRenderer(canvas): TraceRenderer
}
class TraceRendererStatus <<service>> {
  +Signal<'WebGL' | 'Canvas 2D' | null> kind
}
class TraceScene <<value>> {
  +TraceBlock[] blocks
  +number yMax
  +Tick[] ticks
  +number planAverage
  +string[] legend
  +number elapsed
  +number total
}
class TraceBlock <<value>> {
  +number start
  +number end
  +number target
  +'work' | 'rest' | 'easy' phase
  +boolean past
}
class traceGeometry <<pure helper>> {
  +traceGeometry(workout, elapsed): TraceScene
}
class PowerTraceStore <<service>> {
  -Int32Array seconds
  -Int32Array watts
  +Signal<number> count
  +restore(): Promise<void>
  +append(rideSeconds, watts): void
  +reset(totalSeconds): void
}
class FrameScheduler <<service>> {
  +request(cb): void
}
class powerDelta <<pure helper>> {
  +powerDelta(power, target, status): {text, tone} | null
}
class metricFormat <<pure helper>> {
  +live(value): string
  +total(value, decimals): string
  +grouped(value): string
}
class estimateWatts <<pure helper>> {
  +estimateWatts(cadence, level): number
}
class Readout <<component wz-readout>> {
  +input kind: 'power' | 'cadence'
  +input label
  +input value
  +input unit
}
class Delta <<component wz-delta>> {
  +input text
  +input tone: 'on' | 'high' | 'low'
}
class MetricList <<component wz-metric-list>>
class RideTrace <<component wz-ride-trace>> {
  -TraceRenderer renderer
  -ResizeObserver observer
  +Signal<TraceScene | null> scene
  +Signal<string> summary
}

TraceRenderer <|.. WebGlTraceRenderer
TraceRenderer <|.. Canvas2dTraceRenderer
createTraceRenderer ..> TraceRenderer : returns
createTraceRenderer ..> TraceRendererStatus : sets kind
RideTrace --> TraceRenderer
RideTrace ..> traceGeometry
RideTrace --> PowerTraceStore
RideTrace ..> FrameScheduler
TraceScene "1" *-- "*" TraceBlock
traceGeometry ..> TraceScene : returns
traceGeometry ..> estimateWatts
Readout *-- Delta
Readout ..> powerDelta
Readout ..> metricFormat
MetricList ..> metricFormat
powerDelta ..> estimateWatts
@enduml
