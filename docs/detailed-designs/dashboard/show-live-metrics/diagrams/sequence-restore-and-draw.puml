@startuml
title UML sequence behaviour — Renderer choice, trace restore and draw
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "RideTrace" as trace
  participant "createTraceRenderer" as factory
  participant "TraceRenderer" as renderer
  participant "PowerTraceStore" as pts
  participant "LiveStateService" as live
  participant "FrameScheduler" as frames
end box
box "Backend — Wattzup API application" #D1FADF
  participant "WorkoutEndpoints" as wep
  participant "EventsEndpoints" as ep
end box

rider -> trace : reload the dashboard at 7:07
trace -> factory : createTraceRenderer(canvas)
alt webgl2 context and both shaders compile
  factory --> trace : WebGlTraceRenderer (Diagnostics: WebGL) [L2-028]
else context null or shader compile fails
  factory -> factory : replace canvas
  factory --> trace : Canvas2dTraceRenderer (Diagnostics: Canvas 2D) [L2-028]
end
trace -> renderer : resize(w, h, min(devicePixelRatio, 2)) [L2-028]
ep -> live : first data: workout running, elapsed_seconds 427
live -> pts : workout appeared
pts -> wep : GET /api/workout/trace [L2-026, L2-050]
wep --> pts : {"samples":[[0,143],[1,140], ... [426,317]]}
pts -> pts : restore 427 samples into Int32Arrays
loop each state message
  ep -> live : data: elapsed_seconds 428, power 321
  live -> pts : append(428, 321)
  trace -> trace : traceGeometry(workout, 428): blocks, yMax 500 W, ticks every 2 min
  trace -> frames : request(draw)
  frames -> trace : next animation frame, once [L2-028]
  trace -> renderer : draw(scene, samples)
  renderer --> rider : plan blocks, past ones dimmed, actual line and area, playhead [L2-026]
end
@enduml
