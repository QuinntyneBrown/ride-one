@startuml
title UML sequence behaviour — Sample history and draw sparklines
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "LiveStateService" as live
  participant "SpeedCard" as card
  participant "MetricHistory" as hist
  participant "Sparkline" as spark
end box
box "Backend — Wattzup API application" #D1FADF
  participant "EventsEndpoints" as ep
end box

ep -> live : data: {speed_mph:18.6, speed_kmh:30.0, cadence:80, resistance:12}
live -> card : "18.6 mph", "30.0 km/h · 80 rpm" [L2-021]
loop every 1 s
  hist -> live : state()
  hist -> hist : push(resistance), push(speed_mph); skip nulls [L2-022]
  opt buffer length > 150
    hist -> hist : drop oldest [L2-022]
  end
  hist -> hist : version += 1
  hist -> spark : version changed
  alt fewer than 2 samples
    spark -> spark : clear only
  else
    spark -> spark : canvas = clientWidth x dpr; yMax = max(floorMax, ...data) [L2-022]
    spark -> spark : stroke line, fill gradient
  end
end
spark --> rider : trend of last 150 s
@enduml
