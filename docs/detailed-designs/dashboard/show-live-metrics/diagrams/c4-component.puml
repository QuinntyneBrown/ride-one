@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show live metrics

Person(rider, "Rider", "Watches power, cadence and totals")
Container_Boundary(web, "Wattzup Web") {
  Component(live, "LiveStateService", "Angular service", "Read-only state signal")
  Component(readout, "Readout + Delta", "Angular components", "Blocks readout and delta")
  Component(strip, "MetricList", "Angular component", "Block metrics")
  Component(trace, "RideTrace", "Angular component", "Block trace; canvas aria-hidden plus text summary")
  Component(helpers, "powerDelta / metricFormat / estimateWatts", "Pure helpers", "Delta verdict, --, 0.00, 1,284")
  Component(geom, "traceGeometry", "Pure helper", "Blocks, y max, ticks, plan average, legend")
  Component(pts, "PowerTraceStore", "Angular service", "Actual power history")
  Component(factory, "createTraceRenderer", "Factory (TRACE_RENDERER_FACTORY)", "WebGL2, else Canvas 2D")
  Component(renderer, "TraceRenderer", "Interface", "WebGlTraceRenderer / Canvas2dTraceRenderer")
  Component(frames, "FrameScheduler", "Angular service", "One draw per frame; stops when hidden")
  Component(status, "TraceRendererStatus", "Angular service", "Active renderer for Diagnostics")
}
Container(api, "@wattzup/browser", "In-page contracts", "BrowserStateSource forwards each new BikeState")

Rel(api, live, "New BikeState", "LIVE_STATE_SOURCE")
Rel(pts, api, "WORKOUT_API.trace()")
Rel(readout, helpers, "Formats with")
Rel(strip, helpers, "Formats with")
Rel(readout, live, "Reads")
Rel(strip, live, "Reads")
Rel(trace, live, "Reads")
Rel(pts, live, "Appends from")
Rel(trace, geom, "Builds scene")
Rel(trace, pts, "Reads samples")
Rel(trace, factory, "Creates renderer")
Rel(factory, renderer, "Returns")
Rel(factory, status, "Sets kind")
Rel(trace, frames, "request(draw)")
Rel(rider, trace, "Reads")
@enduml
