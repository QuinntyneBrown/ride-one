@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show connection status

class LiveStateService <<service>> {
  +state: Signal<BikeState | null>
  +lastStateAt: Signal<Date | null>
}
class ConnectionStatus <<value>> {
  +string name
  +string label
  +'bluetooth' | 'bluetooth-off' icon
  +'ok' | 'wait' | 'bad' | 'quiet' tone
  +boolean scanning
}
class connectionStatus <<pure helper>> {
  +connectionStatus(state, support, pairingRequired): ConnectionStatus
}
class RideViewState <<value>> {
  +'loading' | 'ride' view
  +'browser-unsupported' | 'browser-insecure' | 'adapter-off' | 'connect-bike' | 'bike-shut-off' | 'ride-complete' | 'bike-lost' | null overlay
  +boolean dimmed
  +boolean commandsEnabled
  +boolean pauseEnabled
  +boolean endEnabled
  +string | null controlsNote
}
class rideViewState <<pure helper>> {
  +rideViewState(state, pairingRequired, support): RideViewState
}
class Banner <<value>> {
  +'adapter-off' | 'reconnected' | 'simulated' id
  +'danger' | 'success' | 'info' tone
  +string title
  +string text
  +string | null action
  +boolean dismissible
}
class ConnectionBannerService <<service>> {
  +Signal<Banner[]> banners
  +dismiss(id): void
  -RECONNECTED_MS = 4000
  -STORAGE_KEY = "wattzup.banners.dismissed"
}
class StatusLine <<component wz-status-line>> {
  +Signal<ConnectionStatus> status
}
class ConnectionBanner <<component wz-connection-banner>>
class RideOverlay <<component wz-ride-overlay>> {
  +input overlay
}
class RidePage <<component wz-ride-page>> {
  +Signal<RideViewState> view
}
class MotionPreference <<service>> {
  +Signal<boolean> reduced
}

StatusLine ..> connectionStatus
StatusLine ..> LiveStateService
StatusLine ..> MotionPreference
RidePage ..> rideViewState
RidePage ..> LiveStateService
RidePage *-- RideOverlay
RidePage *-- ConnectionBanner
ConnectionBanner --> ConnectionBannerService
ConnectionBannerService --> LiveStateService
ConnectionBannerService "1" o-- "*" Banner
connectionStatus ..> ConnectionStatus : returns
rideViewState ..> RideViewState : returns
@enduml
