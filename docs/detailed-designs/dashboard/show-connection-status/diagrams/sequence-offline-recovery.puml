@startuml
title UML sequence behaviour — Server offline and recovery
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web application" #E0F2FE
  participant "StatusLine" as line
  participant "ConnectionBanner" as banner
  participant "RidePage" as page
  participant "LiveStateService" as live
end box
box "Backend — Wattzup API application" #D1FADF
  participant "EventsEndpoints" as ep
end box

ep -> live : data: {ble:"connected", device_label:"Echelon EX-5s", ...}
live -> line : "Echelon EX-5s" "Connected" [L2-018]
ep -[#red]x live : stream drops (server stopped)
live -> live : onerror: close; connection = offline
live -> line : "Server offline" "Retrying…", wifi-off, statusline~--bad [L2-018]
live -> banner : warning "Lost connection to the Wattzup server",\n"Numbers below are from 7:07 PM and controls are paused." [L2-054]
live -> page : commandsEnabled = false (resistance, Pause, End) [L2-054]
loop every 2 s until a message arrives
  live -> ep : new EventSource('/api/events')
  ep --[#red]x live : connection refused
end
rider -> banner : Retry now
banner -> live : retryNow()
live -> ep : new EventSource('/api/events')
ep --> live : first data: current state
live -> live : connection = open
live -> line : real ble state restored
live -> banner : warning banner removed
live -> page : commands enabled again
page --> rider : live numbers and controls
@enduml
