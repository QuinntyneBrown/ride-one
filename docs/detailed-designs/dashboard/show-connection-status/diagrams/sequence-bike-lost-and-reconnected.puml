@startuml
title UML sequence behaviour — Bike lost and reconnected during a ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "RidePage" as page
  participant "RideOverlay" as overlay
  participant "ConnectionBanner" as banner
  participant "ConnectionBannerService" as banners
  participant "LiveStateService" as live
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "WorkoutEngine" as engine
  participant "BrowserStateSource" as ep
end box

engine -> ep : status = "paused: bike disconnected", ble = disconnected
ep -> live : state
live -> page : rideViewState: overlay bike-lost, dimmed [L2-058]
page -> overlay : "Lost the bike" / "Echelon EX-5s stopped answering ... saved at 7:07."
page -> page : readouts~--dimmed, metrics~--dimmed; End stays enabled
rider -> rider : pedals to wake the bike
engine -> ep : ble = connected, status = "running" (within 90 s)
ep -> live : state
live -> page : rideViewState: overlay null, dimmed false
live -> banners : status paused: bike disconnected -> running
banners -> banner : success "Reconnected" / "Echelon EX-5s is back. The plan picked up\nat 7:12 and resistance is set to 18." [L2-054]
banners -> banners : setTimeout 4 s
banners -> banner : remove "Reconnected"
alt bike stays off for more than 90 s
  engine -> ep : status = "ended: bike shut off"
  ep -> live : state
  live -> page : overlay bike-shut-off
  page -> overlay : "Ride ended — the bike shut off", See your ride and Ride another class [L2-058 AC6]
end
@enduml
