@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show connection status

Person(rider, "Rider", "Glances at the app bar, banners and overlays")
Container_Boundary(web, "Wattzup Web") {
  Component(live, "LiveStateService", "Angular service", "Only reader of LIVE_STATE_SOURCE; state, lastStateAt")
  Component(status, "connectionStatus", "Pure helper", "Name, state label, icon, tone")
  Component(view, "rideViewState", "Pure helper", "Skeleton, overlay, dimming, enabled controls")
  Component(banners, "ConnectionBannerService", "Angular service", "Visible banners, 4 s reconnected timer, session dismissals")
  Component(line, "StatusLine", "Angular component", "Block statusline")
  Component(banner, "ConnectionBanner", "Angular component", "Alert with banner class")
  Component(overlay, "RideOverlay", "Angular component", "Block overlay-panel")
  Component(page, "RidePage", "Angular component", "Applies the ride view state")
  Component(pairing, "BIKE_PAIRING", "Contract", "Support verdict, bike picked?")
}
Container(api, "@wattzup/browser", "In-page contracts", "BrowserStateSource forwards each new BikeState")

Rel(api, live, "New BikeState", "LIVE_STATE_SOURCE")
Rel(line, status, "Calls")
Rel(page, view, "Calls")
Rel(page, pairing, "Reads support and required")
Rel(status, live, "Reads")
Rel(view, live, "Reads")
Rel(banners, live, "Reads")
Rel(banner, banners, "Reads")
Rel(page, overlay, "Shows")
Rel(rider, line, "Reads")
Rel(rider, banner, "Dismiss")
@enduml
