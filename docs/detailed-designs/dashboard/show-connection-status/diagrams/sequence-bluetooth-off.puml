@startuml
title UML sequence behaviour — Bluetooth switched off and back on
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "RidePage" as page
  participant "StatusLine" as line
  participant "ConnectionBannerService" as banners
  participant "LiveStateService" as live
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserBikePairing" as pairing
  participant "BikeStateStore" as store
end box
box "Browser — platform" #FFF4E5
  participant "navigator.bluetooth" as nb
end box

nb -> pairing : availabilitychanged (false)
pairing -> store : update(adapter 'off')
store -> live : state
live -> line : connectionStatus: Bluetooth · Off, tone bad [L2-018]
live -> banners : danger "Bluetooth is off" with Open diagnostics [L2-054 AC2]
live -> page : rideViewState: overlay adapter-off; commands disabled [L2-058 AC4]
page --> rider : "Turn on Bluetooth" with Check again and Open diagnostics
rider -> rider : switches Bluetooth on
alt the browser reports it
  nb -> pairing : availabilitychanged (true)
else the rider presses Check again
  rider -> page : Check again
  page -> pairing : checkAgain()
  pairing -> nb : getAvailability()
  nb --> pairing : true
end
pairing -> store : update(adapter 'on')
store -> live : state
live -> page : overlay cleared; the bike reconnects by its retry (bike-connectivity/connect-the-bike)
live -> banners : "Bluetooth is off" removed
@enduml
