@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Not-found page

Person(rider, "Rider", "Follows an old or mistyped link")
System_Ext(host, "Static host", "Serves index.html for unknown paths")
Container_Boundary(web, "Wattzup Web") {
  Component(router, "Router (app.routes.ts)", "Angular Router", "** wildcard route")
  Component(notfound, "NotFoundPage", "Angular component", "404 with the path as text")
  Component(card, "AuthCard", "Angular component", "Blocks auth-layout, auth-card")
}

Rel(rider, host, "Opens /workouts/history", "HTTPS")
Rel(host, router, "index.html (fallback)")
Rel(router, notfound, "Wildcard route")
Rel(notfound, card, "Composes")
Rel(rider, notfound, "Back to the dashboard, Set up a ride")
@enduml
