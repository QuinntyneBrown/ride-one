@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Unlock and not-found pages

Person(rider, "Rider", "On a device that reaches the shared server")
Container_Boundary(web, "Wattzup Web") {
  Component(router, "Router (app.config.ts)", "Angular Router", "/unlock, ** wildcard")
  Component(interceptor, "apiKeyInterceptor", "HttpInterceptorFn", "Adds X-Api-Key; 401 to /unlock?returnUrl=")
  Component(store, "ApiKeyStore", "Angular service", "sessionStorage wattzup.apiKey")
  Component(safe, "safeReturnUrl", "Pure helper", "Internal paths only")
  Component(api, "BIKE_API (HttpBikeApi)", "Injection token", "verifyKey(key)")
  Component(unlock, "UnlockPage", "Angular component", "Default, submitting, rejected, unreachable")
  Component(notfound, "NotFoundPage", "Angular component", "404 with the path as text")
  Component(card, "AuthCard", "Angular component", "Blocks auth-layout, auth-card")
  Component(live, "LiveStateService", "Angular service", "Restarts with the key")
}
Container(server, "Wattzup API", "ASP.NET Core", "401 without X-Api-Key when a key is configured")

Rel(rider, unlock, "Enters the API key")
Rel(unlock, api, "verifyKey")
Rel(api, server, "GET /api/status with X-Api-Key", "JSON/HTTP")
Rel(interceptor, store, "Reads key")
Rel(interceptor, router, "navigate /unlock on 401")
Rel(unlock, store, "set(key)")
Rel(unlock, safe, "Checks returnUrl")
Rel(unlock, live, "Restart")
Rel(unlock, card, "Composes")
Rel(notfound, card, "Composes")
Rel(router, notfound, "Wildcard route")
@enduml
