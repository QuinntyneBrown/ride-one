@startuml
title UML sequence behaviour — Unknown address
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Hosting — Static host" #FFF4E5
  participant "Static files + fallback" as files
end box
box "Frontend — Wattzup Web" #E0F2FE
  participant "Router" as router
  participant "NotFoundPage" as page
end box

rider -> files : GET /workouts/history
files --> rider : index.html (fallback for client routes, or from the service worker)
rider -> router : bootstrap; match /workouts/history
router -> router : no route matches; wildcard ** [L2-056]
router -> page : activate
page -> page : path = router.url, bound as text
page --> rider : "404", "This page isn't part of your ride",\n"The address /workouts/history doesn't exist in Wattzup. ..." [L2-056]
alt Back to the dashboard
  rider -> router : routerLink "/"
else Set up a ride
  rider -> router : routerLink "/setup"
end
@enduml
